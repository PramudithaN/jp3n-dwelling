---
import '../styles/tokens.css';
import NavHeader from '../components/NavHeader.astro';
import Footer from '../components/Footer.astro';
import ThemeEngine from '../components/ThemeEngine.astro';
import ThemeSwitcher from '../components/ThemeSwitcher.astro';
import MaintenanceScreen from '../components/MaintenanceScreen.astro';
import { activeTheme } from '../config/theme';
import { siteConfig } from '../config/site';

const isMaintenance =
  siteConfig.maintenance.enabled ||
  import.meta.env.PUBLIC_MAINTENANCE_MODE === 'true';

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
}

const { 
  title, 
  description = 'Teqniqks / Independent digital engineering atelier in Sri Lanka.',
  canonicalPath = '/'
} = Astro.props;

const siteUrl = 'https://teqniqks.com';
const fullCanonicalUrl = new URL(canonicalPath, siteUrl).toString();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content={activeTheme.colors.bgCanvas} />
  <meta name="description" content={description} />
  <meta name="robots" content={isMaintenance ? 'noindex, nofollow' : 'index, follow'} />
  <link rel="canonical" href={fullCanonicalUrl} />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg?v=2`} />

  <!-- Critical Font Preloading -->
  <link rel="preload" href={`${base}/fonts/SpaceGrotesk-Variable.woff`} as="font" type="font/woff" crossorigin />
  <link rel="preload" href={`${base}/fonts/Sora-Regular.woff`} as="font" type="font/woff" crossorigin />
  <link rel="preload" href={`${base}/fonts/JetBrainsMono.woff`} as="font" type="font/woff" crossorigin />

  <!-- Zero Tracking & Security Meta -->
  <meta http-equiv="X-Content-Type-Options" content="nosniff" />
  <meta name="referrer" content="strict-origin-when-cross-origin" />

  <title>{title} / Teqniqks</title>

  <!-- Global Dynamic Theme Provider -->
  <ThemeEngine />
</head>
<body>
  <!-- Theme-Matched Screen Content Loader -->
  <div class="teqniqks-screen-loader" id="teqniqksScreenLoader" aria-hidden="true">
    <div class="loader-core">
      <div class="loader-ring"></div>
      <span class="loader-brand">Teqniqks</span>
    </div>
    <span class="loader-status">LOADING CONTENT</span>
  </div>

  <!-- Minimal Theme-Matched Route & Load Progress Bar -->
  <div class="teqniqks-route-loader" id="teqniqksRouteLoader" aria-hidden="true"></div>
  {isMaintenance ? (
    <main id="main-content">
      <MaintenanceScreen />
    </main>
  ) : (
    <>
      <!-- Keyboard Accessibility Skip Link -->
      <a href="#main-content" class="skip-link">Skip to main content</a>

      <NavHeader currentPath={canonicalPath} />

      <main id="main-content">
        <slot />
      </main>

      <Footer />
      <ThemeSwitcher />

      <script is:inline>
        (function () {
          var bar = document.getElementById('teqniqksRouteLoader');
          var screen = document.getElementById('teqniqksScreenLoader');
          if (!bar && !screen) return;

          function hideLoaders() {
            if (bar) {
              bar.classList.remove('is-loading');
              bar.classList.add('is-done');
              setTimeout(function () {
                bar.classList.remove('is-done');
              }, 320);
            }
            if (screen) {
              screen.classList.add('is-hidden');
            }
          }

          function showLoaders() {
            if (bar) {
              bar.classList.remove('is-done');
              bar.classList.add('is-loading');
            }
            if (screen) {
              screen.classList.remove('is-hidden');
            }
          }

          window.addEventListener('pageshow', hideLoaders);
          if (document.readyState === 'complete') {
            hideLoaders();
          } else {
            showLoaders();
            window.addEventListener('load', hideLoaders, { once: true });
            // Safety cap so slow third-party resources never block the screen
            setTimeout(hideLoaders, 1800);
          }

          document.addEventListener('click', function (e) {
            var target = e.target instanceof Element ? e.target.closest('a[href]') : null;
            if (!target) return;
            var href = target.getAttribute('href') || '';
            if (
              !href ||
              href.startsWith('#') ||
              href.startsWith('mailto:') ||
              target.getAttribute('target') === '_blank' ||
              e.metaKey ||
              e.ctrlKey ||
              e.shiftKey ||
              e.altKey
            ) {
              return;
            }
            try {
              var dest = new URL(target.href, window.location.href);
              if (dest.origin === window.location.origin && dest.pathname !== window.location.pathname) {
                showLoaders();
              }
            } catch {}
          });
        })();
      </script>
    </>
  )}
</body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: -999px;
    left: 20px;
    z-index: 1000;
    padding: 8px 16px;
    background-color: var(--color-raw-amber-vivid);
    color: #080503;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    text-decoration: none;
  }

  .skip-link:focus {
    top: 20px;
  }

  .teqniqks-route-loader {
    position: fixed;
    top: 0;
    left: 0;
    height: 2px;
    width: 0%;
    z-index: 10050;
    pointer-events: none;
    background: linear-gradient(90deg, var(--text-accent-soft), var(--text-accent));
    box-shadow: 0 0 10px var(--color-accent-glow, rgba(82, 164, 104, 0.45));
    opacity: 0;
    transition: width 320ms cubic-bezier(0.16, 1, 0.3, 1), opacity 220ms ease;
  }

  .teqniqks-route-loader.is-loading {
    opacity: 1;
    width: 72%;
  }

  .teqniqks-route-loader.is-done {
    opacity: 0;
    width: 100%;
  }

  /* Theme-Matched Screen Content Loader */
  .teqniqks-screen-loader {
    position: fixed;
    inset: 0;
    z-index: 10040;
    background-color: var(--bg-canvas);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    opacity: 1;
    transition: opacity 280ms ease, visibility 280ms ease;
  }

  .teqniqks-screen-loader.is-hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .loader-core {
    position: relative;
    width: 104px;
    height: 104px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .loader-ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 2px solid var(--border-hairline);
    border-top-color: var(--text-accent);
    border-right-color: var(--text-accent-soft);
    animation: teqniqksLoaderSpin 0.85s linear infinite;
  }

  .loader-brand {
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--text-primary);
  }

  .loader-status {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.18em;
    color: var(--text-accent);
  }

  @keyframes teqniqksLoaderSpin {
    to { transform: rotate(360deg); }
  }
</style>
