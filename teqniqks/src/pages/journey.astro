---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';

const team = siteConfig.team;
---

<BaseLayout title="The Journey" description="How five engineers built an independent craft atelier in Sri Lanka." canonicalPath="/journey">
  <section class="journey-section">
    <div class="site-container">
      <div class="page-header">
        <h1 class="page-title">The Journey</h1>
        <p class="page-lead">
          Teqniqks grew out of engineering late nights, open source contributions, and a shared intolerance for bloated, fragile software.
        </p>
      </div>

      <div class="timeline-stack">
        <!-- Milestone 1 -->
        <div class="timeline-node">
          <div class="node-aside">
            <span class="node-year">2022 to 2023</span>
            <span class="node-tag">FOUNDATION</span>
          </div>
          <div class="node-card">
            <h2 class="node-title">The Resistance to Web Bloat</h2>
            <p>
              Frustrated by bloated multi-megabyte JavaScript bundles failing on throttled 4G, we began crafting lightweight utilities: instant theme managers, browser telemetry, and client-side binary filters.
            </p>
          </div>
        </div>

        <!-- Milestone 2 -->
        <div class="timeline-node">
          <div class="node-aside">
            <span class="node-year">2024 to 2025</span>
            <span class="node-tag">CONVERGENCE</span>
          </div>
          <div class="node-card">
            <h2 class="node-title">From Solo Hackers to Collective</h2>
            <p>
              Open source contributions brought us together. We combined systems programming, graphic design, and technical motion under one disciplined operating agreement: verifiable output, zero fake stats, zero trackers.
            </p>
          </div>
        </div>

        <!-- Milestone 3 -->
        <div class="timeline-node">
          <div class="node-aside">
            <span class="node-year">2026 to PRESENT</span>
            <span class="node-tag">ATELIER</span>
          </div>
          <div class="node-card">
            <h2 class="node-title">The Atelier</h2>
            <p>
              Teqniqks establishes a permanent craft model. We cap intake at 3 commercial projects per month to guarantee direct senior engineer involvement, keeping dedicated weekly capacity for open source tools.
            </p>
          </div>
        </div>
      </div>

      <!-- Team Roster -->
      <div class="team-roster-section">
        <div class="section-header">
          <h2 class="section-title">The Core Builders</h2>
          <p class="section-sub">Direct access to engineers. Zero intermediaries.</p>
        </div>
        <div class="roster-grid">
          {team.map(member => (
            <div class="roster-card">
              <div class="roster-top">
                <span class="roster-initials">{member.name.split(' ').map(n => n[0]).join('')}</span>
                <span class="roster-pill">CORE</span>
              </div>
              <h3 class="roster-name">{member.name}</h3>
              <span class="roster-role">{member.role}</span>
              <p class="roster-bio">{member.bio.split('.')[0]}.</p>
              <a 
                href={`https://github.com/${member.githubHandle}`} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="roster-github"
              >
                github.com/{member.githubHandle}
              </a>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .journey-section {
    padding: var(--space-3xl) 0 var(--space-4xl);
  }

  .site-container {
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  .page-header {
    margin-bottom: var(--space-3xl);
  }

  .page-title {
    font-size: var(--step-5);
    color: var(--color-raw-parchment);
    margin-bottom: var(--space-xs);
    letter-spacing: -0.035em;
  }

  .page-lead {
    font-size: var(--step-1);
    color: var(--text-secondary);
    max-width: 50ch;
    line-height: var(--lh-body);
  }

  .timeline-stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    margin-bottom: var(--space-4xl);
  }

  .timeline-node {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: var(--space-xl);
    align-items: start;
  }

  .node-aside {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-top: var(--space-xs);
  }

  .node-year {
    font-family: var(--font-display);
    font-size: var(--step-1);
    color: var(--color-raw-amber-sand);
    font-weight: 700;
  }

  .node-tag {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-raw-ochre);
    font-weight: 600;
  }

  .node-card {
    background-color: var(--surface-elevated);
    border: 2px solid var(--border-timber);
    padding: var(--space-xl);
    box-shadow: var(--shadow-flat);
  }

  .node-title {
    font-size: var(--step-2);
    color: var(--color-raw-parchment);
    margin-bottom: var(--space-xs);
  }

  .node-card p {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: var(--lh-body);
    margin: 0;
  }

  /* Team Roster */
  .team-roster-section {
    padding-top: var(--space-3xl);
    border-top: 2px solid var(--border-timber);
  }

  .section-header {
    margin-bottom: var(--space-2xl);
  }

  .section-title {
    font-size: var(--step-3);
    color: var(--color-raw-parchment);
    margin-bottom: var(--space-xs);
  }

  .section-sub {
    font-size: var(--step-0);
    color: var(--text-secondary);
  }

  .roster-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-l);
  }

  .roster-card {
    background-color: var(--surface-elevated);
    border: 2px solid var(--border-timber);
    padding: var(--space-l);
    box-shadow: var(--shadow-flat);
    display: flex;
    flex-direction: column;
  }

  .roster-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-xs);
  }

  .roster-initials {
    width: 36px;
    height: 36px;
    background-color: #1A0F08;
    border: 1px solid var(--color-raw-timber);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-raw-amber-sand);
  }

  .roster-pill {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--color-raw-ash);
  }

  .roster-name {
    font-size: var(--step-1);
    color: var(--color-raw-parchment);
    margin-bottom: 2px;
  }

  .roster-role {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-raw-ochre);
    font-weight: 600;
    margin-bottom: var(--space-xs);
    display: block;
  }

  .roster-bio {
    font-size: 0.8125rem;
    color: var(--text-secondary);
    line-height: var(--lh-body);
    margin-bottom: var(--space-m);
    flex-grow: 1;
  }

  .roster-github {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-raw-amber-vivid);
    font-weight: 600;
    text-decoration: none;
    border-top: 1px dashed var(--border-timber);
    padding-top: var(--space-xs);
  }

  .roster-github:hover {
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .timeline-node {
      grid-template-columns: 1fr;
      gap: var(--space-s);
    }
  }
</style>
