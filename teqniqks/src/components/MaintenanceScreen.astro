---
import { siteConfig } from '../config/site';

const { kicker, headline, message, code } = siteConfig.maintenance;
const messageLines = message.split('\n');
---

<section class="maintenance-stage" role="status" aria-live="polite" aria-label="Site under maintenance">
  <!-- Subtle ambient theme grid -->
  <div class="maint-bg-grid" aria-hidden="true"></div>

  <div class="maint-container">
    <!-- Top Editorial Bar (3 dots + status code) -->
    <header class="maint-topbar">
      <div class="maint-dots" aria-hidden="true">
        <span></span><span></span><span></span>
      </div>
      <span class="maint-code">{code}</span>
    </header>

    <!-- Main Editorial Copy -->
    <div class="maint-copy">
      <span class="maint-kicker">{kicker}</span>
      <h1 class="maint-headline">{headline}</h1>
      <div class="maint-rule" aria-hidden="true"></div>
      <p class="maint-message">
        {messageLines.map((line, i) => (
          <>
            {line}
            {i < messageLines.length - 1 && <br />}
          </>
        ))}
      </p>
      <p class="maint-attrib">
        <span class="attrib-dim">Atelier</span>{' '}
        <strong class="attrib-bold">{siteConfig.name}</strong>
      </p>
    </div>

    <!-- Suspended Traffic Signal with Red Heart Light -->
    <div class="signal-rig" aria-hidden="true">
      <!-- Diagonal Suspension Guy-Wires -->
      <svg class="signal-wires" viewBox="0 0 800 160" preserveAspectRatio="none" fill="none">
        <line x1="0" y1="22" x2="225" y2="118" class="wire-line" />
        <line x1="485" y1="118" x2="660" y2="62" class="wire-line" />
        <line x1="0" y1="112" x2="48" y2="122" class="wire-line" />
      </svg>

      <!-- Horizontal Mast & Signal Housings -->
      <div class="signal-mast-row">
        <div class="mast-pipe">
          <span class="mast-clamp"></span>
        </div>

        <div class="signal-cluster">
          <!-- Left Hood (Off) -->
          <div class="signal-pod">
            <div class="signal-hood">
              <div class="signal-lens is-off"></div>
            </div>
          </div>

          <!-- Center Hood (Off) -->
          <div class="signal-pod">
            <div class="signal-hood">
              <div class="signal-lens is-off"></div>
            </div>
          </div>

          <!-- Right Hood (Illuminated Red Heart) -->
          <div class="signal-pod is-lit">
            <div class="signal-hood">
              <div class="signal-lens is-red-heart">
                <svg class="heart-svg" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" />
                </svg>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .maintenance-stage {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    width: 100%;
    background:
      radial-gradient(circle at 75% 78%, rgba(239, 68, 68, 0.08) 0%, transparent 45%),
      radial-gradient(circle at 20% 20%, var(--theme-accent-muted) 0%, transparent 50%),
      var(--bg-canvas);
    color: var(--text-primary);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    padding: clamp(2rem, 5vw, 4rem) clamp(1.5rem, 5vw, 4rem) 0;
  }

  .maint-bg-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, var(--border-hairline) 1px, transparent 1px),
      linear-gradient(to bottom, var(--border-hairline) 1px, transparent 1px);
    background-size: 48px 48px;
    opacity: 0.22;
    pointer-events: none;
    mask-image: radial-gradient(ellipse at center, black 35%, transparent 85%);
    -webkit-mask-image: radial-gradient(ellipse at center, black 35%, transparent 85%);
  }

  .maint-container {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 920px;
    margin: 0 auto;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  /* Top Bar */
  .maint-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .maint-dots {
    display: flex;
    gap: 6px;
  }

  .maint-dots span {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background-color: var(--text-primary);
    opacity: 0.85;
  }

  .maint-code {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }

  /* Editorial Copy */
  .maint-copy {
    margin: auto 0;
    padding: var(--space-2xl) 0;
    max-width: 440px;
  }

  .maint-kicker {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    color: var(--text-secondary);
    text-transform: uppercase;
    margin-bottom: var(--space-s);
  }

  .maint-headline {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 6vw, 4.5rem);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.04em;
    color: var(--text-primary);
    margin-bottom: var(--space-l);
  }

  .maint-rule {
    width: 42px;
    height: 2.5px;
    background-color: var(--text-primary);
    margin-bottom: var(--space-l);
  }

  .maint-message {
    font-family: var(--font-body);
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--text-secondary);
    margin-bottom: var(--space-xl);
  }

  .maint-attrib {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .attrib-bold {
    color: var(--text-primary);
    font-weight: 600;
  }

  /* Suspended Traffic Signal */
  .signal-rig {
    position: relative;
    width: calc(100% + 4rem);
    margin-left: -2rem;
    padding-top: 76px;
    padding-bottom: clamp(2.5rem, 6vh, 4.5rem);
  }

  .signal-wires {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 130px;
    pointer-events: none;
  }

  .wire-line {
    stroke: var(--text-muted);
    stroke-width: 1.25;
    opacity: 0.65;
  }

  .signal-mast-row {
    position: relative;
    display: flex;
    align-items: flex-end;
  }

  .mast-pipe {
    position: relative;
    width: 82%;
    max-width: 720px;
    height: 12px;
    border-radius: 0 6px 6px 0;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--text-secondary) 38%, var(--bg-elevated) 62%) 0%,
      color-mix(in srgb, var(--bg-canvas) 65%, var(--bg-elevated) 35%) 65%,
      #050706 100%
    );
    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.55);
  }

  .mast-clamp {
    position: absolute;
    left: 14%;
    top: -5px;
    width: 24px;
    height: 22px;
    border-radius: 4px;
    background: color-mix(in srgb, var(--bg-elevated) 80%, var(--text-muted) 20%);
    border: 1px solid var(--border-hairline-bright);
    box-shadow: inset 0 2px 3px rgba(255, 255, 255, 0.08);
  }

  .signal-cluster {
    position: absolute;
    left: clamp(24%, 34vw, 38%);
    bottom: 6px;
    display: flex;
    align-items: flex-end;
    gap: 10px;
  }

  .signal-pod {
    position: relative;
  }

  .signal-hood {
    width: 68px;
    height: 74px;
    border-radius: 34px 34px 16px 16px;
    background: linear-gradient(175deg, #1b201e 0%, #090b0a 100%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 12px 9px 9px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow:
      inset 0 6px 10px rgba(0, 0, 0, 0.85),
      0 10px 20px rgba(0, 0, 0, 0.65);
  }

  .signal-lens {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .signal-lens.is-off {
    background: radial-gradient(circle at 38% 35%, #161a18 0%, #060807 75%);
    box-shadow: inset 0 4px 10px rgba(0, 0, 0, 0.95);
  }

  .signal-lens.is-red-heart {
    background: radial-gradient(
      circle at 50% 50%,
      rgba(239, 68, 68, 0.34) 0%,
      rgba(127, 29, 29, 0.55) 55%,
      #140707 100%
    );
    box-shadow:
      inset 0 2px 8px rgba(255, 110, 110, 0.35),
      0 0 22px rgba(239, 68, 68, 0.55),
      0 0 48px rgba(239, 68, 68, 0.25);
    animation: heartBeacon 2.6s ease-in-out infinite;
  }

  .heart-svg {
    width: 24px;
    height: 24px;
    color: #ff4444;
    filter: drop-shadow(0 0 8px rgba(255, 68, 68, 0.85));
  }

  @keyframes heartBeacon {
    0%, 100% {
      box-shadow:
        inset 0 2px 8px rgba(255, 110, 110, 0.35),
        0 0 22px rgba(239, 68, 68, 0.55),
        0 0 48px rgba(239, 68, 68, 0.25);
    }
    50% {
      box-shadow:
        inset 0 2px 10px rgba(255, 130, 130, 0.5),
        0 0 30px rgba(239, 68, 68, 0.78),
        0 0 64px rgba(239, 68, 68, 0.38);
    }
  }

  @media (max-width: 640px) {
    .signal-cluster {
      left: 18%;
      gap: 6px;
    }

    .signal-hood {
      width: 54px;
      height: 60px;
      padding: 9px 7px 7px;
    }

    .signal-lens {
      width: 38px;
      height: 38px;
    }

    .heart-svg {
      width: 19px;
      height: 19px;
    }

    .mast-pipe {
      width: 94%;
    }
  }
</style>
