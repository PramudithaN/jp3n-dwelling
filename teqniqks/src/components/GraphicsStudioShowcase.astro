---
/**
 * GraphicsStudioShowcase.astro
 * Pure HTML/CSS/SVG recreation of the 5 graphic design poster/flyer/social concepts,
 * 100% integrated with Teqniqks's dynamic theme variables.
 */
import { withBase } from '../utils/url';
---

<div class="graphics-showcase">
  <!-- =========================================================================
       BEAT 1: PINBOARD OVERVIEW (Flyers, Posters, Social Media, Brand Design)
       ========================================================================= -->
  <section class="gs-beat gs-pinboard" aria-labelledby="gs-pinboard-heading">
    <div class="pinboard-spotlight" aria-hidden="true"></div>
    <div class="pinboard-grid-bg" aria-hidden="true"></div>

    <div class="site-container">
      <div class="pinboard-canvas">
        <!-- Corner Capability Callouts (Orderly Breakdown) -->
        <div class="pin-callout pos-tl">
          <h2 id="gs-pinboard-heading" class="callout-script">Flyers &amp; Print</h2>
          <p>Event flyers, brochures, covers, menus, product boxes &amp; POSM.</p>
          <svg class="callout-arrow" viewBox="0 0 40 40" fill="none" aria-hidden="true">
            <path d="M28 32L14 10M14 10L10 19M14 10L23 13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </div>

        <div class="pin-callout pos-tr">
          <h3 class="callout-script">Social Media Posters</h3>
          <p>Scroll-stopping feed posters, carousels, banners &amp; ad creatives.</p>
        </div>

        <div class="pin-callout pos-bl">
          <h3 class="callout-script">Brand &amp; UI Systems</h3>
          <p>Visual identity, logos, landing page graphics &amp; design kits.</p>
          <svg class="callout-arrow arrow-bl" viewBox="0 0 40 40" fill="none" aria-hidden="true">
            <path d="M32 8L10 28M10 28L12 18M10 28L20 27" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </div>

        <div class="pin-callout pos-br">
          <svg class="callout-arrow arrow-br" viewBox="0 0 48 32" fill="none" aria-hidden="true">
            <path d="M4 6L38 24M38 24L28 26M38 24L34 14" stroke="currentColor" stroke-width="1.6" stroke-dasharray="4 3" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <h3 class="callout-script">Marketing Posters</h3>
          <p>Campaign key visuals, launch posters &amp; print-ready artwork.</p>
        </div>

        <!-- Center Stencil Lockup ("GRAPHICS STUDIO" / "PORT FOLIO" style) -->
        <div class="stencil-centerpiece">
          <div class="stencil-row">
            <span class="stencil-block">PORT</span>
            <span class="stencil-eye-badge" aria-hidden="true">
              <svg viewBox="0 0 44 44" fill="none">
                <circle cx="22" cy="22" r="19" stroke="currentColor" stroke-width="3" />
                <path d="M12 20C15 16 19 16 21 20M25 20C27 16 31 16 34 20" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
                <rect x="12" y="18" width="9" height="6" rx="1.5" stroke="currentColor" stroke-width="1.8" />
                <rect x="25" y="18" width="9" height="6" rx="1.5" stroke="currentColor" stroke-width="1.8" />
                <path d="M21 20H25" stroke="currentColor" stroke-width="1.8" />
              </svg>
            </span>
          </div>
          <div class="stencil-row">
            <span class="stencil-accent-dot" aria-hidden="true"></span>
            <span class="stencil-block">FOLIO</span>
          </div>

          <!-- Pinned Sticky Notes -->
          <div class="sticky-note note-top-right">
            <span class="pushpin pin-accent" aria-hidden="true"></span>
            <span class="note-brand">Teqniqks <em class="note-tag">Studio</em></span>
          </div>

          <div class="sticky-note note-mid-left">
            <span class="pushpin pin-accent" aria-hidden="true"></span>
            <strong class="note-title">Social Posters</strong>
            <span class="note-body">Feed graphics, stories, carousels &amp; promos.</span>
          </div>

          <div class="sticky-note note-bot-left">
            <span class="pushpin pin-soft" aria-hidden="true"></span>
            <strong class="note-title">Flyers &amp; Print</strong>
            <span class="note-body">Brochures, event flyers, packaging &amp; POSM.</span>
          </div>

          <div class="sticky-note note-mid-right">
            <span class="pushpin pin-soft" aria-hidden="true"></span>
            <strong class="note-title">Brand Design</strong>
            <span class="note-body">Logos, palettes, posters &amp; visual kits.</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       BEAT 2: BRAND CONTENT CALLOUT ("your brand deserves better visuals")
       ========================================================================= -->
  <section class="gs-beat gs-editorial" aria-labelledby="gs-editorial-heading">
    <div class="site-container">
      <div class="editorial-frame">
        <div class="editorial-top">
          <div class="ed-brand">
            <strong>teqniqks</strong>
            <span>GRAPHICS STUDIO</span>
          </div>
          <span class="ed-url">teqniqks.com</span>
        </div>

        <div class="editorial-body">
          <h2 id="gs-editorial-heading" class="ed-headline">
            <span class="ed-line">your brand</span>
            <span class="ed-line">deserves</span>
            <span class="ed-highlight-wrap">
              <span class="ed-handle-left" aria-hidden="true"><i></i></span>
              <span class="ed-highlight-text">better visuals</span>
              <span class="ed-handle-right" aria-hidden="true"><i></i></span>
            </span>
          </h2>

          <p class="ed-sub">And <em>this</em> is where that begins.</p>

          <a href={withBase('/#contact')} class="ed-cta">
            <span>let's chat</span>
            <span aria-hidden="true">▸</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       BEAT 3: SOCIAL MEDIA POSTERS ("Get People Talking About Your Brand")
       ========================================================================= -->
  <section class="gs-beat gs-social-poster" aria-labelledby="gs-social-heading">
    <div class="social-sunburst" aria-hidden="true"></div>
    <div class="site-container">
      <div class="social-poster-inner">
        <div class="social-eyebrow-badge">
          <span>SOCIAL</span>
          <span>POSTERS</span>
        </div>

        <h2 id="gs-social-heading" class="social-headline">
          <span class="sh-sm">Get People</span>
          <span class="sh-lg">Talking</span>
          <span class="sh-sm">About Your</span>
        </h2>

        <div class="ripped-tape-box">
          <span>Brand</span>
        </div>

        <!-- Die-cut Vector Sticker Cluster (Echoing Reference Sticker Collage) -->
        <div class="sticker-cluster" aria-hidden="true">
          <div class="diecut-sticker st-1">
            <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
              <path d="M8 10h8M8 14h5" />
            </svg>
          </div>
          <div class="diecut-sticker st-2">
            <svg width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 11l18-5v12L3 14v-3z" />
              <path d="M11.6 16.8a3 3 0 1 1-5.8-1.6" />
            </svg>
          </div>
          <div class="diecut-sticker st-3">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
            </svg>
          </div>
          <div class="diecut-sticker st-4">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="18" cy="5" r="3" />
              <circle cx="6" cy="12" r="3" />
              <circle cx="18" cy="19" r="3" />
              <line x1="8.59" y1="13.51" x2="15.42" y2="17.49" />
              <line x1="15.41" y1="6.51" x2="8.59" y2="10.49" />
            </svg>
          </div>
          <div class="diecut-sticker st-5">
            <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
            </svg>
          </div>
        </div>

        <p class="social-caption">
          Campaign posters, carousel decks, story templates, and launch graphics crafted to spark engagement.
        </p>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       BEAT 4: REACH & AD CREATIVES ("If you're not designing for reach...")
       ========================================================================= -->
  <section class="gs-beat gs-reach-poster" aria-labelledby="gs-reach-heading">
    <div class="site-container">
      <div class="reach-poster-stage">
        <div class="reach-top-brand">
          <span class="reach-logo-mark" aria-hidden="true">◈</span>
          <div class="reach-logo-text">
            <strong>Teqniqks</strong>
            <span>Graphics Studio</span>
          </div>
        </div>

        <h2 id="gs-reach-heading" class="reach-headline">
          <span class="reach-lead">If you're not designing</span>
          <span class="reach-giant-row">
            <span class="reach-for">for</span>
            <span class="reach-giant">reach,</span>
          </span>
        </h2>

        <svg class="reach-swoosh" viewBox="0 0 180 20" fill="none" aria-hidden="true">
          <path d="M10 14C60 4 120 4 170 14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
          <path d="M24 6C70 16 110 16 156 6" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" opacity="0.65" />
        </svg>

        <!-- Tilted Accent Card + Blurred Post Mockups -->
        <div class="reach-collage">
          <div class="reach-post-ghost ghost-left" aria-hidden="true">
            <div class="ghost-head">
              <span class="ghost-avatar"></span>
              <span class="ghost-lines"><i></i><i></i></span>
            </div>
            <div class="ghost-body"></div>
          </div>

          <div class="reach-accent-card">
            <span>you're talking</span>
            <span>to yourself</span>
          </div>

          <div class="reach-post-ghost ghost-right" aria-hidden="true">
            <div class="ghost-head">
              <span class="ghost-avatar"></span>
              <span class="ghost-lines"><i></i><i></i></span>
            </div>
            <div class="ghost-body"></div>
          </div>
        </div>

        <div class="reach-bottom-bar">
          <span>HIGH-CONVERTING SOCIAL ADS &amp; CAMPAIGN FLYERS</span>
          <span>teqniqks.com</span>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       BEAT 5: MARKETING POSTERS ("ATTENTION IS THE ULTIMATE CURRENCY")
       ========================================================================= -->
  <section class="gs-beat gs-attention-poster" aria-labelledby="gs-attention-heading">
    <div class="attention-upper">
      <div class="site-container">
        <div class="att-brand">teqniqks<span class="att-dot">.</span></div>

        <div class="att-headline-row">
          <div class="att-title-block">
            <h2 id="gs-attention-heading" class="att-giant">ATTENTION</h2>
            <p class="att-sub">IS THE ULTIMATE CURRENCY</p>
          </div>
          <div class="att-stem-line" aria-hidden="true">
            <span></span>
            <i></i>
          </div>
        </div>

        <p class="att-pitch">
          Make your brand unmissable with <strong>Teqniqks Marketing Posters</strong>
        </p>

        <!-- Lone Standout Silhouette with Spyglass -->
        <div class="att-standout-wrap">
          <svg class="att-standout-svg" viewBox="0 0 120 74" fill="none" aria-hidden="true">
            <!-- Long shadow -->
            <ellipse cx="72" cy="64" rx="40" ry="4" fill="currentColor" opacity="0.28" />
            <!-- Standing figure with spyglass -->
            <circle cx="28" cy="14" r="5.5" fill="currentColor" />
            <path d="M22 22C22 20 34 20 34 22L36 42L33 63H29L28 45L25 63H21L23 42L22 22Z" fill="currentColor" />
            <path d="M32 23L44 18" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
          </svg>
        </div>
      </div>
    </div>

    <!-- Diagonal Accent Band with Crowd Silhouettes -->
    <div class="attention-diagonal-band">
      <div class="att-crowd-row" aria-hidden="true">
        {[0, 1, 2, 3, 4, 5].map(() => (
          <svg class="att-walker-svg" viewBox="0 0 64 56" fill="none">
            <ellipse cx="40" cy="48" rx="18" ry="3" fill="currentColor" opacity="0.25" />
            <circle cx="20" cy="10" r="4.5" fill="currentColor" />
            <path d="M16 17H24L26 32L31 47H26L21 35L15 47H10L16 32V17Z" fill="currentColor" />
          </svg>
        ))}
      </div>

      <div class="att-bottom-lockup">
        <span class="att-think">think</span>
        <span class="att-unthinkable">unthinkable</span>
      </div>
    </div>
  </section>
</div>

<style>
  .site-container {
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: 0 var(--gutter);
    position: relative;
    z-index: 2;
  }

  .graphics-showcase {
    width: 100%;
  }

  .gs-beat {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--border-hairline);
  }

  /* =========================================================
     BEAT 1: PINBOARD OVERVIEW
     ========================================================= */
  .gs-pinboard {
    padding: var(--space-2xl) 0 var(--space-3xl);
    background-color: var(--bg-canvas);
  }

  .pinboard-spotlight {
    position: absolute;
    top: -120px;
    left: 50%;
    transform: translateX(-50%);
    width: 680px;
    height: 360px;
    background: radial-gradient(circle, color-mix(in srgb, var(--text-primary) 12%, transparent) 0%, transparent 70%);
    pointer-events: none;
  }

  .pinboard-grid-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, var(--border-hairline) 1px, transparent 1px),
      linear-gradient(to bottom, var(--border-hairline) 1px, transparent 1px);
    background-size: 32px 32px;
    opacity: 0.35;
    pointer-events: none;
  }

  .pinboard-canvas {
    position: relative;
    min-height: 540px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-2xl) 0;
  }

  .pin-callout {
    position: absolute;
    max-width: 240px;
    z-index: 3;
  }

  .pos-tl { top: 0; left: 2%; }
  .pos-tr { top: 0; right: 2%; text-align: right; }
  .pos-bl { bottom: 0; left: 2%; }
  .pos-br { bottom: 0; right: 2%; text-align: right; }

  .callout-script {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 1.8vw, 1.45rem);
    font-weight: 600;
    color: var(--text-primary);
    margin: 0 0 4px 0;
  }

  .pin-callout p {
    font-family: var(--font-body);
    font-size: 0.78rem;
    line-height: 1.45;
    color: var(--text-secondary);
    margin: 0;
  }

  .callout-arrow {
    width: 34px;
    height: 34px;
    color: var(--text-accent);
    margin-top: 6px;
  }

  .arrow-bl {
    position: absolute;
    right: -42px;
    top: -10px;
  }

  .arrow-br {
    margin-bottom: 6px;
  }

  /* Center Stencil */
  .stencil-centerpiece {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 0.86;
    padding: var(--space-l) var(--space-xl);
  }

  .stencil-row {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .stencil-block {
    font-family: var(--font-display);
    font-size: clamp(4.2rem, 10vw, 7.8rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    color: var(--text-primary);
    opacity: 0.92;
  }

  .stencil-eye-badge {
    width: clamp(3rem, 7vw, 5.2rem);
    height: clamp(3rem, 7vw, 5.2rem);
    color: var(--text-primary);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .stencil-accent-dot {
    width: clamp(2.4rem, 5vw, 3.8rem);
    height: clamp(2.4rem, 5vw, 3.8rem);
    border-radius: 50%;
    background-color: var(--text-accent);
    box-shadow: 0 0 28px var(--color-accent-glow, rgba(82, 164, 104, 0.35));
  }

  /* Sticky Notes */
  .sticky-note {
    position: absolute;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-hairline-bright);
    padding: 10px 12px;
    border-radius: 4px;
    box-shadow: 0 12px 26px rgba(0, 0, 0, 0.45);
    max-width: 150px;
    z-index: 4;
  }

  .note-top-right {
    top: -6px;
    right: -28px;
    transform: rotate(5deg);
    padding: 7px 14px;
  }

  .note-brand {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .note-tag {
    display: inline-block;
    padding: 2px 6px;
    margin-left: 4px;
    background: var(--text-accent);
    color: var(--bg-canvas);
    font-style: normal;
    border-radius: 3px;
  }

  .note-mid-left {
    top: 34%;
    left: -34px;
    transform: rotate(-8deg);
  }

  .note-bot-left {
    bottom: -10px;
    left: -58px;
    transform: rotate(4deg);
  }

  .note-mid-right {
    bottom: 12%;
    right: -46px;
    transform: rotate(-4deg);
  }

  .note-title {
    display: block;
    font-family: var(--font-display);
    font-size: 0.74rem;
    color: var(--text-accent);
    margin-bottom: 3px;
  }

  .note-body {
    display: block;
    font-family: var(--font-body);
    font-size: 0.64rem;
    line-height: 1.35;
    color: var(--text-secondary);
  }

  .pushpin {
    position: absolute;
    top: -6px;
    left: 50%;
    transform: translateX(-50%);
    width: 12px;
    height: 12px;
    border-radius: 50%;
    box-shadow: 0 3px 6px rgba(0, 0, 0, 0.5);
  }

  .pin-accent { background: var(--text-accent); }
  .pin-soft { background: var(--text-accent-soft); }

  /* =========================================================
     BEAT 2: EDITORIAL SELECTION CALLOUT
     ========================================================= */
  .gs-editorial {
    padding: var(--space-3xl) 0;
    background-color: var(--bg-surface);
  }

  .editorial-frame {
    max-width: 820px;
    margin: 0 auto;
  }

  .editorial-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: var(--space-2xl);
    padding-bottom: var(--space-s);
    border-bottom: 1px solid var(--border-hairline);
  }

  .ed-brand strong {
    display: block;
    font-family: var(--font-display);
    font-size: 1.15rem;
    color: var(--text-primary);
    line-height: 1;
  }

  .ed-brand span,
  .ed-url {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    color: var(--text-muted);
  }

  .ed-headline {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -0.04em;
    color: var(--text-primary);
    margin: 0 0 var(--space-l) 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .ed-highlight-wrap {
    position: relative;
    display: inline-block;
    padding: 0.04em 0.18em;
    margin-top: 0.06em;
    background: color-mix(in srgb, var(--text-accent) 20%, transparent);
  }

  .ed-highlight-text {
    font-style: italic;
    color: var(--text-accent-soft);
  }

  .ed-handle-left,
  .ed-handle-right {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 2px;
    background-color: var(--text-accent);
  }

  .ed-handle-left { left: 0; }
  .ed-handle-right { right: 0; }

  .ed-handle-left i,
  .ed-handle-right i {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background-color: var(--text-accent);
  }

  .ed-handle-left i { top: -10px; }
  .ed-handle-right i { bottom: -10px; }

  .ed-sub {
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.8vw, 1.3rem);
    color: var(--text-secondary);
    margin: 0 0 var(--space-l) 0;
  }

  .ed-sub em {
    font-style: italic;
    color: var(--text-primary);
  }

  .ed-cta {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    padding: 12px 20px;
    border-radius: 8px;
    background-color: var(--bg-canvas);
    border: 1px solid var(--border-hairline-bright);
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    text-decoration: none;
    transition: border-color 160ms ease, background-color 160ms ease, color 160ms ease;
  }

  .ed-cta:hover {
    border-color: var(--text-accent);
    background-color: var(--text-accent);
    color: var(--bg-canvas);
  }

  /* =========================================================
     BEAT 3: SOCIAL MEDIA POSTERS ("Get People Talking")
     ========================================================= */
  .gs-social-poster {
    padding: var(--space-3xl) 0;
    background-color: var(--bg-canvas);
    text-align: center;
  }

  .social-sunburst {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 45%, color-mix(in srgb, var(--text-accent) 18%, transparent) 0%, transparent 65%);
    pointer-events: none;
  }

  .social-poster-inner {
    max-width: 700px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .social-eyebrow-badge {
    display: inline-flex;
    flex-direction: column;
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 700;
