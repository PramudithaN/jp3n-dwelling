---
import { activeTheme, themes } from '../config/theme';

const themeList = Object.values(themes);
---

<div class="theme-dock" id="themeDock">
  <!-- Popover Theme Picker -->
  <div class="theme-popover" id="themePopover" hidden role="dialog" aria-label="Select website theme">
    <div class="popover-header">
      <span class="popover-title">SYSTEM THEME</span>
      <span class="popover-sub">Applies site-wide</span>
    </div>

    <div class="theme-options" role="radiogroup" aria-label="Website themes">
      {themeList.map((t) => (
        <button
          type="button"
          class={`theme-option ${t.id === activeTheme.id ? 'is-selected' : ''}`}
          data-theme-id={t.id}
          role="radio"
          aria-checked={t.id === activeTheme.id ? 'true' : 'false'}
        >
          <span
            class="theme-swatch"
            style={`background: ${t.colors.bgCanvas}; border-color: ${t.colors.accent};`}
            aria-hidden="true"
          >
            <span class="swatch-half is-primary" style={`background: ${t.colors.accent};`}></span>
            <span class="swatch-half is-secondary" style={`background: ${t.colors.accentSoft};`}></span>
          </span>
          <span class="theme-meta">
            <span class="theme-name">{t.name}</span>
          </span>
          <span class="theme-check" aria-hidden="true">✓</span>
        </button>
      ))}
    </div>
  </div>

  <!-- Hovering Floating Theme Icon Button -->
  <button
    type="button"
    class="theme-fab"
    id="themeFabBtn"
    aria-label="Change website theme"
    aria-expanded="false"
    aria-controls="themePopover"
    title="Change website theme"
  >
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="13.5" cy="6.5" r="1.2" fill="currentColor" />
      <circle cx="17.5" cy="10.5" r="1.2" fill="currentColor" />
      <circle cx="8.5" cy="7.5" r="1.2" fill="currentColor" />
      <circle cx="6.5" cy="12.5" r="1.2" fill="currentColor" />
      <path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2Z" />
    </svg>
  </button>
</div>

<script>
  const fabBtn = document.getElementById('themeFabBtn');
  const popover = document.getElementById('themePopover');
  const dock = document.getElementById('themeDock');
  const optionBtns = document.querySelectorAll('.theme-option[data-theme-id]');

  function syncSelectedState(themeId: string) {
    optionBtns.forEach((btn) => {
      const isMatch = btn.getAttribute('data-theme-id') === themeId;
      btn.classList.toggle('is-selected', isMatch);
      btn.setAttribute('aria-checked', isMatch ? 'true' : 'false');
    });
  }

  function setPopoverOpen(open: boolean) {
    if (!popover || !fabBtn) return;
    popover.hidden = !open;
    fabBtn.setAttribute('aria-expanded', String(open));
    fabBtn.classList.toggle('is-open', open);
  }

  fabBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    const isHidden = popover?.hidden ?? true;
    setPopoverOpen(isHidden);
  });

  optionBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.getAttribute('data-theme-id');
      if (!id) return;
      if (typeof (window as any).__applyTeqniqksTheme__ === 'function') {
        (window as any).__applyTeqniqksTheme__(id);
      }
      syncSelectedState(id);
    });
  });

  document.addEventListener('click', (e) => {
    if (dock && e.target instanceof Node && !dock.contains(e.target)) {
      setPopoverOpen(false);
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      setPopoverOpen(false);
    }
  });

  const currentId = document.documentElement.getAttribute('data-theme');
  if (currentId) {
    syncSelectedState(currentId);
  }
</script>

<style>
  .theme-dock {
    position: fixed;
    right: 20px;
    bottom: 24px;
    z-index: 9999;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 10px;
  }

  .theme-fab {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 1px solid var(--border-hairline-bright);
    background-color: var(--bg-elevated);
    color: var(--text-accent);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.5), 0 0 0 1px var(--border-hairline);
    transition: transform 180ms ease, border-color 180ms ease, background-color 180ms ease, color 180ms ease, box-shadow 180ms ease;
  }

  .theme-fab:hover,
  .theme-fab.is-open {
    transform: translateY(-2px);
    border-color: var(--text-accent);
    background-color: var(--text-accent);
    color: var(--bg-canvas);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.55), 0 0 20px var(--color-accent-glow, rgba(82, 164, 104, 0.3));
  }

  .theme-popover {
    width: 344px;
    max-width: calc(100vw - 32px);
    padding: 12px;
    border-radius: 14px;
    border: 1px solid var(--border-hairline-bright);
    background-color: var(--bg-surface);
    box-shadow: 0 18px 42px rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(12px);
  }

  .theme-popover[hidden] {
    display: none;
  }

  .popover-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding: 2px 4px 10px;
    margin-bottom: 8px;
    border-bottom: 1px solid var(--border-hairline);
  }

  .popover-title {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--text-accent);
  }

  .popover-sub {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--text-muted);
  }

  .theme-options {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 6px;
  }

  .theme-option {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 9px;
    border-radius: 9px;
    border: 1px solid transparent;
    background: transparent;
    color: var(--text-primary);
    cursor: pointer;
    text-align: left;
    transition: background-color 140ms ease, border-color 140ms ease;
  }

  .theme-option:hover {
    background-color: var(--bg-elevated);
    border-color: var(--border-hairline);
  }

  .theme-option.is-selected {
    background-color: var(--bg-elevated);
    border-color: var(--text-accent);
  }

  .theme-swatch {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 1.5px solid;
    overflow: hidden;
    display: grid;
    grid-template-columns: 1fr 1fr;
    flex-shrink: 0;
  }

  .swatch-half {
    display: block;
    width: 100%;
    height: 100%;
  }

  .theme-meta {
    flex-grow: 1;
    min-width: 0;
  }

  .theme-name {
    display: block;
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--text-primary);
  }

  .theme-check {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--text-accent);
    opacity: 0;
    transition: opacity 140ms ease;
  }

  .theme-option.is-selected .theme-check {
    opacity: 1;
  }

  @media (max-width: 640px) {
    .theme-dock {
      right: 14px;
      bottom: 16px;
    }
  }
</style>
