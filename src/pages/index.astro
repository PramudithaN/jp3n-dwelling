---
import BaseLayout from '../layouts/BaseLayout.astro';
import ParallaxHero from '../components/ParallaxHero.astro';
import WhoWeAre from '../components/WhoWeAre.astro';
import CreativeProcess from '../components/CreativeProcess.astro';
import TeamSection from '../components/TeamSection.astro';
import ThoughtsNoise from '../components/ThoughtsNoise.astro';
import EditorialCanvasCallout from '../components/EditorialCanvasCallout.astro';
import RetroWorkstation from '../components/RetroWorkstation.astro';
import ProjectsFolderStack from '../components/ProjectsFolderStack.astro';
import TeamCalendar from '../components/TeamCalendar.astro';
import WorkshopsFolders from '../components/WorkshopsFolders.astro';
import AfkSection from '../components/AfkSection.astro';
import TeamPreferences from '../components/TeamPreferences.astro';
import { siteConfig } from '../config/site';

const { email } = siteConfig.contact;
---

<BaseLayout title="Software & Design Atelier" canonicalPath="/">
  <!-- =========================================================================
       HERO: Teqniqks Spatial Parallax Canvas
       ========================================================================= -->
  <ParallaxHero />

  <!-- =========================================================================
       SECTION 1: WHO WE ARE (Intentional Brand & Systems Manifesto)
       ========================================================================= -->
  <WhoWeAre id="about" />

  <!-- =========================================================================
       SECTION 2: THE FOUR WORKSHOPS (Services & Contribution Gateway)
       ========================================================================= -->
  <section class="workshops-section" id="workshops" aria-labelledby="workshops-heading">
    <div class="site-container">
      <div class="section-title-wrap">
        <span class="section-kicker">DISCIPLINES</span>
        <h2 id="workshops-heading" class="section-heading">
          Four In-House Workshops
        </h2>
        <p class="section-sub">
          Zero outsourcing. Pick what you need: websites, design, video, or open source.
        </p>
      </div>
    </div>

    <div class="workshops-full-bleed">
      <WorkshopsFolders />
    </div>
  </section>

  <!-- =========================================================================
       SECTION 3: SELECTED SYSTEMS (Editorial Stack of Production Projects)
       ========================================================================= -->
  <section class="work-section" id="work" aria-labelledby="work-heading">
    <div class="site-container">
      <div class="section-title-wrap">
        <span class="section-kicker">PROVEN WORK</span>
        <h2 id="work-heading" class="section-heading">
          Selected Software & Tooling
        </h2>
        <p class="section-sub">Production systems running live on the global web.</p>
      </div>

      <ProjectsFolderStack />
    </div>
  </section>

  <!-- =========================================================================
       SECTION 4: THE PROCESS (Non-Linear Creative Loop)
       ========================================================================= -->
  <CreativeProcess id="process" />

  <!-- =========================================================================
       SECTION 5: THOUGHTS & SIGNAL NOISE (Engineering Mindset)
       ========================================================================= -->
  <ThoughtsNoise id="thoughts" />

  <!-- =========================================================================
       SECTION 6: EDITORIAL CLARITY CALLOUT (Shipping Cadence)
       ========================================================================= -->
  <EditorialCanvasCallout id="clarity" />

  <!-- =========================================================================
       SECTION 7: THE COLLECTIVE (Meet the Team)
       ========================================================================= -->
  <TeamSection />

  <!-- =========================================================================
       SECTION 7B: BUILD CALENDAR (Daily GitHub Contributions)
       ========================================================================= -->
  <TeamCalendar id="calendar" />

  <!-- =========================================================================
       SECTION 7C: TEAM MEMBER PREFERENCES (Music Rotation)
       ========================================================================= -->
  <TeamPreferences id="preferences" />

  <!-- =========================================================================
       SECTION 7D: AFK (Time Off the Keyboard)
       ========================================================================= -->
  <AfkSection id="afk" />

  <!-- =========================================================================
       SECTION 7: DIRECT ENGAGEMENT (Intake Unit + Retro Workstation)
       ========================================================================= -->
  <section class="intake-section" id="contact" aria-labelledby="intake-heading">
    <div class="site-container">
      <div class="intake-grid">
        <div class="intake-copy">
          <span class="section-kicker">WORK WITH US</span>
          <h2 id="intake-heading" class="intake-title">
            Start a Project Inquiry
          </h2>
          <p class="intake-text">
            We accept 3 select client projects per quarter to guarantee direct senior involvement
            from initial spec to final deployment.
          </p>

          <div class="intake-actions">
            <a
              href={`mailto:${email}?subject=Project%20Inquiry%20Teqniqks`}
              class="btn-intake-primary"
            >
              Send Project Brief
            </a>
            <button type="button" class="btn-intake-copy" id="copyEmailTrigger" data-email={email}>
              <span id="copyFeedback">Copy {email}</span>
            </button>
          </div>
        </div>

        <div class="intake-visual">
          <RetroWorkstation brand="Teqniqks" caption="DIRECT SENIOR INVOLVEMENT" />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { bindCopyEmail } from '../utils/copyEmail';

  bindCopyEmail('copyEmailTrigger', 'copyFeedback', 'Copied to Clipboard!');
</script>

<style>
  :global(html) {
    scroll-behavior: smooth;
  }

  :global(section[id]) {
    scroll-margin-top: 84px;
  }

  .site-container {
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  .section-kicker {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--text-accent);
    letter-spacing: 0.08em;
    display: block;
    margin-bottom: var(--space-xs);
  }

  .section-title-wrap {
    margin-bottom: var(--space-xl);
  }

  .section-heading {
    font-size: var(--step-4);
    font-weight: 300;
    color: var(--text-primary);
    margin-bottom: 4px;
    letter-spacing: -0.035em;
  }

  .section-sub {
    font-size: var(--step-0);
    color: var(--text-secondary);
  }

  /* --- SELECTED SYSTEMS --- */
  .work-section {
    padding: var(--space-3xl) 0;
    border-bottom: 1px solid var(--border-hairline);
  }

  /* --- WORKSHOPS --- */
  .workshops-full-bleed {
    width: 100%;
    padding: 0 clamp(1.25rem, 2.5vw, 2.5rem);
  }

  .workshops-section {
    padding: var(--space-3xl) 0;
    border-bottom: 1px solid var(--border-hairline);
  }

  /* --- INTAKE UNIT --- */
  .intake-section {
    padding: var(--space-3xl) 0;
  }

  .intake-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xl);
    align-items: center;
  }

  @media (min-width: 960px) {
    .intake-grid {
      grid-template-columns: 1fr 1.05fr;
      gap: var(--space-3xl);
    }
  }

  .intake-copy {
    text-align: left;
  }

  .intake-visual {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .intake-title {
    font-size: var(--step-3);
    font-weight: 300;
    color: var(--text-primary);
    margin-bottom: var(--space-s);
    letter-spacing: -0.03em;
  }

  .intake-text {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: var(--lh-body);
    max-width: 48ch;
    margin: 0 0 var(--space-2xl);
  }

  .intake-actions {
    display: flex;
    justify-content: flex-start;
    gap: var(--space-m);
    flex-wrap: wrap;
  }

  @media (max-width: 959px) {
    .intake-copy {
      text-align: center;
    }

    .intake-text {
      margin: 0 auto var(--space-2xl);
    }

    .intake-actions {
      justify-content: center;
    }
  }

  .btn-intake-primary {
    display: inline-flex;
    align-items: center;
    padding: 12px 24px;
    background-color: var(--color-raw-amber-vivid);
    color: #080503;
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 150ms ease;
  }

  .btn-intake-primary:hover {
    background-color: var(--color-raw-amber-sand);
  }

  .btn-intake-copy {
    display: inline-flex;
    align-items: center;
    padding: 12px 24px;
    background-color: transparent;
    border: 1px solid var(--border-hairline-bright);
    color: var(--color-raw-amber-sand);
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition:
      border-color 150ms ease,
      color 150ms ease;
  }

  .btn-intake-copy:hover {
    border-color: var(--color-raw-amber-vivid);
    color: var(--color-raw-amber-vivid);
  }

  @media (max-width: 640px) {
    .intake-title {
      font-size: var(--step-2);
    }
  }
</style>
