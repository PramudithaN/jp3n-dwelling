---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectsFolderStack from '../../components/ProjectsFolderStack.astro';
---

<BaseLayout
  title="Work & Production Systems"
  description="Case studies and production systems built by Teqniqks."
  canonicalPath="/work"
>
  <section class="work-page-section">
    <div class="site-container">
      <div class="page-header">
        <h1 class="page-title">Work & Production Systems</h1>
        <p class="page-lead">
          Verified software in production and open repositories. Zero synthetic metrics, zero
          fabricated testimonials.
        </p>
      </div>

      <ProjectsFolderStack />
    </div>
  </section>
</BaseLayout>

<style>
  .site-container {
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  .work-page-section {
    padding: var(--space-3xl) 0 var(--space-4xl);
  }

  .page-header {
    margin-bottom: var(--space-3xl);
  }

  .page-title {
    font-size: var(--step-5);
    color: var(--color-raw-parchment);
    margin-bottom: var(--space-xs);
    letter-spacing: -0.035em;
  }

  .page-lead {
    font-size: var(--step-1);
    color: var(--text-secondary);
    max-width: 52ch;
    line-height: var(--lh-body);
  }
</style>
