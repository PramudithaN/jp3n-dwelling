---
interface Props {
  brand?: string;
  headlineTop?: string;
  headlineHighlight?: string;
  headlineBottom?: string;
  badge?: string;
  caption?: string;
}

const { brand = 'Teqniqks', caption = 'DIRECT SENIOR INVOLVEMENT' } = Astro.props;
---

<div class="retro-workstation" data-power="on">
  <div class="workstation-stage">
    <!-- Stack of Disks on top of Monitor -->
    <div class="top-disk-stack" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
      <span></span>
    </div>

    <!-- =========================================================
         IBM-STYLE CRT MONITOR
         ========================================================= -->
    <div class="ibm-monitor">
      <div class="monitor-3d-shell">
        <div class="monitor-front">
          <div class="monitor-recess">
            <div class="crt-screen" id="crtScreen">
              <div class="crt-scanlines" aria-hidden="true"></div>
              <div class="crt-glare" aria-hidden="true"></div>

              <!-- Faint background terminal dump -->
              <pre class="crt-bg-dump" aria-hidden="true">0x004A  INIT ATELIER_CORE
0x0052  ALLOC STATIC_HTML
0x0060  ZERO_TRACKERS = 1
0x0074  WCAG_AA = PASS
0x0088  LCP_TARGET &lt; 800ms</pre>

              <!-- Centered Pixel Emblem + Brand -->
              <div class="crt-center-lockup">
                <svg
                  class="pixel-trophy"
                  viewBox="0 0 18 16"
                  shape-rendering="crispEdges"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <!-- Pixel Trophy / Crest -->
                  <rect x="4" y="1" width="10" height="2" />
                  <rect x="1" y="2" width="3" height="4" />
                  <rect x="14" y="2" width="3" height="4" />
                  <rect x="2" y="6" width="2" height="1" />
                  <rect x="14" y="6" width="2" height="1" />
                  <rect x="4" y="3" width="10" height="5" />
                  <rect x="6" y="8" width="6" height="2" />
                  <rect x="8" y="10" width="2" height="3" />
                  <rect x="5" y="13" width="8" height="2" />
                </svg>
                <span class="pixel-brand">{brand}</span>
              </div>

              <span class="crt-sub-caption">{caption}</span>

              <!-- Standby overlay -->
              <div class="crt-off-overlay" aria-hidden="true">
                <span class="crt-off-text">STANDBY</span>
              </div>
            </div>
          </div>

          <!-- Monitor Lower Chin (Vents + Badge + Dial Icons + Square Power Button) -->
          <div class="monitor-chin">
            <div class="chin-vents" aria-hidden="true">
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
            </div>

            <div class="chin-badge" aria-hidden="true">
              {brand}
            </div>

            <div class="chin-dials" aria-hidden="true">
              <span class="dial-tri"></span>
              <span class="dial-dot"></span>
              <span class="dial-sun"></span>
            </div>

            <button
              type="button"
              class="chin-power-btn"
              id="crtPowerToggle"
              aria-label="Toggle CRT workstation power"
              title="Power"
            >
              <span class="power-inner-sq"></span>
            </button>
          </div>
        </div>

        <!-- Subtle 3D Right Side Depth -->
        <div class="monitor-side-depth" aria-hidden="true"></div>
      </div>

      <!-- Thin Swivel Neck -->
      <div class="monitor-neck" aria-hidden="true"></div>
    </div>

    <!-- =========================================================
         DESKTOP CPU / BASE UNIT (Vents + 5.25" Drive Bay)
         ========================================================= -->
    <div class="ibm-desktop">
      <div class="desktop-front">
        <!-- Left Cooling Vents -->
        <div class="desktop-vents-area" aria-hidden="true">
          <div class="desktop-vents">
            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>
          </div>
          <span class="desktop-keylock"></span>
        </div>

        <!-- Right 5.25" Floppy Drive Bay + Lower Slot -->
        <div class="desktop-drive-area" aria-hidden="true">
          <div class="drive-bay-525">
            <span class="drive-slot-bar"></span>
            <span class="drive-latch"></span>
          </div>
          <div class="drive-bay-lower">
            <span class="lower-slot"></span>
          </div>
        </div>
      </div>

      <div class="desktop-side-depth" aria-hidden="true"></div>
    </div>

    <!-- =========================================================
         KEYBOARD, MOUSE & PANELLED DESK EDGE
         ========================================================= -->
    <div class="ibm-desk-surface" aria-hidden="true">
      <div class="peripherals-deck">
        <!-- Angled Low-Profile Keyboard -->
        <div class="ibm-keyboard">
          <div class="kb-keys">
            <div class="kb-row">
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
            </div>
            <div class="kb-row">
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
            </div>
            <div class="kb-row">
              <span></span>
              <span></span>
              <span></span>
              <span class="kb-space"></span>
              <span></span>
              <span></span>
              <span></span>
            </div>
          </div>
        </div>

        <!-- Sculpted Boxy Mouse -->
        <div class="ibm-mouse">
          <div class="mouse-top-bevel"></div>
        </div>
      </div>

      <!-- Vertical-panelled Desk Edge -->
      <div class="desk-edge">
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
      </div>
    </div>
  </div>
</div>

<script>
  const powerBtn = document.getElementById('crtPowerToggle');
  const workstation = powerBtn?.closest('.retro-workstation');

  if (powerBtn && workstation) {
    powerBtn.addEventListener('click', () => {
      const isOn = workstation.getAttribute('data-power') === 'on';
      workstation.setAttribute('data-power', isOn ? 'off' : 'on');
    });
  }
</script>

<style>
  .retro-workstation {
    /* Theme-derived classic hardware tones */
    --pc-light: color-mix(in srgb, var(--text-primary) 26%, var(--bg-elevated) 74%);
    --pc-mid: color-mix(in srgb, var(--text-secondary) 20%, var(--bg-elevated) 80%);
    --pc-dark: color-mix(in srgb, var(--bg-canvas) 62%, var(--bg-elevated) 38%);
    --pc-deep: #050806;
    --pc-highlight: color-mix(in srgb, var(--text-primary) 18%, transparent);

    width: 100%;
    max-width: 470px;
    margin: 0 auto;
    padding: 8px 10px 0;
    user-select: none;
  }

  .workstation-stage {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Top Disk Stack */
  .top-disk-stack {
    align-self: flex-start;
    margin-left: 18%;
    display: flex;
    flex-direction: column;
    gap: 1.5px;
    width: 34%;
    margin-bottom: -1px;
    z-index: 4;
  }

  .top-disk-stack span {
    display: block;
    height: 2.5px;
    background: linear-gradient(90deg, #070a08 0%, var(--pc-mid) 50%, #070a08 100%);
    border-radius: 1px;
  }

  .top-disk-stack span:nth-child(2) {
    width: 96%;
    margin-left: 2%;
  }
  .top-disk-stack span:nth-child(3) {
    width: 92%;
    margin-left: 4%;
  }

  /* =========================================================
     1. IBM-STYLE CRT MONITOR
     ========================================================= */
  .ibm-monitor {
    width: 78%;
    max-width: 348px;
    display: flex;
    flex-direction: column;
    align-items: center;
    z-index: 3;
  }

  .monitor-3d-shell {
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 18px;
  }

  .monitor-front {
    background: linear-gradient(168deg, var(--pc-light) 0%, var(--pc-mid) 65%, var(--pc-dark) 100%);
    border: 1px solid var(--border-hairline-bright);
    border-radius: 6px 2px 2px 6px;
    padding: 14px 14px 10px;
    box-shadow: inset 0 2px 2px var(--pc-highlight);
  }

  .monitor-side-depth {
    background: linear-gradient(180deg, var(--pc-dark) 0%, var(--pc-deep) 100%);
    border-top: 1px solid var(--border-hairline);
    border-right: 1px solid var(--border-hairline);
    border-bottom: 1px solid var(--border-hairline);
    border-radius: 0 6px 6px 0;
    transform: skewY(-6deg) translateY(1px);
    transform-origin: left center;
  }

  .monitor-recess {
    padding: 7px;
    background: var(--pc-deep);
    border-radius: 5px;
    box-shadow: inset 0 4px 10px rgba(0, 0, 0, 0.95);
    margin-bottom: 10px;
  }

  .crt-screen {
    position: relative;
    aspect-ratio: 4 / 3.1;
    width: 100%;
    border-radius: 6px;
    overflow: hidden;
    background: radial-gradient(
      circle at 50% 48%,
      color-mix(in srgb, var(--text-accent) 12%, #0c100d 88%) 0%,
      #040605 88%
    );
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    box-shadow: inset 0 0 24px rgba(0, 0, 0, 0.95);
  }

  .crt-scanlines {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      to bottom,
      rgba(255, 255, 255, 0) 0px,
      rgba(255, 255, 255, 0) 2px,
      rgba(0, 0, 0, 0.28) 3px,
      rgba(0, 0, 0, 0.28) 4px
    );
    pointer-events: none;
    z-index: 4;
  }

  .crt-glare {
    position: absolute;
    inset: 0;
    background: linear-gradient(125deg, rgba(255, 255, 255, 0.06) 0%, transparent 45%);
    pointer-events: none;
    z-index: 5;
  }

  .crt-bg-dump {
    position: absolute;
    inset: 10px;
    font-family: var(--font-mono);
    font-size: 0.45rem;
    line-height: 1.5;
    color: var(--text-secondary);
    opacity: 0.16;
    margin: 0;
    pointer-events: none;
    z-index: 1;
  }

  .crt-center-lockup {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--text-accent);
    filter: drop-shadow(0 0 10px var(--theme-accent-glow));
    transition: opacity 200ms ease;
  }

  .pixel-trophy {
    width: 34px;
    height: 30px;
  }

  .pixel-brand {
    font-family: var(--font-mono);
    font-size: 1.55rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1;
  }

  .crt-sub-caption {
    position: relative;
    z-index: 2;
    margin-top: 8px;
    font-family: var(--font-mono);
    font-size: 0.48rem;
    letter-spacing: 0.14em;
    color: var(--text-accent-soft);
    opacity: 0.78;
    transition: opacity 200ms ease;
  }

  .crt-off-overlay {
    position: absolute;
    inset: 0;
    z-index: 6;
    background: #030504;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 220ms ease;
  }

  .crt-off-text {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.2em;
    color: var(--text-muted);
  }

  .retro-workstation[data-power='off'] .crt-center-lockup,
  .retro-workstation[data-power='off'] .crt-sub-caption {
    opacity: 0;
  }

  .retro-workstation[data-power='off'] .crt-off-overlay {
    opacity: 1;
  }

  /* Monitor Chin Controls */
  .monitor-chin {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding-top: 2px;
  }

  .chin-vents {
    display: flex;
    gap: 3px;
    height: 16px;
  }

  .chin-vents span {
    width: 2px;
    height: 100%;
    background: var(--pc-deep);
    opacity: 0.75;
  }

  .chin-badge {
    padding: 2px 6px;
    background: var(--pc-deep);
    color: var(--text-accent-soft);
    font-family: var(--font-mono);
    font-size: 0.5rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    border: 1px solid var(--border-hairline);
  }

  .chin-dials {
    display: flex;
    align-items: center;
    gap: 6px;
    opacity: 0.55;
  }

  .dial-tri {
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-bottom: 6px solid var(--pc-deep);
  }

  .dial-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    border: 1px solid var(--pc-deep);
  }

  .dial-sun {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--pc-deep);
  }

  .chin-power-btn {
    width: 20px;
    height: 18px;
    background: var(--pc-mid);
    border: 1px solid var(--border-hairline-bright);
    box-shadow:
      inset 0 1px 1px var(--pc-highlight),
      0 1px 2px rgba(0, 0, 0, 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
  }

  .chin-power-btn:hover {
    border-color: var(--text-accent);
  }

  .power-inner-sq {
    width: 7px;
    height: 7px;
    border: 1.5px solid var(--text-accent);
  }

  .retro-workstation[data-power='off'] .power-inner-sq {
    border-color: var(--text-muted);
  }

  .monitor-neck {
    width: 62%;
    height: 7px;
    background: var(--pc-deep);
    border-left: 1px solid var(--border-hairline);
    border-right: 1px solid var(--border-hairline);
  }

  /* =========================================================
     2. DESKTOP BASE UNIT
     ========================================================= */
  .ibm-desktop {
    width: 88%;
    max-width: 400px;
    display: grid;
    grid-template-columns: 1fr 16px;
    z-index: 2;
  }

  .desktop-front {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 14px;
    padding: 12px 14px;
    background: linear-gradient(175deg, var(--pc-light) 0%, var(--pc-mid) 65%, var(--pc-dark) 100%);
    border: 1px solid var(--border-hairline-bright);
    border-radius: 4px 2px 2px 4px;
    box-shadow: inset 0 2px 2px var(--pc-highlight);
  }

  .desktop-side-depth {
    background: linear-gradient(180deg, var(--pc-dark) 0%, var(--pc-deep) 100%);
    border-top: 1px solid var(--border-hairline);
    border-right: 1px solid var(--border-hairline);
    border-bottom: 1px solid var(--border-hairline);
    border-radius: 0 4px 4px 0;
    transform: skewY(-5deg) translateY(1px);
    transform-origin: left center;
  }

  .desktop-vents-area {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 8px;
  }

  .desktop-vents {
    display: flex;
    gap: 3px;
    height: 46px;
  }

  .desktop-vents span {
    width: 2.5px;
    height: 100%;
    background: var(--pc-deep);
    opacity: 0.85;
  }

  .desktop-keylock {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--pc-deep);
    border: 1px solid var(--border-hairline);
  }

  .desktop-drive-area {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .drive-bay-525 {
    position: relative;
    height: 26px;
    background: var(--pc-deep);
    border: 1px solid var(--border-hairline);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 8px;
  }

  .drive-slot-bar {
    width: 100%;
    height: 3px;
    background: #020302;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .drive-latch {
    position: absolute;
    width: 8px;
    height: 16px;
    background: var(--pc-dark);
    border: 1px solid var(--border-hairline-bright);
  }

  .drive-bay-lower {
    height: 14px;
    background: var(--pc-dark);
    border: 1px solid var(--border-hairline);
    display: flex;
    align-items: center;
    padding: 0 8px;
  }

  .lower-slot {
    width: 100%;
    height: 4px;
    background: var(--pc-deep);
  }

  /* =========================================================
     3. KEYBOARD, MOUSE & PANELLED DESK EDGE
     ========================================================= */
  .ibm-desk-surface {
    width: 100%;
    margin-top: -4px;
    position: relative;
    z-index: 4;
  }

  .peripherals-deck {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 14px;
    padding: 0 8px;
  }

  .ibm-keyboard {
    flex: 1;
    max-width: 280px;
    padding: 5px 8px 6px;
    background: linear-gradient(180deg, var(--pc-light) 0%, var(--pc-dark) 100%);
    border: 1px solid var(--border-hairline-bright);
    border-radius: 3px 3px 2px 2px;
    transform: perspective(360px) rotateX(20deg);
    transform-origin: bottom center;
    box-shadow: 0 6px 14px rgba(0, 0, 0, 0.75);
  }

  .kb-keys {
    display: flex;
    flex-direction: column;
    gap: 2.5px;
    padding: 3px;
    background: var(--pc-deep);
  }

  .kb-row {
    display: flex;
    gap: 2px;
  }

  .kb-row span {
    flex: 1;
    height: 5px;
    background: var(--pc-light);
    border-radius: 1px;
  }

  .kb-row span.kb-space {
    flex: 5;
  }

  .ibm-mouse {
    width: 48px;
    height: 24px;
    background: linear-gradient(160deg, var(--pc-light) 0%, var(--pc-dark) 100%);
    border: 1px solid var(--border-hairline-bright);
    border-radius: 8px 8px 3px 3px;
    box-shadow: 0 6px 14px rgba(0, 0, 0, 0.75);
    padding: 3px;
  }

  .mouse-top-bevel {
    width: 100%;
    height: 10px;
    border-bottom: 1px solid var(--pc-deep);
  }

  .desk-edge {
    width: 100%;
    height: 22px;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--text-accent) 22%, var(--bg-elevated) 78%) 0%,
      color-mix(in srgb, var(--text-accent) 12%, var(--bg-canvas) 88%) 100%
    );
    border-top: 2px solid
      color-mix(in srgb, var(--text-accent) 40%, var(--border-hairline-bright) 60%);
    display: grid;
    grid-template-columns: repeat(6, 1fr);
  }

  .desk-edge span {
    border-right: 1px solid rgba(0, 0, 0, 0.35);
    height: 100%;
  }

  .desk-edge span:last-child {
    border-right: none;
  }
</style>
