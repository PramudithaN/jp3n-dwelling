---
interface Props {
  id?: string;
}

const { id = 'clarity' } = Astro.props;
---

<section class="editor-callout-section" id={id} aria-labelledby="editor-callout-heading">
  <div class="site-container">
    <div class="editor-canvas-frame">
      <!-- Minimalist Editor Toolbar -->
      <div class="editor-toolbar" aria-hidden="true">
        <span class="toolbar-item toolbar-icon">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
            <path
              d="M2 4H14M2 8H14M2 12H14"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
            />
          </svg>
        </span>
        <span class="toolbar-item">File</span>
        <span class="toolbar-item">
          <svg width="12" height="12" viewBox="0 0 16 16" fill="none">
            <path
              d="M2 11L5 4L8 8L11 4L14 11H2Z"
              stroke="currentColor"
              stroke-width="1.3"
              stroke-linejoin="round"
            />
          </svg>
          Resize
        </span>
        <span class="toolbar-item is-editing">
          <svg width="12" height="12" viewBox="0 0 16 16" fill="none">
            <path
              d="M11.5 2.5L13.5 4.5L5.5 12.5H3.5V10.5L11.5 2.5Z"
              stroke="currentColor"
              stroke-width="1.3"
              stroke-linejoin="round"
            />
          </svg>
          Editing
          <svg width="10" height="10" viewBox="0 0 12 12" fill="none">
            <path
              d="M3 4.5L6 7.5L9 4.5"
              stroke="currentColor"
              stroke-width="1.3"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </span>
        <span class="toolbar-item toolbar-icon">
          <svg width="13" height="13" viewBox="0 0 16 16" fill="none">
            <path
              d="M4 6H10.5C12.4 6 14 7.6 14 9.5C14 11.4 12.4 13 10.5 13H6M4 6L6.5 3.5M4 6L6.5 8.5"
              stroke="currentColor"
              stroke-width="1.3"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </span>
      </div>

      <!-- Main Editorial Typography Lockup -->
      <h2 id="editor-callout-heading" class="editor-lockup">
        <span class="selection-frame">
          <span class="corner-handle tl" aria-hidden="true"></span>
          <span class="corner-handle tr" aria-hidden="true"></span>
          <span class="corner-handle bl" aria-hidden="true"></span>
          <span class="corner-handle br" aria-hidden="true"></span>
          <span class="frame-text">
            Imagine shipping every
            <br />
            week without
          </span>
        </span>

        <span class="expressive-word">overthinking</span>
        <span class="serif-tail">a single design.</span>
      </h2>

      <div class="editor-credit">
        <span>TEQNIQKS | ENGINEERING &amp; DESIGN ATELIER</span>
        <span>BUILT FOR SPEED &amp; CLARITY</span>
      </div>
    </div>
  </div>
</section>

<style>
  .editor-callout-section {
    padding: clamp(3.5rem, 6vw, 5.5rem) 0;
    background-color: var(--bg-canvas, #09100b);
    border-bottom: 1px solid var(--border-hairline);
    position: relative;
  }

  .editor-canvas-frame {
    max-width: 680px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: clamp(2rem, 4vw, 3rem) clamp(1.25rem, 3vw, 2.5rem);
    background: radial-gradient(
      circle at 50% 45%,
      rgba(22, 34, 25, 0.55) 0%,
      rgba(16, 25, 18, 0.2) 70%,
      transparent 100%
    );
    border: 1px solid rgba(250, 249, 246, 0.06);
    border-radius: 4px;
  }

  /* Minimalist Design-Editor Toolbar */
  .editor-toolbar {
    display: inline-flex;
    align-items: center;
    gap: clamp(12px, 2.5vw, 22px);
    padding: 7px 16px;
    margin-bottom: 2rem;
    border-radius: 9999px;
    background: rgba(250, 249, 246, 0.03);
    border: 1px solid rgba(250, 249, 246, 0.08);
    font-family: var(--font-body, 'Sora', sans-serif);
    font-size: 0.74rem;
    color: var(--text-secondary, #a3ad9d);
  }

  .toolbar-item {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    opacity: 0.75;
    transition:
      opacity 150ms ease,
      color 150ms ease;
  }

  .toolbar-item.is-editing {
    color: var(--theme-accent, #52a468);
    opacity: 1;
    font-weight: 500;
  }

  /* Lockup */
  .editor-lockup {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    color: var(--text-primary, #faf9f6);
  }

  /* Tilted Dashed Bounding Box with Corner Handles */
  .selection-frame {
    position: relative;
    display: inline-block;
    padding: 0.55rem 1.35rem;
    border: 1.25px dashed rgba(250, 249, 246, 0.52);
    transform: rotate(-1.6deg);
    margin-bottom: 0.25rem;
    transition:
      transform 0.35s cubic-bezier(0.2, 0.9, 0.3, 1),
      border-color 0.3s ease;
  }

  .editor-canvas-frame:hover .selection-frame {
    transform: rotate(-0.5deg);
    border-color: var(--theme-accent, #52a468);
  }

  .corner-handle {
    position: absolute;
    width: 7px;
    height: 7px;
    background-color: #faf9f6;
    border: 1px solid var(--bg-canvas, #09100b);
  }

  .corner-handle.tl {
    top: -4px;
    left: -4px;
  }
  .corner-handle.tr {
    top: -4px;
    right: -4px;
  }
  .corner-handle.bl {
    bottom: -4px;
    left: -4px;
  }
  .corner-handle.br {
    bottom: -4px;
    right: -4px;
  }

  .frame-text {
    display: block;
    font-family: var(--font-display, 'Space Grotesk', sans-serif);
    font-size: clamp(1.25rem, 2.8vw, 1.95rem);
    font-weight: 400;
    line-height: 1.18;
    letter-spacing: -0.02em;
    color: var(--text-primary, #faf9f6);
  }

  .expressive-word {
    display: block;
    font-family: 'Georgia', 'Times New Roman', serif;
    font-style: italic;
    font-weight: 700;
    font-size: clamp(2.8rem, 7.5vw, 5.1rem);
    line-height: 0.96;
    letter-spacing: -0.04em;
    color: var(--text-primary, #faf9f6);
    margin-top: 0.15rem;
  }

  .serif-tail {
    display: block;
    font-family: 'Georgia', 'Times New Roman', serif;
    font-weight: 400;
    font-size: clamp(1.9rem, 4.8vw, 3.35rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--text-primary, #faf9f6);
    margin-top: 0.15rem;
  }

  .editor-credit {
    align-self: flex-start;
    margin-top: 1.75rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    color: var(--text-muted, #687463);
    text-transform: uppercase;
  }

  @media (max-width: 560px) {
    .editor-toolbar {
      gap: 10px;
      padding: 6px 12px;
      font-size: 0.68rem;
    }

    .selection-frame {
      padding: 0.45rem 0.95rem;
    }
  }
</style>
