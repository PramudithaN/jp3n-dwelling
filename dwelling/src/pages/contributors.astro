---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const contributorProjects = await getCollection('contributors');
---

<BaseLayout title="Open Source Forge" description="Join JP3N open source projects. Curated repositories, good first issues, and public architectural discussions." canonicalPath="/contributors">
  <section class="contributors-section">
    <div class="site-container">
      <div class="page-header">
        <h1 class="page-title">The Open Forge</h1>
        <p class="page-lead">
          We publish tools under open source licenses (MIT/OFL) and actively welcome community builders, designers, and contributors.
        </p>
      </div>

      <div class="contributor-welcome-card">
        <h2 class="welcome-title">Zero Gatekeeping. Verifiable Impact.</h2>
        <p class="welcome-text">
          Whether optimizing a WebAssembly binary parser, improving documentation, or adding tests, every PR receives a review from a core engineer within 48 hours.
        </p>
        <div class="welcome-steps-row">
          <div class="step-col">
            <span class="step-num">01</span>
            <span class="step-text">Select an active repository</span>
          </div>
          <div class="step-col">
            <span class="step-num">02</span>
            <span class="step-text">Review Good First Issues</span>
          </div>
          <div class="step-col">
            <span class="step-num">03</span>
            <span class="step-text">Submit a focused pull request</span>
          </div>
        </div>
      </div>

      <div class="section-title-wrap">
        <h2 class="section-subtitle">Active Community Repositories</h2>
        <p class="section-subtext">Public projects with curated issues ready for contribution.</p>
      </div>

      <div class="projects-list">
        {contributorProjects.map(project => (
          <article class="project-card">
            <div class="project-header-bar">
              <div class="project-title-group">
                <span class="project-lang">{project.data.primaryLanguage}</span>
                <span class="difficulty-tag diff-{project.data.difficulty}">
                  {project.data.difficulty}
                </span>
              </div>
              <div class="issues-count-badge">
                <span class="issues-num">{project.data.goodFirstIssuesCount}</span>
                <span class="issues-label">Good First Issues</span>
              </div>
            </div>

            <div class="project-body">
              <h3 class="project-name">{project.data.projectName}</h3>
              <p class="project-tagline">{project.data.tagline}</p>

              <div class="active-areas-box">
                <span class="areas-label">Focus Areas:</span>
                <div class="areas-pills">
                  {project.data.activeAreas.map(area => (
                    <span class="area-pill">{area}</span>
                  ))}
                </div>
              </div>

              <div class="project-actions">
                <a 
                  href={project.data.repoUrl} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="repo-btn-primary"
                >
                  View on GitHub
                </a>
                <a 
                  href={project.data.contributionGuideUrl} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="repo-btn-secondary"
                >
                  Contributing Guide
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contributors-section {
    padding: var(--space-3xl) 0 var(--space-4xl);
  }

  .site-container {
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  .page-header {
    margin-bottom: var(--space-3xl);
  }

  .page-title {
    font-size: var(--step-5);
    color: var(--color-raw-parchment);
    margin-bottom: var(--space-xs);
    letter-spacing: -0.035em;
  }

  .page-lead {
    font-size: var(--step-1);
    color: var(--text-secondary);
    max-width: 52ch;
    line-height: var(--lh-body);
  }

  .contributor-welcome-card {
    background-color: var(--surface-elevated);
    border: 2px solid var(--border-timber);
    padding: var(--space-2xl);
    box-shadow: var(--shadow-flat);
    margin-bottom: var(--space-3xl);
  }

  .welcome-title {
    font-size: var(--step-3);
    color: var(--color-raw-parchment);
    margin-bottom: var(--space-xs);
  }

  .welcome-text {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: var(--lh-body);
    max-width: 60ch;
    margin-bottom: var(--space-xl);
  }

  .welcome-steps-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-m);
    border-top: 1px solid var(--border-timber);
    padding-top: var(--space-l);
  }

  .step-col {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .step-num {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-raw-amber-vivid);
    font-weight: 700;
  }

  .step-text {
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--color-raw-parchment);
  }

  .section-title-wrap {
    margin-bottom: var(--space-xl);
  }

  .section-subtitle {
    font-size: var(--step-3);
    color: var(--color-raw-parchment);
    margin-bottom: 4px;
  }

  .section-subtext {
    font-size: var(--step-0);
    color: var(--text-secondary);
  }

  .projects-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-l);
  }

  .project-card {
    background-color: var(--surface-elevated);
    border: 2px solid var(--border-timber);
    box-shadow: var(--shadow-flat);
    transition: transform 150ms ease, border-color 150ms ease;
  }

  .project-card:hover {
    border-color: var(--color-raw-amber-sand);
    transform: translateY(-2px);
  }

  .project-header-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 16px;
    background-color: #0E0805;
    border-bottom: 1px solid var(--border-timber);
  }

  .project-title-group {
    display: flex;
    align-items: center;
    gap: var(--space-s);
  }

  .project-lang {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-raw-amber-sand);
  }

  .difficulty-tag {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    padding: 2px 6px;
    background-color: #1A0D06;
    border: 1px solid var(--border-timber);
    color: var(--color-raw-ash);
  }

  .issues-count-badge {
    display: flex;
    align-items: baseline;
    gap: 4px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .issues-num {
    color: var(--color-raw-amber-vivid);
    font-weight: 700;
  }

  .issues-label {
    color: var(--color-raw-ash);
  }

  .project-body {
    padding: var(--space-xl);
  }

  .project-name {
    font-size: var(--step-2);
    color: var(--color-raw-parchment);
    margin-bottom: var(--space-xs);
  }

  .project-tagline {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: var(--lh-body);
    margin-bottom: var(--space-m);
  }

  .active-areas-box {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    flex-wrap: wrap;
    margin-bottom: var(--space-l);
  }

  .areas-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-raw-ash);
  }

  .areas-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .area-pill {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    padding: 2px 7px;
    background-color: #0E0704;
    border: 1px solid var(--border-timber);
    color: var(--color-raw-amber-sand);
  }

  .project-actions {
    display: flex;
    gap: var(--space-s);
    flex-wrap: wrap;
  }

  .repo-btn-primary {
    display: inline-flex;
    align-items: center;
    padding: 8px 16px;
    background-color: var(--color-raw-amber-vivid);
    color: #0C0704;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 150ms ease;
  }

  .repo-btn-primary:hover {
    background-color: var(--color-raw-amber-sand);
    color: #0C0704;
  }

  .repo-btn-secondary {
    display: inline-flex;
    align-items: center;
    padding: 8px 16px;
    background-color: transparent;
    border: 1px solid var(--border-timber);
    color: var(--color-raw-amber-sand);
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    text-decoration: none;
    transition: border-color 150ms ease, color 150ms ease;
  }

  .repo-btn-secondary:hover {
    border-color: var(--color-raw-amber-vivid);
    color: var(--color-raw-amber-vivid);
  }

  @media (max-width: 640px) {
    .welcome-steps-row {
      grid-template-columns: 1fr;
    }
  }
</style>
