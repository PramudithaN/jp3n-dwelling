    previewHighlight: '#a8dadc',
    previewText: '#f1faee'
  },
  {
    id: 'arctic-frost',
    name: 'Arctic Frost',
    category: 'Crisp & Precision Clean',
    description: 'Cool glacial blue and metallic steel accents that convey high-clarity diagnostics, sub-second latency, and chill.',
    recommendedFor: 'Zero Cookie Architecture Journal, Metrics Bar, Client Diagnostics',
    colors: [
      { name: 'Steel Blue', hex: '#4a6fa5', role: 'Primary Accent' },
      { name: 'Ice Blue', hex: '#d4e4f7', role: 'Soft Highlight' },
      { name: 'Silver Metallic', hex: '#c0c0c0', role: 'Dividers' },
