    name: 'Ocean Depths',
    category: 'Deep Maritime & Telemetry',
    description: 'Serene maritime navy and teal tones signaling security, trust, stability, and zero-compromise engineering.',
    recommendedFor: 'Web Laboratory Workshop, Security Policy, Intake Unit',
    colors: [
      { name: 'Deep Navy', hex: '#1a2332', role: 'Dark Base' },
      { name: 'Teal', hex: '#2d8b8b', role: 'Primary Accent' },
      { name: 'Seafoam', hex: '#a8dadc', role: 'Secondary Accent' },
      { name: 'Cream White', hex: '#f1faee', role: 'Clean Text' }
    ],
