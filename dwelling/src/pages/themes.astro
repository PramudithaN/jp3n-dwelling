      { name: 'Electric Blue', hex: '#0066ff', role: 'Primary Accent' },
      { name: 'Neon Cyan', hex: '#00ffff', role: 'Bright Highlight' },
      { name: 'Dark Gray', hex: '#1e1e1e', role: 'Deep Base' },
      { name: 'Pure White', hex: '#ffffff', role: 'Text & Contrast' }
