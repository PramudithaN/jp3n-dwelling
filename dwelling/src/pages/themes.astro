    recommendedFor: 'Selected Systems Grid, Meri Clothing Case Study',
    colors: [
      { name: 'Burnt Orange', hex: '#e76f51', role: 'Primary Accent' },
      { name: 'Coral', hex: '#f4a261', role: 'Warm Secondary' },
      { name: 'Warm Sand', hex: '#e9c46a', role: 'Highlight' },
