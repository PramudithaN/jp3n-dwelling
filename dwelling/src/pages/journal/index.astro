---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const journalEntries = await getCollection('journal');
journalEntries.sort((a, b) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime());
---

<BaseLayout title="Journal & Technical Docs" description="Engineering reflections, architectural docs, and craft essays by Teqniqks Tech Dwelling." canonicalPath="/journal">
  <section class="journal-section">
    <div class="site-container">
      <div class="page-header">
        <h1 class="page-title">The Journal</h1>
        <p class="page-lead">
          Technical dispatches on zero-cookie privacy, Web APIs, sub-second 4G rendering, and design tokens. Written by engineers.
        </p>
      </div>

      <div class="journal-entries-stack">
        {journalEntries.map(entry => (
          <article class="entry-row">
            <div class="entry-meta">
              <span class="entry-type-pill type-{entry.data.type}">{entry.data.type}</span>
              <time datetime={entry.data.publishedDate.toISOString()} class="entry-date">
                {entry.data.publishedDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
              </time>
              <span class="read-time">{entry.data.readingTimeMinutes} min read</span>
            </div>

            <div class="entry-main">
              <h2 class="entry-title">
                <a href={`/journal/${entry.id}`}>{entry.data.title}</a>
              </h2>
              <p class="entry-desc">{entry.data.description}</p>
              
              <div class="entry-tags">
                {entry.data.tags.map(tag => (
                  <span class="tag-pill">#{tag}</span>
                ))}
              </div>
            </div>

            <div class="entry-action">
              <a href={`/journal/${entry.id}`} class="btn-read-entry">Read Entry</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .site-container {
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  .journal-section {
    padding: var(--space-3xl) 0 var(--space-4xl);
  }

  .page-header {
    margin-bottom: var(--space-3xl);
  }

  .page-title {
    font-size: var(--step-5);
    color: var(--color-raw-parchment);
    margin-bottom: var(--space-xs);
    letter-spacing: -0.035em;
  }

  .page-lead {
    font-size: var(--step-1);
    color: var(--text-secondary);
    max-width: 52ch;
    line-height: var(--lh-body);
  }

  .journal-entries-stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-l);
  }

  .entry-row {
    background-color: var(--surface-elevated);
    border: 2px solid var(--border-timber);
    box-shadow: var(--shadow-flat);
    padding: var(--space-xl);
    display: grid;
    grid-template-columns: 180px 1fr auto;
    gap: var(--space-xl);
    align-items: center;
    transition: transform 150ms ease, border-color 150ms ease;
  }

  .entry-row:hover {
    border-color: var(--color-raw-amber-sand);
    transform: translateY(-2px);
  }

  .entry-meta {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .entry-type-pill {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--color-raw-amber-vivid);
    text-transform: uppercase;
  }

  .entry-date {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-raw-ash);
  }

  .read-time {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-raw-ash);
  }

  .entry-main {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .entry-title {
    font-size: var(--step-2);
  }

  .entry-title a {
    color: var(--color-raw-parchment);
    text-decoration: none;
  }

  .entry-title a:hover {
    color: var(--color-raw-amber-vivid);
  }

  .entry-desc {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: var(--lh-body);
    margin: 0;
  }

  .entry-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .tag-pill {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-raw-ochre);
  }

  .btn-read-entry {
    display: inline-flex;
    align-items: center;
    padding: 8px 16px;
    background-color: transparent;
    border: 1px solid var(--border-timber);
    color: var(--color-raw-amber-sand);
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: border-color 150ms ease, color 150ms ease;
  }

  .btn-read-entry:hover {
    border-color: var(--color-raw-amber-vivid);
    color: var(--color-raw-amber-vivid);
  }

  @media (max-width: 900px) {
    .entry-row {
      grid-template-columns: 1fr;
      gap: var(--space-m);
    }
    .btn-read-entry {
      align-self: flex-start;
    }
  }
</style>
