---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectDossierBoard from '../../components/ProjectDossierBoard.astro';
import ProjectEvidenceBoard from '../../components/ProjectEvidenceBoard.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../../utils/url';

export async function getStaticPaths() {
  const workEntries = await getCollection('work');
  return workEntries.map(entry => ({
    params: { slug: entry.id },
    props: { entry }
  }));
}

const { entry } = Astro.props;
---

<BaseLayout title={entry.data.title} description={entry.data.tagline} canonicalPath={`/work/${entry.id}`}>
  <article class="case-study-article">
    <div class="site-container">
      <div class="case-header">
        <a href={withBase('/#work')} class="back-link" id="projectBackLink">
          <span class="back-arrow-circle" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12.5 8H3.5" />
              <path d="M7.5 4L3.5 8L7.5 12" />
            </svg>
          </span>
          <span>Back to Projects</span>
        </a>
        <ProjectDossierBoard
          id={entry.id}
          title={entry.data.title}
          tagline={entry.data.tagline}
          category={entry.data.category}
          status={entry.data.status}
          owner={entry.data.owner}
          ownerHandle={entry.data.ownerHandle}
          languages={entry.data.languages}
          stars={entry.data.stars}
          forks={entry.data.forks}
          techStack={entry.data.techStack}
          metrics={entry.data.metrics}
          liveUrl={entry.data.liveUrl}
          repoUrl={entry.data.repoUrl}
          body={entry.body}
        />
      </div>

      <ProjectEvidenceBoard
        title={entry.data.title}
        tagline={entry.data.tagline}
        owner={entry.data.owner}
        ownerHandle={entry.data.ownerHandle}
        languages={entry.data.languages}
        stars={entry.data.stars}
        forks={entry.data.forks}
        techStack={entry.data.techStack}
        status={entry.data.status}
        liveUrl={entry.data.liveUrl}
        repoUrl={entry.data.repoUrl}
        body={entry.body}
      />
    </div>
  </article>
</BaseLayout>

<script>
  const backLink = document.getElementById('projectBackLink');
  if (backLink) {
    backLink.addEventListener('click', (e) => {
      if (
        document.referrer &&
        new URL(document.referrer).origin === window.location.origin &&
        window.history.length > 1
      ) {
        e.preventDefault();
        window.history.back();
      }
    });
  }
</script>

<style>
  .site-container {
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  .case-study-article {
    padding: var(--space-3xl) 0 var(--space-4xl);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 14px 6px 6px;
    border-radius: 999px;
    border: 1px solid var(--border-hairline-bright);
    background-color: var(--bg-surface);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--text-primary);
    margin-bottom: var(--space-l);
    transition: border-color 160ms ease, background-color 160ms ease, color 160ms ease;
  }

  .back-arrow-circle {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background-color: var(--bg-elevated);
    border: 1px solid var(--border-hairline-bright);
    color: var(--text-accent);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: background-color 160ms ease, color 160ms ease, border-color 160ms ease, transform 160ms ease;
  }

  .back-link:hover,
  .back-link:focus-visible {
    border-color: var(--text-accent);
    background-color: var(--bg-elevated);
    color: var(--text-accent);
  }

  .back-link:hover .back-arrow-circle,
  .back-link:focus-visible .back-arrow-circle {
    background-color: var(--text-accent);
    border-color: var(--text-accent);
    color: var(--bg-canvas);
    transform: translateX(-2px);
  }

  .meta-tags-row {
    display: flex;
    gap: var(--space-xs);
    margin-bottom: var(--space-xs);
    font-family: var(--font-spec);
    font-size: 0.75rem;
    text-transform: uppercase;
  }

  .category-badge {
    color: var(--color-raw-ochre);
  }

  .status-badge {
    color: var(--color-raw-amber-vivid);
  }

  .case-title {
    font-size: var(--step-4);
    color: var(--color-raw-parchment);
    margin-bottom: var(--space-xs);
  }

  .case-tagline {
    font-size: var(--step-1);
    color: var(--text-secondary);
    max-width: var(--reading-max-width);
    margin-bottom: var(--space-2xl);
  }

  .case-specs-card {
    background-color: var(--surface-elevated);
    border: 1px solid var(--border-timber);
    padding: var(--space-l);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-l);
    margin-bottom: var(--space-3xl);
  }

  .spec-label {
    font-family: var(--font-spec);
    font-size: 0.75rem;
    color: var(--color-raw-amber-sand);
    text-transform: uppercase;
    display: block;
    margin-bottom: var(--space-xs);
  }

  .spec-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  .pill {
    font-family: var(--font-spec);
    font-size: 0.75rem;
    padding: 2px 6px;
    background-color: var(--surface-base);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
  }

  .metrics-list {
    list-style: none;
    font-family: var(--font-spec);
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  .metrics-list li {
    margin-bottom: 4px;
  }

  .links-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .link-btn {
    font-family: var(--font-spec);
    font-size: var(--step--1);
    color: var(--color-raw-amber-vivid);
  }

  .markdown-content {
    max-width: var(--reading-max-width);
    font-size: var(--step-0);
    line-height: var(--lh-relaxed);
  }

  .markdown-content h2 {
    font-size: var(--step-2);
    color: var(--color-raw-parchment);
    margin-top: var(--space-2xl);
    margin-bottom: var(--space-s);
  }

  .markdown-content h3 {
    font-size: var(--step-1);
    color: var(--color-raw-amber-sand);
    margin-top: var(--space-xl);
    margin-bottom: var(--space-xs);
  }

  .markdown-content ul {
    margin-left: var(--space-l);
    margin-bottom: var(--space-m);
  }

  .markdown-content li {
    margin-bottom: var(--space-2xs);
  }

  @media (max-width: 768px) {
    .case-specs-card {
      grid-template-columns: 1fr;
    }
  }
</style>
