---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="How We Plan" description="The engineering method: how JP3N audits, builds, and verifies web software with fixed scopes." canonicalPath="/process">
  <section class="process-section">
    <div class="site-container">
      <div class="process-header-row">
        <h1 class="page-title">Engineering Methodology</h1>
        <span class="method-tag">FIXED SCOPE ARCHITECTURE</span>
      </div>
      <p class="page-lead">
        We build under fixed scope contracts with transparent deliverables, performance budgets, and non-negotiable delivery dates.
      </p>

      <div class="process-deep-grid">
        <!-- Stage 01 -->
        <article class="process-card">
          <div class="card-num-bar">
            <span class="stage-tag">STAGE 01</span>
            <span class="stage-name">AUDIT & CAP</span>
          </div>
          <div class="card-inner">
            <h2 class="stage-title">Structural Audit & Scope Cap</h2>
            <p>
              We analyze traffic patterns, runtime bottlenecks, and server requirements to establish a fixed scope and budget cap before writing code.
            </p>
            <div class="deliverables-box">
              <span class="box-label">Key Deliverables</span>
              <ul>
                <li>Single markdown architectural specification</li>
                <li>Performance budget contract (LCP &lt; 1.0s on 4G)</li>
                <li>Fixed scope and delivery milestone dates</li>
              </ul>
            </div>
          </div>
        </article>

        <!-- Stage 02 -->
        <article class="process-card">
          <div class="card-num-bar">
            <span class="stage-tag">STAGE 02</span>
            <span class="stage-name">DESIGN TOKENS</span>
          </div>
          <div class="card-inner">
            <h2 class="stage-title">Token Systems & Narrative Design</h2>
            <p>
              Design systems defined in pure CSS custom properties with real typography, audited WCAG AA contrast, and zero generic placeholders.
            </p>
            <div class="deliverables-box">
              <span class="box-label">Key Deliverables</span>
              <ul>
                <li>Semantic CSS design tokens stylesheet</li>
                <li>WCAG AA chromatic contrast audit</li>
                <li>Self-hosted WOFF font subsets with zero CDN tracking</li>
              </ul>
            </div>
          </div>
        </article>

        <!-- Stage 03 -->
        <article class="process-card">
          <div class="card-num-bar">
            <span class="stage-tag">STAGE 03</span>
            <span class="stage-name">STATIC COMPILATION</span>
          </div>
          <div class="card-inner">
            <h2 class="stage-title">Static-First Architecture</h2>
            <p>
              Compiled to pure static HTML via Astro. Dynamic interactivity is isolated to lightweight component islands with zero framework overhead.
            </p>
            <div class="deliverables-box">
              <span class="box-label">Key Deliverables</span>
              <ul>
                <li>Zero JavaScript required for core reading</li>
                <li>Strict Content Security Policy (CSP) headers</li>
                <li>Sub-second paint on degraded mobile connections</li>
              </ul>
            </div>
          </div>
        </article>

        <!-- Stage 04 -->
        <article class="process-card">
          <div class="card-num-bar">
            <span class="stage-tag">STAGE 04</span>
            <span class="stage-name">VERIFICATION</span>
          </div>
          <div class="card-inner">
            <h2 class="stage-title">Throttled Mobile Benchmarks</h2>
            <p>
              We benchmark on simulated mid-tier mobile hardware and throttled 4G profiles. 95+ Lighthouse mobile or deployment does not proceed.
            </p>
            <div class="deliverables-box">
              <span class="box-label">Key Deliverables</span>
              <ul>
                <li>Automated Lighthouse CI audit reports</li>
                <li>Zero-cookie privacy verification</li>
                <li>Clean handoff with complete documentation</li>
              </ul>
            </div>
          </div>
        </article>
      </div>

      <!-- Capacity & Callout -->
      <div class="process-cta-banner">
        <div class="cta-banner-text">
          <h2 class="cta-banner-title">Ready to build with predictable engineering?</h2>
          <p class="cta-banner-desc">We take on maximum 3 active commercial clients per month.</p>
        </div>
        <a href="/contact" class="btn-banner-action">
          Start Project Discussion
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .process-section {
    padding: var(--space-3xl) 0 var(--space-4xl);
  }

  .site-container {
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  .process-header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-s);
    margin-bottom: var(--space-xs);
  }

  .page-title {
    font-size: var(--step-5);
    color: var(--color-raw-parchment);
    letter-spacing: -0.035em;
  }

  .page-lead {
    font-size: var(--step-1);
    color: var(--text-secondary);
    max-width: 52ch;
    margin-bottom: var(--space-3xl);
    line-height: var(--lh-body);
  }

  .process-deep-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-xl);
    margin-bottom: var(--space-4xl);
  }

  .process-card {
    background-color: var(--surface-elevated);
    border: 2px solid var(--border-timber);
    box-shadow: var(--shadow-flat);
    display: flex;
    flex-direction: column;
  }

  .card-num-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 16px;
    background-color: #0E0805;
    border-bottom: 1px solid var(--border-timber);
  }

  .stage-tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-raw-amber-vivid);
  }

  .stage-name {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-raw-ash);
  }

  .card-inner {
    padding: var(--space-xl);
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .stage-title {
    font-size: var(--step-2);
    color: var(--color-raw-parchment);
    margin-bottom: var(--space-xs);
  }

  .card-inner p {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: var(--lh-body);
    margin-bottom: var(--space-l);
  }

  .deliverables-box {
    background-color: #090503;
    border: 1px solid var(--border-timber);
    padding: var(--space-m);
    margin-top: auto;
  }

  .box-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--color-raw-amber-sand);
    display: block;
    margin-bottom: var(--space-xs);
    letter-spacing: 0.04em;
  }

  .deliverables-box ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .deliverables-box li {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-raw-ash);
    padding-left: 12px;
    position: relative;
  }

  .deliverables-box li::before {
    content: '•';
    position: absolute;
    left: 0;
    color: var(--color-raw-amber-vivid);
  }

  /* CTA Banner */
  .process-cta-banner {
    background-color: var(--surface-elevated);
    border: 2px solid var(--color-raw-timber);
    padding: var(--space-2xl);
    box-shadow: var(--shadow-flat);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-l);
  }

  .cta-banner-title {
    font-size: var(--step-2);
    color: var(--color-raw-parchment);
    margin-bottom: 4px;
  }

  .cta-banner-desc {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    margin: 0;
  }

  .btn-banner-action {
    display: inline-flex;
    align-items: center;
    padding: 12px 24px;
    background-color: var(--color-raw-amber-vivid);
    color: #0C0704;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 150ms ease;
  }

  .btn-banner-action:hover {
    background-color: var(--color-raw-amber-sand);
    color: #0C0704;
  }

  @media (max-width: 900px) {
    .process-deep-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
