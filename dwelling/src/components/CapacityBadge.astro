---
interface Props {
  class?: string;
  condensed?: boolean;
}

const { class: className = '' } = Astro.props;
---

<div class={`capacity-badge ${className}`} aria-label="Status: Active Intake">
  <span class="status-indicator" aria-hidden="true">●</span>
  <span class="metric-label">ACTIVE INTAKE</span>
</div>

<style>
  .capacity-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-2xs) var(--space-s);
    background-color: var(--surface-elevated);
    border: 1px solid var(--border-timber);
    font-family: var(--font-spec);
    font-size: var(--step--1);
    color: var(--text-primary);
    line-height: 1.2;
    border-radius: var(--radius-tag);
    white-space: nowrap;
  }

  .status-indicator {
    color: var(--color-raw-amber-vivid);
    font-size: 0.65rem;
  }

  .metric-label {
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    color: var(--text-secondary);
  }
</style>
