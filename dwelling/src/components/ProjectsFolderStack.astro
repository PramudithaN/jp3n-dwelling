---
import { getCollection } from 'astro:content';
import { siteConfig } from '../config/site';
import { withBase } from '../utils/url';

const workItems = await getCollection('work');
workItems.sort((a, b) => a.data.featuredOrder - b.data.featuredOrder);

// Tab horizontal offsets staggered like the reference folder stack
const tabPositions = ['pos-right', 'pos-mid-left', 'pos-far-left', 'pos-mid-right'];
---

<div class="folder-archive" id="projectsFolderArchive">
  <!-- Top Stage Header -->
  <div class="folder-stage-top">
    <div class="folder-greeting">
      <span class="greeting-main">Projects</span><span class="greeting-bang">!</span>
    </div>
    <span class="folder-year">©2026</span>
  </div>

  <!-- Stacked Interactive Manila/Index Folders -->
  <div class="folder-stack" role="list" aria-label="Projects archive folders">
    {workItems.map((item, idx) => {
      const isLight = idx % 2 === 0;
      const posClass = tabPositions[idx % tabPositions.length];
      const shortName = item.data.title.split(' ')[0];
      return (
        <a
          href={withBase(`/work/${item.id}`)}
          role="listitem"
          class={`folder-layer ${isLight ? 'is-light' : 'is-dark'} ${posClass}`}
          style={`--layer-idx: ${idx};`}
          data-project-title={shortName}
          data-project-full={item.data.title}
          data-project-vol={`VOL. 0${idx + 1}`}
          data-project-tagline={item.data.tagline}
          data-project-url={withBase(`/work/${item.id}`)}
        >
          <span class="folder-tab">
            <span class="tab-label">({item.data.title.toUpperCase()})</span>
          </span>
          <span class="folder-sheet"></span>
        </a>
      );
    })}

    <!-- Front-Most Cover Folder -->
    <a
      href={withBase(workItems[0] ? `/work/${workItems[0].id}` : '/work')}
      class="folder-front-cover"
      id="folderFrontCover"
    >
      <span class="folder-tab front-tab">
        <span class="tab-label" id="frontTabLabel">(01 – {workItems.length.toString().padStart(2, '0')})</span>
      </span>

      <div class="front-cover-body">
        <div class="front-top-row">
          <!-- 4-Diamond Mark -->
          <div class="diamond-emblem" aria-hidden="true">
            <span></span><span></span><span></span><span></span>
          </div>

          <div class="front-vol-meta">
            <span>SELECTED</span>
            <span>PROJECTS</span>
            <span id="frontVolLabel">VOL. 0{workItems.length}</span>
          </div>
        </div>

        <div class="front-title-area">
          <div class="front-display-title" id="frontDisplayTitle">Archive</div>
          <p class="front-tagline" id="frontTagline">
            Select any folder tab above to inspect project architecture, metrics, and live tooling.
          </p>
          <div class="front-watermark" aria-hidden="true" id="frontWatermark">Archive</div>
        </div>

        <div class="front-bottom-row">
          <span class="front-teqniqks-badge">
            <span class="badge-dot"></span>
            Teqniqks
          </span>

          <div class="front-contact-meta">
            <span class="contact-kicker">WORK WITH US:</span>
            <span class="contact-val">{siteConfig.contact.email.toUpperCase()}</span>
          </div>
        </div>
      </div>
    </a>
  </div>
</div>

<script>
  const archive = document.getElementById('projectsFolderArchive');
  if (archive) {
    const layers = archive.querySelectorAll<HTMLAnchorElement>('.folder-layer');
    const frontCover = document.getElementById('folderFrontCover') as HTMLAnchorElement | null;
    const frontTitle = document.getElementById('frontDisplayTitle');
    const frontWatermark = document.getElementById('frontWatermark');
    const frontVol = document.getElementById('frontVolLabel');
    const frontTagline = document.getElementById('frontTagline');

    const defaultTitle = 'Archive';
    const defaultVol = frontVol?.textContent || 'VOL. 04';
    const defaultTagline =
      frontTagline?.textContent ||
      'Select any folder tab above to inspect project architecture, metrics, and live tooling.';
    const defaultHref = frontCover?.getAttribute('href') || '/work';

    layers.forEach((layer) => {
      const activatePreview = () => {
        const title = layer.getAttribute('data-project-title') || defaultTitle;
        const vol = layer.getAttribute('data-project-vol') || defaultVol;
        const tagline = layer.getAttribute('data-project-tagline') || defaultTagline;
        const url = layer.getAttribute('data-project-url') || defaultHref;

        if (frontTitle) frontTitle.textContent = title;
        if (frontWatermark) frontWatermark.textContent = title;
        if (frontVol) frontVol.textContent = vol;
        if (frontTagline) frontTagline.textContent = tagline;
        if (frontCover) frontCover.setAttribute('href', url);
      };

      layer.addEventListener('mouseenter', activatePreview);
      layer.addEventListener('focus', activatePreview);
    });

    archive.addEventListener('mouseleave', () => {
      if (frontTitle) frontTitle.textContent = defaultTitle;
      if (frontWatermark) frontWatermark.textContent = defaultTitle;
      if (frontVol) frontVol.textContent = defaultVol;
      if (frontTagline) frontTagline.textContent = defaultTagline;
      if (frontCover) frontCover.setAttribute('href', defaultHref);
    });
  }
</script>

<style>
  .folder-archive {
    --folder-dark: var(--bg-elevated);
    --folder-dark-border: var(--border-hairline-bright);
    --folder-light: color-mix(in srgb, var(--text-primary) 92%, var(--text-accent-soft) 8%);
    --folder-light-text: var(--bg-canvas);
    --folder-front: var(--bg-surface);

    position: relative;
    background: color-mix(in srgb, var(--bg-canvas) 82%, var(--bg-surface) 18%);
    border: 1px solid var(--border-hairline);
    padding: clamp(1.5rem, 4vw, 3rem) clamp(1rem, 3vw, 2.5rem) 0;
    overflow: hidden;
  }

  /* Top Header ("Projects!" + "©2026") */
  .folder-stage-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: clamp(1.75rem, 4vw, 3rem);
    padding: 0 0.5rem;
  }

  .folder-greeting {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 4.75rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 0.95;
    color: var(--text-accent-soft);
    position: relative;
    text-shadow: 0 12px 24px rgba(0, 0, 0, 0.45);
  }

  .greeting-bang {
    color: var(--text-primary);
  }

  .folder-year {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--text-primary);
  }

  /* Stacked Folders */
  .folder-stack {
    position: relative;
    display: flex;
    flex-direction: column;
    margin-top: 0.5rem;
  }

  .folder-layer {
    position: relative;
    display: block;
    text-decoration: none;
    height: 54px;
    margin-bottom: -14px;
    transition: transform 200ms cubic-bezier(0.16, 1, 0.3, 1), filter 200ms ease;
    z-index: calc(1 + var(--layer-idx, 0));
  }

  .folder-layer:hover,
  .folder-layer:focus-visible {
    transform: translateY(-10px);
    outline: none;
  }

  .folder-tab {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 36px;
    padding: 0 22px;
    border-radius: 12px 12px 0 0;
    font-family: var(--font-mono);
    font-size: clamp(0.625rem, 1.1vw, 0.78rem);
    font-weight: 600;
    letter-spacing: 0.06em;
    white-space: nowrap;
    box-shadow: 0 -4px 14px rgba(0, 0, 0, 0.28);
  }

  .folder-sheet {
    display: block;
    width: 100%;
    height: 32px;
    border-radius: 10px 10px 0 0;
    margin-top: -1px;
    box-shadow: 0 -6px 18px rgba(0, 0, 0, 0.35);
  }

  /* Light Folder Variant */
  .folder-layer.is-light .folder-tab,
  .folder-layer.is-light .folder-sheet {
    background-color: var(--folder-light);
    color: var(--folder-light-text);
  }

  /* Dark Folder Variant */
  .folder-layer.is-dark .folder-tab,
  .folder-layer.is-dark .folder-sheet {
    background-color: var(--folder-dark);
    color: var(--text-primary);
    border-top: 1px solid var(--folder-dark-border);
  }

  .folder-layer:hover .tab-label {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Staggered Tab Horizontal Positions */
  .folder-layer.pos-right .folder-tab {
    margin-left: 58%;
  }

  .folder-layer.pos-mid-left .folder-tab {
    margin-left: 26%;
  }

  .folder-layer.pos-far-left .folder-tab {
    margin-left: 3%;
  }

  .folder-layer.pos-mid-right .folder-tab {
    margin-left: 38%;
  }

  /* Front-Most Cover Folder */
  .folder-front-cover {
    position: relative;
    z-index: 10;
    display: block;
    text-decoration: none;
    margin-top: 6px;
    transition: transform 200ms ease;
  }

  .folder-front-cover .front-tab {
    background-color: var(--folder-front);
    color: var(--text-accent-soft);
    border-top: 1px solid var(--border-hairline-bright);
    border-left: 1px solid var(--border-hairline-bright);
    border-right: 1px solid var(--border-hairline-bright);
    margin-left: 2%;
  }

  .front-cover-body {
    position: relative;
    background-color: var(--folder-front);
    border-top: 1px solid var(--border-hairline-bright);
    border-left: 1px solid var(--border-hairline);
    border-right: 1px solid var(--border-hairline);
    border-radius: 0 14px 0 0;
    padding: clamp(1.75rem, 4vw, 2.75rem);
    min-height: 280px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    box-shadow: 0 -12px 32px rgba(0, 0, 0, 0.55);
  }

  .front-top-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: var(--space-l);
  }

  /* 4-Diamond Emblem */
  .diamond-emblem {
    display: grid;
    grid-template-columns: repeat(2, 12px);
    gap: 5px;
    transform: rotate(45deg);
    margin: 6px 0 0 8px;
  }

  .diamond-emblem span {
    width: 12px;
    height: 12px;
    border-radius: 3px;
    background-color: var(--text-accent-soft);
  }

  .diamond-emblem span:first-child {
    background-color: var(--text-accent);
  }

  .front-vol-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: var(--text-primary);
    line-height: 1.45;
  }

  .front-title-area {
    position: relative;
    z-index: 2;
    margin: var(--space-m) 0 var(--space-xl);
  }

  .front-display-title {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 7vw, 5.25rem);
    font-weight: 700;
    line-height: 0.96;
    letter-spacing: -0.045em;
    color: var(--text-accent-soft);
    margin-bottom: var(--space-s);
  }

  .front-tagline {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    max-width: 48ch;
    line-height: 1.5;
  }

  .front-watermark {
    position: absolute;
    right: -10px;
    bottom: -48px;
    font-family: var(--font-display);
    font-size: clamp(5rem, 14vw, 10rem);
    font-weight: 700;
    letter-spacing: -0.05em;
    color: var(--text-primary);
    opacity: 0.035;
    pointer-events: none;
    user-select: none;
    line-height: 1;
  }

  .front-bottom-row {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    padding-top: var(--space-m);
  }

  .front-teqniqks-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 10px;
    background-color: var(--bg-canvas);
    border: 1px solid var(--border-hairline-bright);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--text-primary);
    letter-spacing: 0.08em;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    background-color: var(--text-accent);
  }

  .front-contact-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    line-height: 1.4;
  }

  .contact-kicker {
    color: var(--text-muted);
  }

  .contact-val {
    color: var(--text-primary);
    font-weight: 600;
  }

  @media (max-width: 720px) {
    .folder-layer {
      height: 48px;
      margin-bottom: -12px;
    }

    .folder-layer.pos-right .folder-tab { margin-left: 34%; }
    .folder-layer.pos-mid-left .folder-tab { margin-left: 14%; }
    .folder-layer.pos-far-left .folder-tab { margin-left: 2%; }
    .folder-layer.pos-mid-right .folder-tab { margin-left: 22%; }

    .folder-tab {
      padding: 0 12px;
      font-size: 0.6rem;
    }
  }
</style>
