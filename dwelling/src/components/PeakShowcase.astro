---
import { siteConfig } from '../config/site';

const demos = siteConfig.demos;
---

<section class="peak-section" id="work" aria-labelledby="peak-heading">
  <div class="peak-header">
    <h2 id="peak-heading" class="peak-title">Selected Work & Open Tooling</h2>
    <p class="peak-lead">
      Real software in production. Zero synthetic bloat, zero tracking cookies, sub-second performance.
    </p>
  </div>

  <div class="demos-grid">
    <!-- 01: Battery Telemetry -->
    <article class="demo-card" aria-labelledby="demo-title-battery">
      <div class="demo-browser-frame">
        <div class="browser-chrome">
          <div class="traffic-dots" aria-hidden="true">
            <span></span><span></span><span></span>
          </div>
          <div class="browser-address">battery.nipun.is-a.dev</div>
          <span class="live-indicator">LIVE</span>
        </div>
        <div class="browser-canvas">
          <div class="battery-demo-screen">
            <div class="battery-visual-shell">
              <div class="battery-gauge">
                <div class="battery-level-fill" style="width: 84%;"></div>
              </div>
              <div class="battery-metric-readout">
                <div class="metric-row">
                  <span class="metric-label">STATUS</span>
                  <span class="metric-data-val">DISCHARGING</span>
                </div>
                <div class="metric-row">
                  <span class="metric-label">REMAINING</span>
                  <span class="metric-data-val">84% / 4h 12m</span>
                </div>
                <div class="metric-row">
                  <span class="metric-label">CYCLE RATE</span>
                  <span class="metric-data-val">12.8W (-0.3%/min)</span>
                </div>
              </div>
            </div>
            <div class="telemetry-sparkline" aria-hidden="true">
              <span class="spark-bar" style="height: 40%"></span>
              <span class="spark-bar" style="height: 65%"></span>
              <span class="spark-bar" style="height: 55%"></span>
              <span class="spark-bar" style="height: 80%"></span>
              <span class="spark-bar" style="height: 70%"></span>
              <span class="spark-bar" style="height: 90%"></span>
              <span class="spark-bar" style="height: 84%"></span>
            </div>
          </div>
        </div>
      </div>

      <div class="demo-info">
        <div class="demo-meta-row">
          <span class="demo-category">HARDWARE UTILITY</span>
          <span class="demo-status-pill">Production</span>
        </div>
        <h3 id="demo-title-battery" class="demo-name">Battery Telemetry</h3>
        <p class="demo-brief">
          High-precision browser battery diagnostics via Navigator Battery API with zero server telemetry.
        </p>
        <div class="demo-tags">
          <span>Vanilla JS</span>
          <span>Web Battery API</span>
          <span>Zero Server Calls</span>
        </div>
        <div class="demo-cta-row">
          <a href="https://battery.nipun.is-a.dev/" target="_blank" rel="noopener noreferrer" class="btn-demo-primary">
            Launch Live Utility
          </a>
          <a href="/work/battery-telemetry" class="btn-demo-subtle">
            Case Details
          </a>
        </div>
      </div>
    </article>

    <!-- 02: Theme Changer -->
    <article class="demo-card" aria-labelledby="demo-title-theme">
      <div class="demo-browser-frame">
        <div class="browser-chrome">
          <div class="traffic-dots" aria-hidden="true">
            <span></span><span></span><span></span>
          </div>
          <div class="browser-address">pramudithan.github.io/theme.changer</div>
          <span class="live-indicator">LIVE</span>
        </div>
        <div class="browser-canvas">
          <div class="theme-demo-screen">
            <div class="theme-swatch-cluster">
              <div class="swatch-card active-swatch">
                <span class="swatch-color color-timber"></span>
                <span class="swatch-name">Timber #7B542F</span>
              </div>
              <div class="swatch-card">
                <span class="swatch-color color-amber"></span>
                <span class="swatch-name">Amber #FF9D00</span>
              </div>
              <div class="swatch-card">
                <span class="swatch-color color-espresso"></span>
                <span class="swatch-name">Espresso #0C0704</span>
              </div>
            </div>
            <div class="theme-token-snippet">
              <code>:root &#123; --surface: var(--timber); --contrast: 14.2:1; &#125;</code>
            </div>
          </div>
        </div>
      </div>

      <div class="demo-info">
        <div class="demo-meta-row">
          <span class="demo-category">DEVELOPER TOOL</span>
          <span class="demo-status-pill">Production</span>
        </div>
        <h3 id="demo-title-theme" class="demo-name">Theme Changer Extension</h3>
        <p class="demo-brief">
          Instant client-side CSS variable runtime for instant palette swaps and WCAG AA verification.
        </p>
        <div class="demo-tags">
          <span>CSS Custom Properties</span>
          <span>Web Extensions</span>
          <span>Contrast Checker</span>
        </div>
        <div class="demo-cta-row">
          <a href="https://pramudithan.github.io/theme.changer/" target="_blank" rel="noopener noreferrer" class="btn-demo-primary">
            Launch Live Tool
          </a>
          <a href="/work/theme-changer" class="btn-demo-subtle">
            Case Details
          </a>
        </div>
      </div>
    </article>

    <!-- 03: ByteSift -->
    <article class="demo-card" aria-labelledby="demo-title-bytesift">
      <div class="demo-browser-frame">
        <div class="browser-chrome">
          <div class="traffic-dots" aria-hidden="true">
            <span></span><span></span><span></span>
          </div>
          <div class="browser-address">pramudithan.github.io/bytesift</div>
          <span class="live-indicator">LIVE</span>
        </div>
        <div class="browser-canvas">
          <div class="bytesift-demo-screen">
            <div class="hex-grid-table">
              <div class="hex-row">
                <span class="hex-offset">00000000:</span>
                <span class="hex-bytes">4a50 334e 2054 6563</span>
                <span class="hex-ascii">JP3N Tec</span>
              </div>
              <div class="hex-row">
                <span class="hex-offset">00000008:</span>
                <span class="hex-bytes">6820 4477 656c 6c69</span>
                <span class="hex-ascii">h Dwelli</span>
              </div>
              <div class="hex-row">
                <span class="hex-offset">00000010:</span>
                <span class="hex-bytes">6e67 2032 3032 3600</span>
                <span class="hex-ascii">ng 2026.</span>
              </div>
            </div>
            <div class="bytesift-status-bar">
              <span>BUFF: 4.8MB</span>
              <span>FILTER: 0.12ms</span>
              <span>ZERO TRACKING</span>
            </div>
          </div>
        </div>
      </div>

      <div class="demo-info">
        <div class="demo-meta-row">
          <span class="demo-category">BINARY ENGINE</span>
          <span class="demo-status-pill">Production</span>
        </div>
        <h3 id="demo-title-bytesift" class="demo-name">ByteSift Inspector</h3>
        <p class="demo-brief">
          In-browser binary, hex, and byte array inspection tool with zero server uploads or data retention.
        </p>
        <div class="demo-tags">
          <span>ArrayBuffer</span>
          <span>Web Streams</span>
          <span>Client-Only</span>
        </div>
        <div class="demo-cta-row">
          <a href="https://pramudithan.github.io/bytesift" target="_blank" rel="noopener noreferrer" class="btn-demo-primary">
            Launch Live Inspector
          </a>
          <a href="/work/bytesift" class="btn-demo-subtle">
            Case Details
          </a>
        </div>
      </div>
    </article>

    <!-- 04: Meri Clothing -->
    <article class="demo-card" aria-labelledby="demo-title-meri">
      <div class="demo-browser-frame">
        <div class="browser-chrome">
          <div class="traffic-dots" aria-hidden="true">
            <span></span><span></span><span></span>
          </div>
          <div class="browser-address">github.com/PramudithaN/meri.clothing</div>
          <span class="repo-indicator">SOURCE REPO</span>
        </div>
        <div class="browser-canvas">
          <div class="meri-demo-screen">
            <div class="meri-lookbook-strip">
              <div class="meri-card">
                <div class="meri-item-box">
                  <span class="item-tag">COLLECTION 2026</span>
                  <span class="item-title">Oversized Linen Tunic</span>
                  <span class="item-price">LKR 8,400</span>
                </div>
              </div>
            </div>
            <div class="meri-specs-bar">
              <span>ASTRO SSG</span>
              <span>LCP &lt; 0.8S</span>
              <span>ZERO JS HYDRATION</span>
            </div>
          </div>
        </div>
      </div>

      <div class="demo-info">
        <div class="demo-meta-row">
          <span class="demo-category">COMMERCE PLATFORM</span>
          <span class="demo-status-pill">Source Code</span>
        </div>
        <h3 id="demo-title-meri" class="demo-name">Meri Clothing Architecture</h3>
        <p class="demo-brief">
          High-performance modular e-commerce storefront engineered for sub-second paint on 3G connections.
        </p>
        <div class="demo-tags">
          <span>Astro 5</span>
          <span>Edge Hosting</span>
          <span>Micro-Commerce</span>
        </div>
        <div class="demo-cta-row">
          <a href="https://github.com/PramudithaN/meri.clothing" target="_blank" rel="noopener noreferrer" class="btn-demo-primary">
            Inspect Repository
          </a>
          <a href="/work/meri-clothing" class="btn-demo-subtle">
            Case Details
          </a>
        </div>
      </div>
    </article>
  </div>
</section>

<style>
  .peak-section {
    padding: var(--space-3xl) 0 var(--space-4xl);
    border-bottom: 2px solid var(--border-timber);
  }

  .peak-header {
    margin-bottom: var(--space-2xl);
  }

  .peak-title {
    font-size: var(--step-4);
    color: var(--color-raw-parchment);
    margin-bottom: var(--space-xs);
  }

  .peak-lead {
    font-size: var(--step-0);
    color: var(--text-secondary);
    max-width: 55ch;
  }

  /* --- Grid of 4 Demos --- */
  .demos-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-xl);
  }

  .demo-card {
    background-color: var(--surface-elevated);
    border: 2px solid var(--border-timber);
    box-shadow: var(--shadow-flat);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: transform 150ms ease, border-color 150ms ease;
  }

  .demo-card:hover {
    border-color: var(--color-raw-amber-sand);
    transform: translateY(-2px);
  }

  /* --- Browser Frame Mockup --- */
  .demo-browser-frame {
    background-color: #070402;
    border-bottom: 2px solid var(--border-timber);
  }

  .browser-chrome {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    padding: 10px 14px;
    background-color: #0E0805;
    border-bottom: 1px solid rgba(250, 246, 238, 0.08);
  }

  .traffic-dots {
    display: flex;
    gap: 6px;
  }

  .traffic-dots span {
    width: 8px;
    height: 8px;
    display: inline-block;
  }

  .traffic-dots span:nth-child(1) { background-color: var(--color-raw-timber); }
  .traffic-dots span:nth-child(2) { background-color: var(--color-raw-ochre); }
  .traffic-dots span:nth-child(3) { background-color: var(--color-raw-amber-vivid); }

  .browser-address {
    flex-grow: 1;
    background-color: #050201;
    border: 1px solid var(--border-timber);
    padding: 3px 10px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-raw-ash);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .live-indicator, .repo-indicator {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    padding: 2px 6px;
  }

  .live-indicator {
    background-color: #003816;
    color: #4ADE80;
    border: 1px solid #166534;
  }

  .repo-indicator {
    background-color: #2D1A0A;
    color: var(--color-raw-amber-sand);
    border: 1px solid var(--color-raw-timber);
  }

  /* --- Browser Canvas & Mini Demos --- */
  .browser-canvas {
    padding: var(--space-l);
    background-color: #090503;
    min-height: 140px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Battery Demo Screen */
  .battery-demo-screen {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
  }

  .battery-visual-shell {
    display: flex;
    align-items: center;
    gap: var(--space-m);
  }

  .battery-gauge {
    flex-shrink: 0;
    width: 90px;
    height: 38px;
    border: 2px solid var(--color-raw-amber-sand);
    padding: 3px;
    position: relative;
    background-color: #000;
  }

  .battery-gauge::after {
    content: '';
    position: absolute;
    right: -6px;
    top: 10px;
    width: 4px;
    height: 14px;
    background-color: var(--color-raw-amber-sand);
  }

  .battery-level-fill {
    height: 100%;
    background-color: var(--color-raw-amber-vivid);
  }

  .battery-metric-readout {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex-grow: 1;
  }

  .metric-row {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .metric-label {
    color: var(--color-raw-ash);
  }

  .metric-data-val {
    color: var(--color-raw-parchment);
    font-weight: 600;
  }

  .telemetry-sparkline {
    display: flex;
    align-items: flex-end;
    gap: 4px;
    height: 24px;
    border-bottom: 1px dashed var(--border-timber);
    padding-bottom: 2px;
  }

  .spark-bar {
    flex-grow: 1;
    background-color: var(--color-raw-timber);
  }

  .spark-bar:last-child {
    background-color: var(--color-raw-amber-vivid);
  }

  /* Theme Demo Screen */
  .theme-demo-screen {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
  }

  .theme-swatch-cluster {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-s);
  }

  .swatch-card {
    background-color: #0E0704;
    border: 1px solid var(--border-timber);
    padding: 6px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .swatch-card.active-swatch {
    border-color: var(--color-raw-amber-vivid);
  }

  .swatch-color {
    height: 20px;
    display: block;
  }

  .color-timber { background-color: #7B542F; }
  .color-amber { background-color: #FF9D00; }
  .color-espresso { background-color: #1A0D06; border: 1px solid #7B542F; }

  .swatch-name {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--color-raw-ash);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .theme-token-snippet {
    background-color: #050201;
    border: 1px solid var(--border-timber);
    padding: 4px 8px;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-raw-amber-sand);
  }

  /* ByteSift Demo Screen */
  .bytesift-demo-screen {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }

  .hex-grid-table {
    background-color: #050201;
    border: 1px solid var(--border-timber);
    padding: 8px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .hex-row {
    display: grid;
    grid-template-columns: 80px 1fr 70px;
    gap: 8px;
  }

  .hex-offset { color: var(--color-raw-ochre); }
  .hex-bytes { color: var(--color-raw-amber-sand); }
  .hex-ascii { color: var(--color-raw-parchment); }

  .bytesift-status-bar {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-raw-ash);
    border-top: 1px dashed var(--border-timber);
    padding-top: 4px;
  }

  /* Meri Demo Screen */
  .meri-demo-screen {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }

  .meri-lookbook-strip {
    background-color: #120A05;
    border: 1px solid var(--border-timber);
    padding: 10px;
  }

  .meri-item-box {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .item-tag {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--color-raw-amber-vivid);
  }

  .item-title {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    color: var(--color-raw-parchment);
    font-weight: 700;
  }

  .item-price {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-raw-amber-sand);
  }

  .meri-specs-bar {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-raw-ash);
    border-top: 1px dashed var(--border-timber);
    padding-top: 4px;
  }

  /* --- Demo Card Info Footer --- */
  .demo-info {
    padding: var(--space-l);
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .demo-meta-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-xs);
  }

  .demo-category {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-raw-ochre);
    font-weight: 600;
    letter-spacing: 0.05em;
  }

  .demo-status-pill {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-raw-ash);
  }

  .demo-name {
    font-size: var(--step-2);
    color: var(--color-raw-parchment);
    margin-bottom: var(--space-xs);
  }

  .demo-brief {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: var(--lh-body);
    margin-bottom: var(--space-m);
    flex-grow: 1;
  }

  .demo-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: var(--space-l);
  }

  .demo-tags span {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    padding: 2px 7px;
    background-color: #0E0704;
    border: 1px solid var(--border-timber);
    color: var(--color-raw-ash);
  }

  .demo-cta-row {
    display: flex;
    gap: var(--space-s);
    flex-wrap: wrap;
  }

  .btn-demo-primary {
    display: inline-flex;
    align-items: center;
    padding: 8px 16px;
    background-color: var(--color-raw-amber-vivid);
    color: #0C0704;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 150ms ease;
  }

  .btn-demo-primary:hover {
    background-color: var(--color-raw-amber-sand);
    color: #0C0704;
  }

  .btn-demo-subtle {
    display: inline-flex;
    align-items: center;
    padding: 8px 16px;
    background-color: transparent;
    border: 1px solid var(--border-timber);
    color: var(--color-raw-amber-sand);
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    text-decoration: none;
    transition: border-color 150ms ease, color 150ms ease;
  }

  .btn-demo-subtle:hover {
    border-color: var(--color-raw-amber-vivid);
    color: var(--color-raw-amber-vivid);
  }

  @media (max-width: 900px) {
    .demos-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
