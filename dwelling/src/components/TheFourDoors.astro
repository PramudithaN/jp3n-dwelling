---
import { siteConfig } from '../config/site';

const { email, github, linkedin } = siteConfig.contact;
---

<section class="doors-section" id="contact-doors" aria-labelledby="doors-heading">
  <div class="doors-header">
    <h2 id="doors-heading" class="doors-title">Direct Engagement</h2>
    <p class="doors-lead">
      No sales intermediaries, no automated bots, and zero tracking cookies. Direct conversation with engineers.
    </p>
  </div>

  <div class="doors-grid">
    <!-- Channel 1: Client Projects -->
    <article class="door-card">
      <div class="door-badge">CLIENTS</div>
      <h3 class="door-name">Project Inquiries</h3>
      <p class="door-text">
        High-velocity web platforms, legacy refactors, custom vector brand systems, or technical motion demos.
      </p>
      <div class="door-actions">
        <a 
          href={`mailto:${email}?subject=Project%20Inquiry%20Teqniqks%20Dwelling`} 
          class="door-btn-primary"
        >
          Send Project Brief
        </a>
        <button 
          type="button" 
          class="door-copy-btn" 
          id="copyEmailBtn" 
          data-email={email}
        >
          <span id="copyBtnText">Copy Email</span>
        </button>
      </div>
    </article>

    <!-- Channel 2: Open Source -->
    <article class="door-card">
      <div class="door-badge">DEVELOPERS</div>
      <h3 class="door-name">Open Tooling</h3>
      <p class="door-text">
        Explore public repositories, contribute to active open source utilities, or review our public architectural RFCs.
      </p>
      <div class="door-actions">
        <a href="/contributors" class="door-btn-subtle">
          Contributor Space
        </a>
        <a href={github} target="_blank" rel="noopener noreferrer" class="door-btn-subtle">
          GitHub Org
        </a>
      </div>
    </article>

    <!-- Channel 3: Partnerships -->
    <article class="door-card">
      <div class="door-badge">PARTNERS</div>
      <h3 class="door-name">Technical Alliance</h3>
      <p class="door-text">
        Collaborate on independent infrastructure research, cross-team engineering, or tooling integrations.
      </p>
      <div class="door-actions">
        <a href={linkedin} target="_blank" rel="noopener noreferrer" class="door-btn-subtle">
          LinkedIn Connect
        </a>
      </div>
    </article>

    <!-- Channel 4: Technical Dispatch -->
    <article class="door-card">
      <div class="door-badge">JOURNAL</div>
      <h3 class="door-name">Engineering Dispatch</h3>
      <p class="door-text">
        In-depth architectural breakdowns on zero-cookie privacy, Web APIs, sub-second 4G rendering, and design tokens.
      </p>
      <div class="door-actions">
        <a href="/journal" class="door-btn-subtle">
          Read Journal
        </a>
      </div>
    </article>
  </div>
</section>

<script>
  const copyBtn = document.getElementById('copyEmailBtn');
  const copyText = document.getElementById('copyBtnText');

  if (copyBtn && copyText) {
    copyBtn.addEventListener('click', async () => {
      const email = copyBtn.getAttribute('data-email');
      if (email) {
        try {
          await navigator.clipboard.writeText(email);
          copyText.textContent = 'Email Copied!';
          setTimeout(() => {
            copyText.textContent = 'Copy Email';
          }, 2000);
        } catch {
          window.location.href = `mailto:${email}`;
        }
      }
    });
  }
</script>

<style>
  .doors-section {
    padding: var(--space-3xl) 0 var(--space-4xl);
  }

  .doors-header {
    margin-bottom: var(--space-2xl);
  }

  .doors-title {
    font-size: var(--step-4);
    color: var(--color-raw-parchment);
    margin-bottom: var(--space-xs);
  }

  .doors-lead {
    font-size: var(--step-0);
    color: var(--text-secondary);
    max-width: 55ch;
  }

  .doors-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-l);
  }

  .door-card {
    background-color: var(--surface-elevated);
    border: 2px solid var(--border-timber);
    padding: var(--space-xl);
    box-shadow: var(--shadow-flat);
    display: flex;
    flex-direction: column;
    transition: transform 150ms ease, border-color 150ms ease;
  }

  .door-card:hover {
    border-color: var(--color-raw-amber-sand);
    transform: translateY(-2px);
  }

  .door-badge {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-raw-amber-vivid);
    font-weight: 600;
    margin-bottom: var(--space-xs);
    letter-spacing: 0.05em;
  }

  .door-name {
    font-size: var(--step-2);
    color: var(--color-raw-parchment);
    margin-bottom: var(--space-xs);
  }

  .door-text {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: var(--lh-body);
    margin-bottom: var(--space-l);
    flex-grow: 1;
  }

  .door-actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }

  .door-btn-primary {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 10px 14px;
    background-color: var(--color-raw-amber-vivid);
    color: #0C0704;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    text-decoration: none;
    text-align: center;
    transition: background-color 150ms ease;
  }

  .door-btn-primary:hover {
    background-color: var(--color-raw-amber-sand);
    color: #0C0704;
  }

  .door-copy-btn, .door-btn-subtle {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 8px 14px;
    background-color: transparent;
    border: 1px solid var(--border-timber);
    color: var(--color-raw-amber-sand);
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    text-align: center;
    transition: border-color 150ms ease, color 150ms ease;
  }

  .door-copy-btn:hover, .door-btn-subtle:hover {
    border-color: var(--color-raw-amber-vivid);
    color: var(--color-raw-amber-vivid);
  }

  @media (max-width: 1024px) {
    .doors-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .doors-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
