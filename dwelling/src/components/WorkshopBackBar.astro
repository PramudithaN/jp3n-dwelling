---
interface Props {
  href?: string;
  label?: string;
}

const { href = '/#workshops', label = 'Back to Workshops' } = Astro.props;
---

<div class="workshop-back-bar">
  <div class="site-container">
    <a href={href} class="workshop-back-link">
      <span class="back-arrow-circle" aria-hidden="true">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12.5 8H3.5" />
          <path d="M7.5 4L3.5 8L7.5 12" />
        </svg>
      </span>
      <span>{label}</span>
    </a>
  </div>
</div>

<style>
  .workshop-back-bar {
    position: relative;
    z-index: 2;
    padding-top: calc(var(--nav-height, 72px) + var(--space-m));
    padding-bottom: var(--space-xs);
  }

  .site-container {
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  .workshop-back-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 14px 6px 6px;
    border-radius: 999px;
    border: 1px solid var(--border-hairline-bright);
    background-color: var(--bg-surface);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--text-primary);
    transition: border-color 160ms ease, background-color 160ms ease, color 160ms ease;
  }

  .back-arrow-circle {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background-color: var(--bg-elevated);
    border: 1px solid var(--border-hairline-bright);
    color: var(--text-accent);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: background-color 160ms ease, color 160ms ease, border-color 160ms ease, transform 160ms ease;
  }

  .workshop-back-link:hover,
  .workshop-back-link:focus-visible {
    border-color: var(--text-accent);
    background-color: var(--bg-elevated);
    color: var(--text-accent);
  }

  .workshop-back-link:hover .back-arrow-circle,
  .workshop-back-link:focus-visible .back-arrow-circle {
    background-color: var(--text-accent);
    border-color: var(--text-accent);
    color: var(--bg-canvas);
    transform: translateX(-2px);
  }
</style>
