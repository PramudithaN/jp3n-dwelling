---
interface WorkshopCol {
  num: string;
  headline: string;
  pill: string;
  lines: string[];
  href: string;
  image: string;
  alt: string;
}

const workshops: WorkshopCol[] = [
  {
    num: '01',
    headline: 'Websites',
    pill: 'WEB LABORATORY',
    lines: ['Custom websites & web apps', 'Fast on every screen', 'Built how you want it'],
    href: '/process',
    image: '/images/workshops/web-lab.jpg',
    alt: 'Web Laboratory — minimalist engineering monitor and dark workspace'
  },
  {
    num: '02',
    headline: 'Graphic Design',
    pill: 'GRAPHICS STUDIO',
    lines: ['Logos & brand identity', 'Posters & visual kits', 'Clean colors & typography'],
    href: '/themes',
    image: '/images/workshops/graphics-studio.jpg',
    alt: 'Graphics Studio — monochrome brutalist architectural geometry'
  },
  {
    num: '03',
    headline: 'Videos & Motion',
    pill: 'MOTION BAY',
    lines: ['Product & promo videos', 'Social reels & video editing', 'Smooth motion graphics'],
    href: '/motion',
    image: '/images/workshops/motion-bay.jpg',
    alt: 'Motion Bay — dark studio cinema camera and lighting rig'
  },
  {
    num: '04',
    headline: 'Contribute',
    pill: 'OPEN FORGE',
    lines: ['Open-source repositories', 'Easy starter issues', 'Build & learn with us'],
    href: '/contributors',
    image: '/images/workshops/open-forge.jpg',
    alt: 'Open Forge — precision engineering tools and hardware craft'
  }
];
---

<div class="swiss-workshops">
  <!-- Top Accent Ribbon Bar -->
  <div class="swiss-topbar">
    <span class="topbar-brand">
      <span class="brand-chevron" aria-hidden="true">▸</span>
      JP3N WORKSHOPS
    </span>

    <nav class="topbar-links" aria-label="Workshop shortcuts">
      {workshops.map((w) => (
        <a href={w.href} class="topbar-link">{w.pill}</a>
      ))}
    </nav>

    <div class="topbar-actions">
      <span class="topbar-chip">04 Craft Bays</span>
      <a href="/#contact" class="topbar-chip is-cta">Start Inquiry →</a>
    </div>
  </div>

  <!-- 4-Column Numbered Vertical Grid -->
  <div class="swiss-columns">
    {workshops.map((w) => (
      <a href={w.href} class="swiss-col">
        <!-- High-res WebP photo revealed instantaneously on hover/focus -->
        <div class="col-backdrop" aria-hidden="true">
          <img
            src={w.image}
            alt=""
            class="col-bg-img"
            loading="eager"
            decoding="async"
          />
          <div class="col-bg-scrim"></div>
        </div>

        <!-- Subtle Index + Big Clear Headline -->
        <div class="col-numeral-wrap">
          <span class="col-index">{w.num}</span>
          <span class="col-headline">{w.headline}</span>
        </div>

        <!-- Pill Category Tag -->
        <div class="col-pill-row">
          <span class="col-pill">{w.pill}</span>
        </div>

        <!-- Bottom Craft Lines + Arrow Circle -->
        <div class="col-bottom-row">
          <ul class="col-lines">
            {w.lines.map((line) => (
              <li>{line}</li>
            ))}
          </ul>
          <span class="col-arrow-circle" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3.5 8H12.5" />
              <path d="M8.5 4L12.5 8L8.5 12" />
            </svg>
          </span>
        </div>
      </a>
    ))}
  </div>
</div>

<style>
  .swiss-workshops {
    width: 100%;
    border: 1px solid var(--border-hairline-bright);
    background-color: var(--bg-surface);
    overflow: hidden;
  }

  /* Top Accent Bar */
  .swiss-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    padding: 10px 18px;
    background-color: var(--text-accent);
    color: var(--bg-canvas);
  }

  .topbar-brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    background-color: var(--bg-canvas);
    color: var(--text-primary);
    border-radius: 6px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .brand-chevron {
    color: var(--text-accent);
  }

  .topbar-links {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
  }

  .topbar-link {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--bg-canvas);
    text-decoration: none;
    opacity: 0.85;
    transition: opacity 150ms ease;
  }

  .topbar-link:hover {
    opacity: 1;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .topbar-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .topbar-chip {
    padding: 5px 12px;
    border: 1px solid rgba(9, 16, 11, 0.35);
    border-radius: 5px;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--bg-canvas);
    text-decoration: none;
  }

  .topbar-chip.is-cta:hover {
    background-color: var(--bg-canvas);
    color: var(--text-primary);
  }

  /* 4-Column Numbered Grid */
  .swiss-columns {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .swiss-col {
    position: relative;
    min-height: 440px;
    padding: var(--space-xl) var(--space-l) var(--space-l);
    border-right: 1px solid var(--border-hairline);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    text-decoration: none;
    overflow: hidden;
    transition: background-color 200ms ease;
  }

  .swiss-col:last-child {
    border-right: none;
  }

  .col-backdrop {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 260ms cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .col-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%) contrast(1.18) brightness(0.55);
    transform: scale(1.04);
    transition: transform 420ms cubic-bezier(0.16, 1, 0.3, 1);
    display: block;
  }

  .col-bg-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(9, 16, 11, 0.35) 0%,
      rgba(9, 16, 11, 0.25) 45%,
      rgba(9, 16, 11, 0.85) 100%
    );
  }

  .swiss-col:hover,
  .swiss-col:focus-visible {
    background-color: var(--bg-elevated);
  }

  .swiss-col:hover .col-backdrop,
  .swiss-col:focus-visible .col-backdrop {
    opacity: 1;
  }

  .swiss-col:hover .col-bg-img,
  .swiss-col:focus-visible .col-bg-img {
    transform: scale(1);
  }

  /* Big Clear Headline */
  .col-numeral-wrap {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 12px;
    flex-grow: 1;
    padding: var(--space-l) 0;
  }

  .col-index {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--text-accent);
    opacity: 0.85;
  }

  .col-headline {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 3.4vw, 3.25rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    transition: color 200ms ease, transform 220ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .swiss-col:hover .col-headline {
    color: var(--text-accent);
    transform: translateY(-4px);
  }

  /* Pill Tag */
  .col-pill-row {
    position: relative;
    z-index: 1;
    margin-bottom: var(--space-l);
  }

  .col-pill {
    display: inline-block;
    padding: 4px 12px;
    border-radius: 999px;
    border: 1px solid var(--border-hairline-bright);
    background: color-mix(in srgb, var(--bg-canvas) 70%, transparent);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--text-primary);
  }

  .swiss-col:hover .col-pill {
    border-color: var(--text-accent);
    color: var(--text-accent);
  }

  /* Bottom Lines + Arrow */
  .col-bottom-row {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
  }

  .col-lines {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    color: var(--text-secondary);
    line-height: 1.35;
  }

  .col-arrow-circle {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background-color: var(--text-primary);
    color: var(--bg-canvas);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    font-weight: 700;
    flex-shrink: 0;
    transition: background-color 150ms ease, transform 150ms ease;
  }

  .swiss-col:hover .col-arrow-circle {
    background-color: var(--text-accent);
    transform: translateX(2px);
  }

  @media (max-width: 1024px) {
    .swiss-columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .swiss-col {
      min-height: 340px;
      border-bottom: 1px solid var(--border-hairline);
    }

    .topbar-links {
      display: none;
    }
  }

  @media (max-width: 580px) {
    .swiss-columns {
      grid-template-columns: 1fr;
    }

    .swiss-col {
      min-height: 280px;
      border-right: none;
    }
  }
</style>
