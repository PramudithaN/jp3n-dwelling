---
interface Workshop {
  num: string;
  title: string;
  desc: string;
  specs: string[];
  deliverable: string;
  href: string;
}

const workshops: Workshop[] = [
  {
    num: '01',
    title: 'Web Laboratory',
    desc: 'Astro SSG platforms, TypeScript architectures, zero framework bloat, and sub-second 4G paint.',
    specs: ['Static HTML', 'TypeScript', 'Zero JS Hydration'],
    deliverable: 'LCP < 0.8s · Strict CSP',
    href: '/process'
  },
  {
    num: '02',
    title: 'Graphics Studio',
    desc: 'Tactile visual identities, publication typography, and design token systems with verified WCAG AA contrast.',
    specs: ['Flat Color Systems', 'Vector Identity', 'Print & Digital'],
    deliverable: 'WCAG AA · Token Runtime',
    href: '/themes'
  },
  {
    num: '03',
    title: 'Motion Bay',
    desc: 'Product walkthroughs and interactive video narratives. Every asset compressed under 1.5MB with zero audio autoplay.',
    specs: ['Under 1.5MB Loops', 'Product Walkthroughs', 'Zero Audio Autoplay'],
    deliverable: '60fps · Hardware Decoded',
    href: '/work'
  },
  {
    num: '04',
    title: 'Open Forge',
    desc: 'Community developer tools and open software utilities. Open source codebases with curated Good First Issues.',
    specs: ['MIT & OFL', 'Public RFCs', 'Welcoming Repos'],
    deliverable: 'Client-Only · Zero Telemetry',
    href: '/contributors'
  }
];
---

<div class="workshop-folders-grid">
  {workshops.map((w) => (
    <a href={w.href} class="workshop-folder-card">
      <!-- Sloped-tab Folder Silhouette SVG (theme-matched) -->
      <svg
        class="folder-bg-svg"
        viewBox="0 0 420 290"
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <path
          class="folder-bg-path"
          d="M 22 24
             L 172 24
             C 182 24, 188 22, 195 16
             L 210 6
             C 216 2, 222 1, 232 1
             L 398 1
             C 410 1, 419 10, 419 22
             L 419 268
             C 419 280, 410 289, 398 289
             L 22 289
             C 10 289, 1 280, 1 268
             L 1 45
             C 1 33, 10 24, 22 24 Z"
        />
      </svg>

      <div class="folder-inner">
        <div class="folder-top-bar">
          <span class="folder-num">{w.num}</span>
          <span class="folder-arrow" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
              <path
                d="M7 17L17 7M17 7H8M17 7V16"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </span>
        </div>

        <div class="folder-body">
          <h3 class="folder-title">{w.title}</h3>
          <p class="folder-desc">{w.desc}</p>
        </div>

        <div class="folder-footer">
          <div class="folder-specs">
            {w.specs.map((spec) => (
              <span class="folder-spec-pill">{spec}</span>
            ))}
          </div>
          <span class="folder-deliverable">{w.deliverable}</span>
        </div>
      </div>
    </a>
  ))}
</div>

<style>
  .workshop-folders-grid {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.25rem, 2.2vw, 2rem);
  }

  .workshop-folder-card {
    position: relative;
    display: block;
    text-decoration: none;
    min-height: 280px;
    padding: clamp(1.5rem, 2.5vw, 2rem);
    transition: transform 200ms cubic-bezier(0.16, 1, 0.3, 1);
    filter: drop-shadow(0 18px 28px rgba(0, 0, 0, 0.55));
  }

  .workshop-folder-card:hover {
    transform: translateY(-4px);
  }

  .folder-bg-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }

  .folder-bg-path {
    fill: var(--bg-elevated);
    stroke: var(--border-hairline-bright);
    stroke-width: 1.25;
    vector-effect: non-scaling-stroke;
    transition: fill 180ms ease, stroke 180ms ease;
  }

  .workshop-folder-card:hover .folder-bg-path {
    fill: color-mix(in srgb, var(--bg-elevated) 86%, var(--text-accent) 14%);
    stroke: var(--text-accent);
  }

  .folder-inner {
    position: relative;
    z-index: 1;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-m);
  }

  .folder-top-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 4px;
  }

  .folder-num {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--text-accent);
    padding-top: 12px;
  }

  .folder-arrow {
    color: var(--text-primary);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: transform 180ms ease, color 180ms ease;
    margin-top: -6px;
  }

  .workshop-folder-card:hover .folder-arrow {
    color: var(--text-accent);
    transform: translate(2px, -2px);
  }

  .folder-body {
    flex-grow: 1;
  }

  .folder-title {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2vw, 1.75rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    margin-bottom: 8px;
    line-height: 1.15;
  }

  .folder-desc {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.55;
    max-width: 48ch;
  }

  .folder-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
    padding-top: var(--space-s);
    border-top: 1px dashed var(--border-hairline);
  }

  .folder-specs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .folder-spec-pill {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    padding: 3px 8px;
    background-color: var(--bg-canvas);
    border: 1px solid var(--border-hairline);
    color: var(--text-secondary);
  }

  .folder-deliverable {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-accent-soft);
  }

  @media (max-width: 720px) {
    .workshop-folders-grid {
      grid-template-columns: 1fr;
    }

    .workshop-folder-card {
      min-height: 230px;
      padding: 24px 20px 20px;
    }
  }
</style>
