---
interface Props {
  title: string;
  tagline: string;
  category: string;
  status: string;
  techStack: string[];
  metrics?: Record<string, string>;
  liveUrl?: string;
  repoUrl?: string;
}

const {
  title,
  tagline,
  category,
  status,
  techStack,
  metrics = {},
  liveUrl,
  repoUrl
} = Astro.props;

// Split title so the last word renders inside the inverted accent block (matching Image 1)
const words = title.trim().split(/\s+/);
const leadWords = words.length > 1 ? words.slice(0, -1).join(' ') : '';
const highlightWord = words[words.length - 1] || title;
const metricEntries = Object.entries(metrics);
---

<div class="detail-canvas">
  <div class="detail-canvas-grid">
    <!-- Left Column: Editorial Headline + Selection Frame + Square-Bullet Specs -->
    <div class="detail-main-col">
      <div class="detail-meta-bar">
        <span class="detail-cat">{category}</span>
        <span class="detail-sep">/</span>
        <span class="detail-status">{status}</span>
      </div>

      <h1 class="detail-headline">
        {leadWords && <span class="headline-lead">{leadWords}</span>}
        <span class="headline-block">{highlightWord}</span>
      </h1>

      <!-- Selection Bounding-Box Frame + Vector Cursor -->
      <div class="selection-box">
        <span class="box-handle tl" aria-hidden="true"></span>
        <span class="box-handle tr" aria-hidden="true"></span>
        <span class="box-handle bl" aria-hidden="true"></span>
        <span class="box-handle br" aria-hidden="true"></span>
        <p class="selection-tagline">{tagline}</p>

        <svg class="vector-cursor" width="22" height="24" viewBox="0 0 22 24" fill="none" aria-hidden="true">
          <path
            d="M2 2L9.5 20L12.5 13L19.5 10L2 2Z"
            fill="var(--text-primary)"
            stroke="var(--bg-canvas)"
            stroke-width="1.5"
            stroke-linejoin="round"
          />
          <rect x="15" y="15" width="4" height="4" fill="var(--text-accent)" />
        </svg>
      </div>

      <!-- Square-Bullet Verified Metrics & Deliverables -->
      <ul class="square-specs-list">
        {metricEntries.map(([key, val]) => (
          <li>
            <span class="spec-k">{key}:</span> {val}
          </li>
        ))}
        {techStack.map((tech) => (
          <li>{tech}</li>
        ))}
      </ul>
    </div>

    <!-- Right Column: Coordinate Grid + [T] Type Frame + Dark Inspector Panel -->
    <div class="detail-vector-col">
      <!-- Coordinate Grid with Corner Anchors -->
      <div class="coord-grid-wrap" aria-hidden="true">
        <div class="coord-grid">
          <span class="grid-dot tl"></span>
          <span class="grid-dot tr"></span>
          <span class="grid-dot bl"></span>
          <span class="grid-dot br"></span>
        </div>

        <!-- Type [T] Tool Bounding Frame -->
        <div class="type-tool-frame">
          <span class="box-handle tl"></span>
          <span class="box-handle tr"></span>
          <span class="box-handle bl"></span>
          <span class="box-handle br"></span>
          <span class="type-glyph">T</span>
        </div>
      </div>

      <!-- Floating Dark Inspector Panel (Pathfinder-inspired) -->
      <div class="inspector-panel">
        <div class="inspector-header">
          <span class="inspector-tab">System Inspector</span>
          <span class="inspector-icons" aria-hidden="true">« × ≡</span>
        </div>

        <div class="inspector-body">
          <div class="inspector-section">
            <span class="inspector-label">Stack Modules:</span>
            <div class="inspector-modules">
              {techStack.map((tech, idx) => (
                <div class="module-chip" title={tech}>
                  <span class="module-glyph" aria-hidden="true">0{idx + 1}</span>
                  <span class="module-name">{tech}</span>
                </div>
              ))}
            </div>
          </div>

          <div class="inspector-section">
            <span class="inspector-label">Deployments:</span>
            <div class="inspector-actions">
              {liveUrl && (
                <a href={liveUrl} target="_blank" rel="noopener noreferrer" class="inspector-btn is-primary">
                  Launch Live ↗
                </a>
              )}
              {repoUrl && (
                <a href={repoUrl} target="_blank" rel="noopener noreferrer" class="inspector-btn">
                  Source Repo ↗
                </a>
              )}
              {!liveUrl && !repoUrl && (
                <span class="inspector-btn is-disabled">Internal Staging</span>
              )}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .detail-canvas {
    position: relative;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-hairline);
    padding: clamp(1.75rem, 4vw, 3.25rem);
    margin-bottom: var(--space-3xl);
    overflow: hidden;
  }

  .detail-canvas-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xl);
    align-items: center;
  }

  @media (min-width: 960px) {
    .detail-canvas-grid {
      grid-template-columns: 1.15fr 0.85fr;
      gap: var(--space-3xl);
    }
  }

  /* Left Column */
  .detail-meta-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: var(--space-m);
  }

  .detail-cat {
    color: var(--text-accent-soft);
  }

  .detail-sep {
    color: var(--text-muted);
  }

  .detail-status {
    color: var(--text-accent);
  }

  .detail-headline {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 4.5vw, 3.6rem);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.035em;
    color: var(--text-primary);
    margin-bottom: var(--space-xl);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
  }

  .headline-block {
    display: inline-block;
    background-color: var(--text-accent);
    color: var(--bg-canvas);
    padding: 4px 14px 6px;
    font-weight: 600;
  }

  /* Selection Bounding Box */
  .selection-box {
    position: relative;
    border: 1px solid var(--border-hairline-bright);
    padding: 16px 20px;
    margin-bottom: var(--space-xl);
    max-width: 540px;
    background: color-mix(in srgb, var(--bg-elevated) 55%, transparent);
  }

  .selection-tagline {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 1.5vw, 1.3rem);
    font-weight: 400;
    line-height: 1.4;
    color: var(--text-primary);
    margin: 0;
  }

  .box-handle {
    position: absolute;
    width: 7px;
    height: 7px;
    background-color: var(--bg-canvas);
    border: 1.5px solid var(--text-accent);
    pointer-events: none;
  }

  .box-handle.tl { top: -4px; left: -4px; }
  .box-handle.tr { top: -4px; right: -4px; }
  .box-handle.bl { bottom: -4px; left: -4px; }
  .box-handle.br { bottom: -4px; right: -4px; }

  .vector-cursor {
    position: absolute;
    right: -10px;
    bottom: -16px;
    pointer-events: none;
    filter: drop-shadow(0 3px 6px rgba(0, 0, 0, 0.5));
  }

  /* Square-Bullet Specs List */
  .square-specs-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .square-specs-list li {
    position: relative;
    padding-left: 20px;
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.45;
  }

  .square-specs-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.52em;
    width: 6px;
    height: 6px;
    background-color: var(--text-accent);
  }

  .spec-k {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-primary);
  }

  /* Right Column: Vector Grid + [T] Frame + Dark Inspector Panel */
  .detail-vector-col {
    position: relative;
    min-height: 310px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  .coord-grid-wrap {
    position: relative;
    width: 210px;
    height: 170px;
    margin-left: auto;
    margin-bottom: -48px;
  }

  .coord-grid {
    position: relative;
    width: 100%;
    height: 100%;
    background-image:
      linear-gradient(to right, var(--border-hairline) 1px, transparent 1px),
      linear-gradient(to bottom, var(--border-hairline) 1px, transparent 1px);
    background-size: 26px 26px;
    border-right: 1px solid var(--border-hairline);
    border-bottom: 1px solid var(--border-hairline);
  }

  .grid-dot {
    position: absolute;
    width: 5px;
    height: 5px;
    background-color: var(--text-primary);
  }

  .grid-dot.tl { top: -2px; left: -2px; }
  .grid-dot.tr { top: -2px; right: -3px; }
  .grid-dot.bl { bottom: -3px; left: -2px; }
  .grid-dot.br { bottom: -3px; right: -3px; }

  .type-tool-frame {
    position: absolute;
    top: -22px;
    right: 26px;
    width: 78px;
    height: 78px;
    border: 2px solid var(--text-primary);
    background-color: var(--bg-canvas);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.45);
  }

  .type-glyph {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 2.75rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1;
  }

  /* Floating Dark Inspector Panel */
  .inspector-panel {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 340px;
    background-color: var(--bg-elevated);
    border: 1px solid var(--border-hairline-bright);
    box-shadow: 0 20px 40px -12px rgba(0, 0, 0, 0.75);
  }

  .inspector-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 12px;
    background-color: var(--bg-canvas);
    border-bottom: 1px solid var(--border-hairline);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
  }

  .inspector-tab {
    color: var(--text-primary);
    font-weight: 600;
  }

  .inspector-icons {
    color: var(--text-muted);
    letter-spacing: 0.15em;
  }

  .inspector-body {
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .inspector-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-muted);
    margin-bottom: 8px;
  }

  .inspector-modules {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .module-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 8px;
    background-color: var(--bg-canvas);
    border: 1px solid var(--border-hairline);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-secondary);
  }

  .module-glyph {
    color: var(--text-accent);
    font-weight: 600;
  }

  .inspector-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .inspector-btn {
    padding: 6px 12px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    border: 1px solid var(--border-hairline-bright);
    color: var(--text-primary);
    text-decoration: none;
    background-color: var(--bg-canvas);
    transition: all 150ms ease;
  }

  .inspector-btn:hover {
    border-color: var(--text-accent);
    color: var(--text-accent);
  }

  .inspector-btn.is-primary {
    background-color: var(--text-accent);
    border-color: var(--text-accent);
    color: var(--bg-canvas);
    font-weight: 600;
  }

  .inspector-btn.is-primary:hover {
    opacity: 0.9;
    color: var(--bg-canvas);
  }

  .inspector-btn.is-disabled {
    color: var(--text-muted);
    border-color: var(--border-hairline);
  }

  @media (max-width: 959px) {
    .coord-grid-wrap {
      display: none;
    }

    .inspector-panel {
      max-width: 100%;
    }

    .detail-vector-col {
      min-height: auto;
    }
  }
</style>
