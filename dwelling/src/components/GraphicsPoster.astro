---
import { siteConfig } from '../config/site';

const { email } = siteConfig.contact;
---

<section class="graphics-poster-wrap" aria-label="JP3N Graphics Studio Showcase">
  <div class="graphics-poster">
    <!-- Top Giant Display Word -->
    <div class="poster-top">
      <h2 class="poster-giant-word" aria-label="Graphic">
        Graph<span class="giant-i">i</span>c
      </h2>
      <p class="poster-sub-hook">
        That get you<br />noticed!
      </p>
    </div>

    <!-- Central Sculpted Hand & Forearm SVG (Rising from bottom center) -->
    <div class="poster-hand-layer" aria-hidden="true">
      <svg class="hand-svg" viewBox="0 0 360 560" fill="none" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="armLighting" x1="0%" y1="15%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#050806" />
            <stop offset="45%" stop-color="color-mix(in srgb, var(--bg-elevated) 72%, var(--text-accent-soft) 28%)" />
            <stop offset="82%" stop-color="color-mix(in srgb, var(--text-accent-soft) 65%, var(--text-primary) 35%)" />
            <stop offset="100%" stop-color="var(--text-primary)" />
          </linearGradient>
          <linearGradient id="palmShadow" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="rgba(0,0,0,0.65)" />
            <stop offset="100%" stop-color="rgba(0,0,0,0)" />
          </linearGradient>
        </defs>

        <!-- Forearm & Wrist -->
        <path
          d="M126 560
             L146 345
             C144 316, 134 294, 128 272
             C122 252, 118 234, 126 220
             L138 202
             L216 208
             C220 238, 220 278, 224 328
             L248 560 Z"
          fill="url(#armLighting)"
        />

        <!-- Left Curled Fingers (Middle & Ring reaching left over Posters ribbon) -->
        <path
          d="M154 152
             C136 138, 102 136, 80 144
             C68 148, 64 158, 72 165
             C82 172, 106 164, 128 168
             C138 170, 146 178, 152 188 Z"
          fill="url(#armLighting)"
        />
        <path
          d="M148 182
             C124 180, 96 184, 82 194
             C76 198, 78 206, 88 208
             C104 210, 126 202, 144 204 Z"
          fill="url(#armLighting)"
          opacity="0.88"
        />

        <!-- Palm & Knuckles Mass -->
        <path
          d="M134 214
             C134 182, 148 152, 168 144
             C188 136, 214 148, 220 176
             C224 198, 222 228, 218 258
             C202 276, 162 278, 142 254 Z"
          fill="url(#armLighting)"
        />

        <!-- Raised Index Finger pointing up -->
        <path
          d="M180 156
             L188 54
             C190 36, 194 24, 202 22
             C210 20, 216 28, 216 44
             L212 162 Z"
          fill="url(#armLighting)"
        />

        <!-- Thumb curving upward -->
        <path
          d="M142 254
             C126 238, 114 214, 112 196
             C110 182, 120 174, 132 180
             C144 186, 154 206, 164 226
             C170 238, 174 252, 168 264 Z"
          fill="url(#armLighting)"
        />

        <!-- Deep Palm Shading & Rim Contour -->
        <path
          d="M148 210 C164 202, 184 208, 194 224 M156 174 C170 170, 184 174, 194 182"
          stroke="rgba(0,0,0,0.5)"
          stroke-width="2.5"
          stroke-linecap="round"
        />
      </svg>
    </div>

    <!-- Weaving Typography Ribbons -->
    <div class="ribbons-stage" aria-hidden="true">
      <div class="ribbon r-1">
        <span>Posters</span><span class="r-dot">•</span>
        <span>Posters</span><span class="r-dot">•</span>
        <span>Posters</span><span class="r-dot">•</span>
        <span>Posters</span><span class="r-dot">•</span>
        <span>Posters</span>
      </div>

      <div class="ribbon r-2 is-behind">
        <span>Social Media</span><span class="r-dot">•</span>
        <span>Social Media</span><span class="r-dot">•</span>
        <span>Social Media</span><span class="r-dot">•</span>
        <span>Social Media</span>
      </div>

      <div class="ribbon r-3">
        <span>Branding</span><span class="r-dot">•</span>
        <span>Branding</span><span class="r-dot">•</span>
        <span>Branding</span><span class="r-dot">•</span>
        <span>Branding</span><span class="r-dot">•</span>
        <span>Branding</span>
      </div>

      <div class="ribbon r-4 is-behind">
        <span>Event Designs</span><span class="r-dot">•</span>
        <span>Event Designs</span><span class="r-dot">•</span>
        <span>Event Designs</span><span class="r-dot">•</span>
        <span>Event Designs</span>
      </div>

      <div class="ribbon r-5">
        <span>Ad Creatives</span><span class="r-dot">•</span>
        <span>Ad Creatives</span><span class="r-dot">•</span>
        <span>Ad Creatives</span><span class="r-dot">•</span>
        <span>Ad Creatives</span><span class="r-dot">•</span>
        <span>Ad Creatives</span>
      </div>
    </div>

    <!-- Lower Center CTA floating across forearm -->
    <div class="poster-center-cta">
      <p class="cta-q">
        Have a <strong>project</strong> in mind?
      </p>
      <p class="cta-sub">
        Lets <strong>CREATE</strong> it.
      </p>
    </div>

    <!-- Bottom Bar: Contact + "Designer" Lockup -->
    <div class="poster-bottom">
      <div class="poster-contact-meta">
        <a href={`mailto:${email}`} class="poster-contact-row">
          <span class="contact-k">ATELIER INQUIRY</span>
          <span class="contact-v">{email}</span>
        </a>
        <a href="/#contact" class="poster-contact-row">
          <span class="contact-k">DIRECT BRIEF</span>
          <span class="contact-v">JP3N Graphics Studio →</span>
        </a>
      </div>

      <div class="poster-design-lockup" aria-label="Designer">
        <span class="design-d">
          <span class="d-micro">Not your ordinary</span>D</span><span class="design-rest">esign</span><span class="design-er">er</span>
      </div>
    </div>
  </div>
</section>

<style>
  .graphics-poster-wrap {
    padding: var(--space-m) 0 var(--space-3xl);
  }

  .graphics-poster {
    position: relative;
    width: 100%;
    max-width: 760px;
    min-height: 760px;
    margin: 0 auto;
    background:
      radial-gradient(circle at 50% 42%, color-mix(in srgb, var(--text-accent-soft) 14%, var(--bg-elevated) 86%) 0%, var(--bg-surface) 100%);
    border: 1px solid var(--border-hairline-bright);
    padding: clamp(2rem, 4.5vw, 3.25rem) clamp(2rem, 4.5vw, 3.25rem) clamp(1.75rem, 3.5vw, 2.5rem);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    box-shadow: 0 28px 60px -18px rgba(0, 0, 0, 0.8);
  }

  /* Top Giant Typography */
  .poster-top {
    position: relative;
    z-index: 4;
  }

  .poster-giant-word {
    font-family: var(--font-display);
    font-size: clamp(4.5rem, 12vw, 8.75rem);
    font-weight: 700;
    line-height: 0.84;
    letter-spacing: -0.055em;
    color: var(--text-primary);
    margin: 0 0 14px;
  }

  .giant-i {
    position: relative;
  }

  .poster-sub-hook {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2.2vw, 1.7rem);
    font-weight: 400;
    line-height: 1.12;
    color: var(--text-accent-soft);
    margin: 0;
  }

  /* Hand Layer */
  .poster-hand-layer {
    position: absolute;
    left: 50%;
    bottom: 0;
    transform: translateX(-50%);
    width: clamp(260px, 38vw, 350px);
    z-index: 2;
    pointer-events: none;
  }

  .hand-svg {
    width: 100%;
    height: auto;
    display: block;
    filter: drop-shadow(0 20px 36px rgba(0, 0, 0, 0.75));
  }

  /* Weaving Ribbons */
  .ribbons-stage {
    position: relative;
    width: calc(100% + 8rem);
    margin-left: -4rem;
    height: 290px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 16px;
    pointer-events: none;
    margin-top: 24px;
    margin-bottom: 18px;
  }

  .ribbon {
    position: relative;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    padding: 7px 20px;
    background-color: var(--bg-canvas);
    border-top: 1px solid var(--border-hairline-bright);
    border-bottom: 1px solid var(--border-hairline-bright);
    font-family: var(--font-display);
    font-size: clamp(0.85rem, 1.25vw, 1.02rem);
    font-weight: 500;
    color: var(--text-primary);
    white-space: nowrap;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.6);
  }

  .ribbon.is-behind {
    z-index: 1;
    opacity: 0.92;
  }

  .r-dot {
    color: var(--text-accent);
  }

  .r-1 { transform: rotate(-7.5deg) translateY(-14px); }
  .r-2 { transform: rotate(1.5deg) translateY(-4px); }
  .r-3 { transform: rotate(-10deg) translateY(4px); }
  .r-4 { transform: rotate(-2.5deg) translateY(10px); }
  .r-5 { transform: rotate(0deg) translateY(18px); }

  /* Lower Center CTA floating across forearm */
  .poster-center-cta {
    position: relative;
    z-index: 4;
    text-align: center;
    margin: var(--space-s) 0 var(--space-m);
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.95);
  }

  .cta-q {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 1.8vw, 1.35rem);
    color: var(--text-primary);
    margin: 0;
  }

  .cta-sub {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    color: var(--text-accent-soft);
    margin: 2px 0 0;
  }

  /* Bottom Bar */
  .poster-bottom {
    position: relative;
    z-index: 4;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    padding-top: var(--space-l);
  }

  .poster-contact-meta {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .poster-contact-row {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    font-family: var(--font-mono);
  }

  .contact-k {
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    color: var(--text-muted);
  }

  .contact-v {
    font-size: 0.8rem;
    color: var(--text-primary);
    font-weight: 600;
  }

  .poster-contact-row:hover .contact-v {
    color: var(--text-accent);
  }

  /* "Designer" Lockup */
  .poster-design-lockup {
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 6vw, 4.75rem);
    font-weight: 600;
    line-height: 0.82;
    letter-spacing: -0.045em;
    color: var(--text-primary);
    display: inline-flex;
    align-items: baseline;
  }

  .design-d {
    position: relative;
    color: var(--text-accent-soft);
  }

  .d-micro {
    position: absolute;
    left: 6px;
    bottom: 8px;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-family: var(--font-mono);
    font-size: 0.5rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--bg-canvas);
    line-height: 1;
  }

  .design-er {
    font-size: 0.36em;
    color: var(--text-accent);
    margin-left: 2px;
  }

  @media (max-width: 640px) {
    .graphics-poster {
      min-height: 620px;
      padding: 1.5rem;
    }

    .poster-hand-layer {
      width: 230px;
    }

    .ribbons-stage {
      height: 220px;
      gap: 12px;
    }
  }
</style>
