---
interface Props {
  id?: string;
}

const { id = 'about' } = Astro.props;
---

<section class="who-we-are-section" id={id} aria-labelledby="about-heading">
  <!-- Subtle Blueprint Grid & Corner Canopy Glow -->
  <div class="who-grid-bg" aria-hidden="true"></div>
  <div class="who-glow-tr" aria-hidden="true"></div>
  <div class="who-glow-bl" aria-hidden="true"></div>

  <div class="site-container">
    <div class="who-inner">
      <span class="who-kicker">WHO WE ARE:</span>

      <h2 id="about-heading" class="who-statement">
        <span class="statement-line">
          We build
          <!-- Strategy First Floating Pill -->
          <span class="sticker-anchor sticker-strategy">
            <svg class="target-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8" />
              <circle cx="12" cy="12" r="4.5" stroke="currentColor" stroke-width="1.8" />
              <circle cx="12" cy="12" r="1.5" fill="currentColor" />
              <path d="M16 8L20 4M20 4H17M20 4V7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span class="sticker-pill">Strategy first</span>
          </span>
        </span>

        <span class="statement-line">
          <span class="selection-highlight">
            <span class="handle-tl" aria-hidden="true"></span>
            <em>brands</em>
            <span class="handle-br" aria-hidden="true"></span>
          </span>
          that feel
        </span>

        <span class="statement-line">
          intentional.
          <!-- Design with Meaning Floating Pill -->
          <span class="sticker-anchor sticker-design">
            <svg class="target-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8" />
              <circle cx="12" cy="12" r="4.5" stroke="currentColor" stroke-width="1.8" />
              <circle cx="12" cy="12" r="1.5" fill="currentColor" />
              <path d="M16 8L20 4M20 4H17M20 4V7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span class="sticker-pill">Design with meaning</span>
          </span>
        </span>

        <span class="statement-line">
          From <em>identity</em>
        </span>

        <span class="statement-line">
          to <em>execution</em>.
          <!-- Built to Scale Floating Pill -->
          <span class="sticker-anchor sticker-scale">
            <span class="sticker-pill">Built to scale</span>
            <svg class="target-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8" />
              <circle cx="12" cy="12" r="4.5" stroke="currentColor" stroke-width="1.8" />
              <circle cx="12" cy="12" r="1.5" fill="currentColor" />
              <path d="M16 8L20 4M20 4H17M20 4V7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
        </span>
      </h2>

      <p class="who-subnote">
        We build from first principles: pure static HTML paint, design systems defined in clean CSS custom properties, and zero-telemetry client utilities.
      </p>
    </div>
  </div>
</section>

<style>
  .who-we-are-section {
    position: relative;
    padding: clamp(4rem, 7vw, 6.5rem) 0;
    background-color: var(--bg-canvas, #09100b);
    border-bottom: 1px solid var(--border-hairline);
    overflow: hidden;
  }

  /* Subtle Architectural Grid matching reference & theme */
  .who-grid-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgba(250, 249, 246, 0.035) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(250, 249, 246, 0.035) 1px, transparent 1px);
    background-size: 36px 36px;
    pointer-events: none;
    mask-image: radial-gradient(ellipse at center, black 45%, transparent 90%);
    -webkit-mask-image: radial-gradient(ellipse at center, black 45%, transparent 90%);
  }

  .who-glow-tr {
    position: absolute;
    top: -120px;
    right: -120px;
    width: 360px;
    height: 360px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(82, 164, 104, 0.16) 0%, transparent 70%);
    pointer-events: none;
  }

  .who-glow-bl {
    position: absolute;
    bottom: -140px;
    left: -120px;
    width: 340px;
    height: 340px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(164, 172, 134, 0.12) 0%, transparent 70%);
    pointer-events: none;
  }

  .who-inner {
    position: relative;
    z-index: 2;
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .who-kicker {
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--theme-accent, #52a468);
    margin-bottom: 1.5rem;
    text-transform: uppercase;
  }

  .who-statement {
    font-family: var(--font-display, 'Space Grotesk', sans-serif);
    font-size: clamp(2.1rem, 5.2vw, 3.85rem);
    font-weight: 400;
    line-height: 1.18;
    letter-spacing: -0.03em;
    color: var(--text-primary, #faf9f6);
    margin: 0 0 2.5rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .statement-line {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.25em;
    flex-wrap: wrap;
  }

  .who-statement em {
    font-style: italic;
    font-weight: 600;
  }

  /* Selection Highlight Box around "brands" */
  .selection-highlight {
    position: relative;
    display: inline-block;
    padding: 0.02em 0.16em;
    background: rgba(82, 164, 104, 0.22);
    border: 1px solid rgba(82, 164, 104, 0.65);
    color: #faf9f6;
  }

  .selection-highlight em {
    color: #a4ac86;
  }

  .handle-tl,
  .handle-br {
    position: absolute;
    width: 0;
    height: 0;
    border-style: solid;
  }

  .handle-tl {
    top: -9px;
    left: -6px;
    border-width: 9px 6px 0 6px;
    border-color: var(--theme-accent, #52a468) transparent transparent transparent;
  }

  .handle-br {
    bottom: -9px;
    right: -6px;
    border-width: 0 6px 9px 6px;
    border-color: transparent transparent var(--theme-accent, #52a468) transparent;
  }

  /* Floating Sticker Pills */
  .sticker-anchor {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    vertical-align: middle;
    margin-left: 0.15em;
    transition: transform 0.3s cubic-bezier(0.2, 0.9, 0.3, 1);
  }

  .sticker-pill {
    font-family: var(--font-body, 'Sora', sans-serif);
    font-size: clamp(0.68rem, 0.62rem + 0.25vw, 0.82rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1;
    padding: 0.45em 0.9em;
    border-radius: 9999px;
    background-color: var(--theme-accent, #52a468);
    color: #09100b;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.45), 0 0 14px rgba(82, 164, 104, 0.28);
    white-space: nowrap;
  }

  .target-icon {
    color: var(--theme-accent, #52a468);
    opacity: 0.9;
  }

  .sticker-strategy {
    transform: rotate(-7deg) translateY(-4px);
  }

  .sticker-design {
    transform: rotate(4deg) translateY(8px);
  }

  .sticker-scale {
    transform: rotate(-5deg) translateY(10px);
  }

  .sticker-anchor:hover {
    transform: rotate(0deg) translateY(-2px) scale(1.04);
  }

  .who-subnote {
    font-family: var(--font-body, 'Sora', sans-serif);
    font-size: clamp(0.84rem, 0.8rem + 0.2vw, 0.94rem);
    line-height: 1.65;
    color: var(--text-secondary, #a3ad9d);
    max-width: 540px;
    margin: 0.5rem auto 0 auto;
  }

  @media (max-width: 640px) {
    .sticker-strategy,
    .sticker-design,
    .sticker-scale {
      transform: rotate(-2deg) translateY(0);
      margin: 4px 0;
    }

    .statement-line {
      row-gap: 4px;
    }
  }
</style>
