---
import { siteConfig } from '../config/site';
import { teamContributions, memberColors } from '../data/teamCalendar';

interface Props {
  id?: string;
}

const { id = 'calendar' } = Astro.props;

const teamMembers = siteConfig.team.map((m) => ({
  shortName: m.name.split(' ')[0],
  fullName: m.name,
  handle: m.githubHandle,
  color: memberColors[m.githubHandle] || 'var(--text-accent)'
}));

const serializedData = JSON.stringify(teamContributions);
const serializedColors = JSON.stringify(memberColors);
const serializedMembers = JSON.stringify(teamMembers);

const buildNow = new Date();
const monthNamesSSR = [
  'JANUARY', 'FEBRUARY', 'MARCH', 'APRIL', 'MAY', 'JUNE',
  'JULY', 'AUGUST', 'SEPTEMBER', 'OCTOBER', 'NOVEMBER', 'DECEMBER'
];
const initialMonthName = monthNamesSSR[buildNow.getMonth()];
const initialYear = buildNow.getFullYear();
const initialMonthAttr = `${initialYear}-${String(buildNow.getMonth() + 1).padStart(2, '0')}`;
---

<section class="calendar-section" id={id} aria-labelledby="calendar-heading">
  <div class="site-container">
    <div class="calendar-card" id="teqniqksCalendarCard">
      <!-- Top Header -->
      <div class="cal-header">
        <button type="button" class="cal-nav-btn" id="calPrevBtn" aria-label="Previous month" title="Previous month">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M10 3.5L5.5 8L10 12.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>

        <div class="cal-title-block">
          <span class="cal-kicker">The Teqniqks Build Calendar</span>
          <h2 id="calendar-heading" class="cal-month-title" data-month={initialMonthAttr}>
            {initialMonthName}
          </h2>
          <span class="cal-year-sub" id="calYearSub">{initialYear} · DAILY GITHUB CONTRIBUTIONS</span>
        </div>

        <button type="button" class="cal-nav-btn" id="calNextBtn" aria-label="Next month" title="Next month">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M6 3.5L10.5 8L6 12.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
      </div>

      <!-- Team Member Filter Bar -->
      <div class="cal-member-filters" role="group" aria-label="Filter calendar by team member">
        <button type="button" class="member-filter-btn is-active" data-member="all">
          All Builders
        </button>
        {teamMembers.map((m) => (
          <button
            type="button"
            class="member-filter-btn"
            data-member={m.handle}
            style={`--m-color: ${m.color};`}
          >
            <span class="filter-dot" aria-hidden="true"></span>
            {m.shortName}
          </button>
        ))}
      </div>

      <!-- 7-Column Editorial Calendar Grid -->
      <div class="cal-weekdays" aria-hidden="true">
        <span>SUN</span>
        <span>MON</span>
        <span>TUES</span>
        <span>WED</span>
        <span>THURS</span>
        <span>FRI</span>
        <span>SAT</span>
      </div>

      <div class="cal-grid" id="calDaysGrid" role="grid" aria-label="Monthly project contributions">
        <!-- Populated by lightweight inline script from verified build-time data -->
      </div>

      <!-- Selected Day Breakdown Inspector -->
      <div class="cal-day-inspector" id="calDayInspector" aria-live="polite">
        <div class="inspector-top">
          <span class="inspector-date" id="inspectorDateLabel">2026-11-23</span>
          <span class="cal-sync-badge" id="calSyncBadge">
            <span class="cal-sync-spin" aria-hidden="true"></span>
            <span>Syncing GitHub…</span>
          </span>
          <span class="inspector-hint">Click any highlighted day to inspect repositories</span>
        </div>
        <div class="inspector-entries" id="inspectorEntries"></div>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ serializedData, serializedColors, serializedMembers }}>
  const contributionsByDate = JSON.parse(serializedData);
  const colorsMap = JSON.parse(serializedColors);
  const membersList = JSON.parse(serializedMembers);

  const monthNames = [
    'JANUARY', 'FEBRUARY', 'MARCH', 'APRIL', 'MAY', 'JUNE',
    'JULY', 'AUGUST', 'SEPTEMBER', 'OCTOBER', 'NOVEMBER', 'DECEMBER'
  ];

  const now = new Date();
  let currentYear = now.getFullYear();
  let currentMonth = now.getMonth(); // Automatically matches current real-world month
  let activeMember = 'all';

  function pad(n) {
    return n < 10 ? `0${n}` : `${n}`;
  }

  const todayStr = `${currentYear}-${pad(currentMonth + 1)}-${pad(now.getDate())}`;
  let selectedDate = contributionsByDate[todayStr]
    ? todayStr
    : `${currentYear}-${pad(currentMonth + 1)}-${pad(now.getDate())}`;

  const monthTitleEl = document.getElementById('calendar-heading');
  const yearSubEl = document.getElementById('calYearSub');
  const gridEl = document.getElementById('calDaysGrid');
  const prevBtn = document.getElementById('calPrevBtn');
  const nextBtn = document.getElementById('calNextBtn');
  const filterBtns = document.querySelectorAll('.member-filter-btn');
  const inspectorDateEl = document.getElementById('inspectorDateLabel');
  const inspectorEntriesEl = document.getElementById('inspectorEntries');

  function pickDefaultDateForMonth(year, month) {
    const prefix = `${year}-${pad(month + 1)}-`;
    const matchingDates = Object.keys(contributionsByDate)
      .filter((d) => d.startsWith(prefix))
      .sort();
    return matchingDates.length > 0 ? matchingDates[matchingDates.length - 1] : `${prefix}01`;
  }

  function renderInspector(dateStr) {
    if (!inspectorDateEl || !inspectorEntriesEl) return;
    inspectorDateEl.textContent = dateStr;
    const dayData = contributionsByDate[dateStr];
    if (!dayData) {
      inspectorEntriesEl.innerHTML =
        '<p class="inspector-empty">No public repository pushes recorded on this date.</p>';
      return;
    }

    const filtered =
      activeMember === 'all'
        ? dayData.contributions
        : dayData.contributions.filter((c) => c.githubHandle === activeMember);

    if (filtered.length === 0) {
      inspectorEntriesEl.innerHTML =
        '<p class="inspector-empty">No contributions for the selected builder on this date.</p>';
      return;
    }

    inspectorEntriesEl.innerHTML = filtered
      .map((c) => {
        const color = colorsMap[c.githubHandle] || 'var(--text-accent)';
        const repoLinks = c.repos
          .map((r) => {
            const fullRepo = r.includes('/') ? r : `${c.githubHandle}/${r}`;
            return `<a href="https://github.com/${fullRepo}" target="_blank" rel="noopener noreferrer" class="insp-repo-link">${r} ↗</a>`;
          })
          .join('');
        return `
          <div class="insp-row">
            <span class="insp-member" style="--m-color: ${color};">
              <span class="insp-dot"></span>
              ${c.memberName}
            </span>
            <div class="insp-repos">${repoLinks}</div>
            <span class="insp-count">${c.eventsCount} ${c.eventsCount === 1 ? 'push' : 'events'}</span>
          </div>
        `;
      })
      .join('');
  }

  function renderCalendar() {
    if (!gridEl || !monthTitleEl) return;
    const daysInMonth = new Date(currentYear, currentMonth + 1, 0).getDate();
    monthTitleEl.textContent = monthNames[currentMonth];
    monthTitleEl.setAttribute('data-month', `${currentYear}-${pad(currentMonth + 1)}`);
    if (yearSubEl) {
      yearSubEl.textContent = `${currentYear} · DAILY GITHUB CONTRIBUTIONS`;
    }

    const firstDayOfWeek = new Date(currentYear, currentMonth, 1).getDay(); // 0=Sun
    const totalCells = Math.ceil((firstDayOfWeek + daysInMonth) / 7) * 7;

    let html = '';
    for (let i = 0; i < totalCells; i++) {
      const dayNum = i - firstDayOfWeek + 1;
      if (dayNum < 1 || dayNum > daysInMonth) {
        html += '<div class="cal-cell is-empty" aria-hidden="true"></div>';
        continue;
      }

      const dateStr = `${currentYear}-${pad(currentMonth + 1)}-${pad(dayNum)}`;
      const dayData = contributionsByDate[dateStr];
      const filtered = dayData
        ? activeMember === 'all'
          ? dayData.contributions
          : dayData.contributions.filter((c) => c.githubHandle === activeMember)
        : [];

      const hasActivity = filtered.length > 0;
      const isSelected = dateStr === selectedDate;
      const hasNote = Boolean(dayData?.note && hasActivity);

      let chipsHtml = '';
      if (hasActivity) {
        chipsHtml = filtered
          .slice(0, 3)
          .map((c) => {
            const color = colorsMap[c.githubHandle] || 'var(--text-accent)';
            const mainRepo = c.repos[0]?.split('/').pop() || '';
            return `
              <span class="cal-chip" style="--m-color: ${color};" title="${c.memberName}: ${c.repos.join(', ')}">
                <span class="chip-dot"></span>
                <span class="chip-text">${c.memberName} · ${mainRepo}</span>
              </span>
            `;
          })
          .join('');
        if (filtered.length > 3) {
          chipsHtml += `<span class="cal-more">+${filtered.length - 3} more</span>`;
        }
      }

      html += `
        <button
          type="button"
          class="cal-cell ${hasActivity ? 'has-activity' : ''} ${isSelected ? 'is-selected' : ''} ${hasNote ? 'has-note' : ''}"
          data-date="${dateStr}"
        >
          <span class="cal-day-num ${hasNote ? 'is-ringed' : ''}">${dayNum}</span>
          ${hasNote ? `<span class="cal-sticky-note">${dayData.note}</span>` : ''}
          <div class="cal-chips">${chipsHtml}</div>
        </button>
      `;
    }

    gridEl.innerHTML = html;

    gridEl.querySelectorAll('.cal-cell[data-date]').forEach((cell) => {
      cell.addEventListener('click', () => {
        selectedDate = cell.getAttribute('data-date') || selectedDate;
        renderCalendar();
        renderInspector(selectedDate);
      });
    });
  }

  prevBtn?.addEventListener('click', () => {
    currentMonth -= 1;
    if (currentMonth < 0) {
      currentMonth = 11;
      currentYear -= 1;
    }
    selectedDate = pickDefaultDateForMonth(currentYear, currentMonth);
    renderCalendar();
    renderInspector(selectedDate);
  });

  nextBtn?.addEventListener('click', () => {
    currentMonth += 1;
    if (currentMonth > 11) {
      currentMonth = 0;
      currentYear += 1;
    }
    selectedDate = pickDefaultDateForMonth(currentYear, currentMonth);
    renderCalendar();
    renderInspector(selectedDate);
  });

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      activeMember = btn.getAttribute('data-member') || 'all';
      renderCalendar();
      renderInspector(selectedDate);
    });
  });

  renderCalendar();
  renderInspector(selectedDate);

  const syncBadgeEl = document.getElementById('calSyncBadge');

  // Sync live public GitHub events for the current/recent months without blocking render
  async function syncLiveGithubEvents() {
    if (syncBadgeEl) syncBadgeEl.classList.add('is-syncing');
    let updated = false;
    try {
      await Promise.all(
        membersList.map(async (m) => {
          try {
            const res = await fetch(`https://api.github.com/users/${encodeURIComponent(m.handle)}/events/public?per_page=30`);
            if (!res.ok) return;
            const events = await res.json();
            if (!Array.isArray(events)) return;

            for (const ev of events) {
              if (!ev?.created_at || !ev?.repo?.name) continue;
              const dateStr = String(ev.created_at).slice(0, 10);
              const repoShort = ev.repo.name.startsWith(`${m.handle}/`)
                ? ev.repo.name.slice(m.handle.length + 1)
                : ev.repo.name;

              if (!contributionsByDate[dateStr]) {
                contributionsByDate[dateStr] = { date: dateStr, contributions: [] };
              }
              const day = contributionsByDate[dateStr];
              let entry = day.contributions.find((c) => c.githubHandle === m.handle);
              if (!entry) {
                entry = {
                  memberName: m.shortName,
                  githubHandle: m.handle,
                  repos: [repoShort],
                  eventsCount: 1
                };
                day.contributions.push(entry);
                updated = true;
              } else if (!entry.repos.includes(repoShort)) {
                entry.repos.push(repoShort);
                entry.eventsCount += 1;
                updated = true;
              }
            }
          } catch {
            // Silently keep verified static data if offline or rate-limited
          }
        })
      );

      if (updated) {
        if (!contributionsByDate[selectedDate]) {
          selectedDate = pickDefaultDateForMonth(currentYear, currentMonth);
        }
        renderCalendar();
        renderInspector(selectedDate);
      }
    } finally {
      if (syncBadgeEl) syncBadgeEl.classList.remove('is-syncing');
    }
  }

  syncLiveGithubEvents();
</script>

<style>
  .site-container {
    max-width: 1040px;
    margin: 0 auto;
    padding: 0 clamp(1.5rem, 5vw, 4rem);
  }

  .cal-sync-badge {
    display: none;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--text-accent);
    letter-spacing: 0.04em;
  }

  .cal-sync-badge.is-syncing {
    display: inline-flex;
  }

  .cal-sync-spin {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 1.5px solid color-mix(in srgb, var(--text-accent) 25%, transparent);
    border-top-color: var(--text-accent);
    animation: calSpin 0.75s linear infinite;
  }

  @keyframes calSpin {
    to { transform: rotate(360deg); }
  }

  .calendar-section {
    padding: clamp(4rem, 7vw, 6rem) 0;
    border-bottom: 1px solid var(--border-hairline);
    background-color: var(--bg-canvas);
  }

  .calendar-card {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-hairline-bright);
    border-radius: 18px;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    box-shadow: 0 24px 48px -18px rgba(0, 0, 0, 0.7);
  }

  /* Header */
  .cal-header {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 12px;
    margin-bottom: var(--space-l);
  }

  .cal-nav-btn {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--bg-elevated);
    border: 1px solid var(--border-hairline);
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 1rem;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: border-color 150ms ease, color 150ms ease;
  }

  .cal-nav-btn:hover {
    border-color: var(--text-accent);
    color: var(--text-accent);
  }

  .cal-title-block {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .cal-kicker {
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin-bottom: 2px;
  }

  .cal-month-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, 3.35rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--text-accent-soft);
    margin-bottom: 6px;
  }

  .cal-year-sub {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    color: var(--text-muted);
  }

  .cal-right-controls {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .cal-brand-mark {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: -0.04em;
    color: var(--text-primary);
    padding: 4px 8px;
    border: 1px solid var(--border-hairline);
  }

  /* Filter Pills */
  .cal-member-filters {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin-bottom: var(--space-l);
  }

  .member-filter-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 12px;
    border-radius: 999px;
    background: var(--bg-canvas);
    border: 1px solid var(--border-hairline);
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    cursor: pointer;
    transition: all 150ms ease;
  }

  .member-filter-btn:hover {
    border-color: var(--border-hairline-bright);
    color: var(--text-primary);
  }

  .member-filter-btn.is-active {
    background: var(--theme-accent-muted);
    border-color: var(--m-color, var(--text-accent));
    color: var(--text-primary);
  }

  .filter-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: var(--m-color, var(--text-accent));
  }

  /* Weekday Header */
  .cal-weekdays {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    border-bottom: 1px solid var(--border-hairline-bright);
    padding-bottom: 8px;
    margin-bottom: 0;
  }

  .cal-weekdays span {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--text-secondary);
    padding: 0 8px;
  }

  /* Grid */
  .cal-grid {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    border-left: 1px solid var(--border-hairline);
  }

  :global(.cal-cell) {
    position: relative;
    min-height: 82px;
    padding: 7px;
    background: transparent;
    border: none;
    border-right: 1px solid var(--border-hairline);
    border-bottom: 1px solid var(--border-hairline);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 5px;
    text-align: left;
    cursor: pointer;
    transition: background-color 140ms ease;
  }

  :global(.cal-cell.is-empty) {
    cursor: default;
    background: color-mix(in srgb, var(--bg-canvas) 35%, transparent);
  }

  :global(.cal-cell:not(.is-empty):hover) {
    background: var(--bg-elevated);
  }

  :global(.cal-cell.is-selected) {
    background: color-mix(in srgb, var(--text-accent) 12%, var(--bg-elevated) 88%);
    box-shadow: inset 0 0 0 1px var(--text-accent);
  }

  :global(.cal-day-num) {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--text-secondary);
    line-height: 1;
  }

  :global(.cal-day-num.is-ringed) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border: 1.5px solid var(--text-accent);
    color: var(--text-primary);
  }

  :global(.cal-sticky-note) {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    padding: 2px 5px;
    background: var(--theme-accent-muted);
    color: var(--text-accent-soft);
    border: 1px dashed var(--border-hairline-bright);
    transform: rotate(-1.5deg);
    align-self: flex-end;
    margin-top: -18px;
  }

  :global(.cal-chips) {
    display: flex;
    flex-direction: column;
    gap: 3px;
    width: 100%;
    margin-top: 2px;
  }

  :global(.cal-chip) {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    width: 100%;
    padding: 2px 5px;
    border-radius: 3px;
    background: color-mix(in srgb, var(--m-color, var(--text-accent)) 16%, var(--bg-canvas) 84%);
    border-left: 2px solid var(--m-color, var(--text-accent));
    font-family: var(--font-mono);
    font-size: 0.61rem;
    color: var(--text-primary);
    overflow: hidden;
  }

  :global(.chip-dot) {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--m-color, var(--text-accent));
    flex-shrink: 0;
  }

  :global(.chip-text) {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(.cal-more) {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    color: var(--text-muted);
    padding-left: 4px;
  }

  /* Selected Day Inspector */
  .cal-day-inspector {
    margin-top: var(--space-l);
    padding: var(--space-m) var(--space-l);
    background: var(--bg-canvas);
    border: 1px solid var(--border-hairline);
    border-radius: 10px;
  }

  .inspector-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
    padding-bottom: 10px;
    margin-bottom: 10px;
    border-bottom: 1px dashed var(--border-hairline);
  }

  .inspector-date {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-accent);
  }

  .inspector-hint {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-muted);
  }

  .inspector-entries {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  :global(.inspector-empty) {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  :global(.insp-row) {
    display: grid;
    grid-template-columns: 120px 1fr auto;
    align-items: center;
    gap: 12px;
    padding: 6px 0;
  }

  :global(.insp-member) {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  :global(.insp-dot) {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--m-color, var(--text-accent));
  }

  :global(.insp-repos) {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  :global(.insp-repo-link) {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    padding: 3px 8px;
    background: var(--bg-surface);
    border: 1px solid var(--border-hairline-bright);
    color: var(--text-accent-soft);
    text-decoration: none;
  }

  :global(.insp-repo-link:hover) {
    border-color: var(--text-accent);
    color: var(--text-accent);
  }

  :global(.insp-count) {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-muted);
  }

  @media (max-width: 760px) {
    .cal-weekdays span {
      font-size: 0.6rem;
      padding: 0 3px;
      text-align: center;
    }

    :global(.cal-cell) {
      min-height: 70px;
      padding: 4px;
    }

    :global(.cal-sticky-note) {
      display: none;
    }

    :global(.insp-row) {
      grid-template-columns: 1fr;
      gap: 6px;
    }

    .cal-brand-mark {
