---
import { siteConfig } from '../config/site';

const { email, github, linkedin } = siteConfig.contact;
const teamPortraits = siteConfig.team.map((m) => ({
  name: m.name,
  portrait: m.portrait
}));
---

<footer class="site-footer">
  <!-- Full-Width Split-Typography & Monochrome Strip Centerpiece -->
  <div class="footer-hero-banner">
    <span class="banner-eyebrow">TEQNIQKS COLLECTIVE · VOL. 26</span>

    <div class="split-lockup">
      <div class="split-word-top" aria-hidden="true">TEQNIQKS 2026</div>

      <!-- Full-Width 5-Panel Horizontal Monochrome Strip (Team Portraits) -->
      <div class="monochrome-strip" aria-hidden="true">
        {teamPortraits.map((member) => (
          <div class="strip-panel">
            <img
              src={member.portrait}
              alt=""
              class="strip-img"
              loading="lazy"
              decoding="async"
            />
          </div>
        ))}
      </div>

      <h2 class="split-word-bottom">SELECTED</h2>
    </div>

    <p class="banner-caption">
      THIS CASE CONTAINS ALL THE PROJECTS, CONCEPTS, AND EXPERIMENTS FOR THE 2022 — {new Date().getFullYear()} ERA.
    </p>
  </div>

  <!-- Full-Width Integrated Footer Details & Links -->
  <div class="footer-container">
    <div class="footer-main-grid">
        <div class="footer-col-brand">
          <span class="footer-title">Teqniqks</span>
          <p class="footer-statement">
            Independent software and design atelier based in Sri Lanka, engineering high-speed platforms and open tools for the global web.
          </p>
          <div class="footer-contact-row">
            <span class="contact-label">DIRECT INQUIRY:</span>
            <a href={`mailto:${email}`} class="contact-email">{email}</a>
          </div>
        </div>

        <div class="footer-col-nav">
          <span class="col-heading">NAVIGATION</span>
          <ul class="col-links">
            <li><a href="/#about">About</a></li>
            <li><a href="/#workshops">Workshops</a></li>
            <li><a href="/#work">Selected Work</a></li>
            <li><a href="/#process">Process</a></li>
            <li><a href="/#team">Team</a></li>
            <li><a href="/#calendar">Build Calendar</a></li>
            <li><a href="/#preferences">On Rotation</a></li>
            <li><a href="/#afk">AFK</a></li>
            <li><a href="/journal">Journal</a></li>
          </ul>
        </div>

        <div class="footer-col-channels">
          <span class="col-heading">WORKSHOPS &amp; CONNECT</span>
          <ul class="col-links">
            <li><a href="/process">Web Laboratory (Websites)</a></li>
            <li><a href="/themes">Graphics Studio (Design)</a></li>
            <li><a href="/motion">Motion Bay (Video &amp; Motion)</a></li>
            <li><a href="/contributors">Open Forge (Contribute)</a></li>
            <li><a href={github} target="_blank" rel="noopener noreferrer">GitHub</a></li>
            <li><a href={linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
            <li><a href="/privacy">Privacy &amp; Zero-Cookie Policy</a></li>
          </ul>
        </div>
      </div>

      <div class="footer-bottom-bar">
        <span class="legal-note">
          © {new Date().getFullYear()} TEQNIQKS TECH DWELLING. ZERO TRACKING COOKIES. SRI LANKA PDPA &amp; GDPR COMPLIANT.
        </span>
        <a href="#main-content" class="back-to-top" aria-label="Back to top of page">
          BACK TO TOP ↑
        </a>
      </div>
  </div>
</footer>

<style>
  .site-footer {
    width: 100%;
    padding: var(--space-3xl) 0 var(--space-2xl);
    background-color: var(--bg-surface);
    border-top: 1px solid var(--border-hairline);
    position: relative;
  }

  .footer-container {
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  /* =========================================================
     SPLIT-TYPOGRAPHY + MONOCHROME STRIP CENTERPIECE
     ========================================================= */
  .footer-hero-banner {
    width: 100%;
    text-align: center;
    padding: var(--space-l) 0 var(--space-3xl);
    margin-bottom: var(--space-2xl);
    border-bottom: 1px solid var(--border-hairline);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .banner-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    color: var(--text-accent-soft);
    margin-bottom: var(--space-s);
  }

  .split-lockup {
    position: relative;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: var(--space-m);
  }

  .split-word-top {
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 8.5vw, 6.2rem);
    font-weight: 700;
    line-height: 0.82;
    letter-spacing: -0.04em;
    color: var(--text-primary);
    text-transform: uppercase;
    margin-bottom: -0.26em;
    z-index: 1;
    user-select: none;
  }

  .monochrome-strip {
    position: relative;
    z-index: 2;
    width: 100%;
    height: clamp(54px, 8vw, 92px);
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    background-color: var(--bg-surface);
    border-top: 1px solid var(--border-hairline-bright);
    border-bottom: 1px solid var(--border-hairline-bright);
    overflow: hidden;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.7);
  }

  .strip-panel {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-right: 1px solid rgba(255, 255, 255, 0.08);
  }

  .strip-panel:last-child {
    border-right: none;
  }

  .strip-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 22%;
    filter: grayscale(100%) contrast(1.22) brightness(0.85);
    transition: filter 250ms ease, transform 300ms ease;
    display: block;
  }

  .strip-panel:hover .strip-img {
    filter: grayscale(100%) contrast(1.3) brightness(1);
    transform: scale(1.06);
  }

  .split-word-bottom {
    position: relative;
    z-index: 1;
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 8.5vw, 6.2rem);
    font-weight: 700;
    line-height: 0.86;
    letter-spacing: -0.04em;
    color: var(--text-primary);
    text-transform: uppercase;
    margin-top: -0.14em;
  }

  .banner-caption {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    color: var(--text-secondary);
    max-width: 68ch;
  }

  /* =========================================================
     FOOTER DETAILS
     ========================================================= */
  .footer-main-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: var(--space-2xl);
    padding-bottom: var(--space-2xl);
    border-bottom: 1px solid var(--border-hairline);
  }

  .footer-title {
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 300;
    color: var(--text-primary);
    display: block;
    margin-bottom: var(--space-xs);
    letter-spacing: -0.03em;
  }

  .footer-statement {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: var(--lh-body);
    max-width: 44ch;
    margin-bottom: var(--space-l);
  }

  .footer-contact-row {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .contact-label {
    color: var(--text-muted);
  }

  .contact-email {
    color: var(--text-accent-soft);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .contact-email:hover {
    color: var(--text-accent);
  }

  .col-heading {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--text-accent);
    display: block;
    margin-bottom: var(--space-m);
  }

  .col-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .col-links a {
    font-size: 0.875rem;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 150ms ease;
  }

  .col-links a:hover {
    color: var(--text-primary);
  }

  .footer-bottom-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    padding-top: var(--space-l);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-muted);
  }

  .back-to-top {
    color: var(--text-accent-soft);
    text-decoration: none;
    letter-spacing: 0.06em;
  }

  .back-to-top:hover {
    color: var(--text-accent);
  }

  @media (max-width: 820px) {
    .footer-main-grid {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }
  }
</style>
