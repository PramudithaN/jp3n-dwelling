---
import { siteConfig } from '../config/site';

const { email, github, linkedin } = siteConfig.contact;
---

<footer class="site-footer" id="contact">
  <div class="footer-container">
    <div class="footer-framed framed-box">
      <span class="tick-tr" aria-hidden="true"></span>
      <span class="tick-bl" aria-hidden="true"></span>

      <div class="footer-main-grid">
        <div class="footer-col-brand">
          <span class="footer-title">JP3N</span>
          <p class="footer-statement">
            Independent software and design atelier based in Sri Lanka, engineering high-speed platforms and open tools for the global web.
          </p>
          <div class="footer-contact-row">
            <span class="contact-label">DIRECT INQUIRY:</span>
            <a href={`mailto:${email}`} class="contact-email">{email}</a>
          </div>
        </div>

        <div class="footer-col-nav">
          <span class="col-heading">NAVIGATION</span>
          <ul class="col-links">
            <li><a href="/#about">About</a></li>
            <li><a href="/#work">Selected Work</a></li>
            <li><a href="/#workshops">Workshops</a></li>
            <li><a href="/#process">Methodology</a></li>
            <li><a href="/#team">Team</a></li>
            <li><a href="/journal">Journal</a></li>
          </ul>
        </div>

        <div class="footer-col-channels">
          <span class="col-heading">CONNECT</span>
          <ul class="col-links">
            <li><a href={github} target="_blank" rel="noopener noreferrer">GitHub</a></li>
            <li><a href={linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
            <li><a href="/privacy">Privacy & Zero-Cookie Policy</a></li>
            <li><a href="/contributors">Open Forge Contributor Space</a></li>
          </ul>
        </div>
      </div>

      <div class="footer-bottom-bar">
        <span class="legal-note">
          © {new Date().getFullYear()} JP3N TECH DWELLING. ZERO TRACKING COOKIES. SRI LANKA PDPA & GDPR COMPLIANT.
        </span>
        <a href="#main-content" class="back-to-top" aria-label="Back to top of page">
          BACK TO TOP ↑
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding: var(--space-4xl) var(--gutter) var(--space-2xl);
    background-color: var(--bg-canvas);
    position: relative;
  }

  .footer-container {
    max-width: var(--content-max-width);
    margin: 0 auto;
  }

  .footer-framed {
    background-color: var(--bg-surface);
    padding: var(--space-2xl);
  }

  .footer-main-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: var(--space-2xl);
    padding-bottom: var(--space-2xl);
    border-bottom: 1px solid var(--border-hairline);
  }

  .footer-title {
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 300;
    color: var(--text-primary);
    display: block;
    margin-bottom: var(--space-xs);
    letter-spacing: -0.03em;
  }

  .footer-statement {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: var(--lh-body);
    max-width: 44ch;
    margin-bottom: var(--space-l);
  }

  .footer-contact-row {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .contact-label {
    color: var(--text-muted);
  }

  .contact-email {
    color: var(--color-raw-amber-sand);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .contact-email:hover {
    color: var(--color-raw-amber-vivid);
  }

  .col-heading {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-muted);
    letter-spacing: 0.08em;
    display: block;
    margin-bottom: var(--space-m);
  }

  .col-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .col-links a {
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--text-secondary);
    transition: color 150ms ease;
  }

  .col-links a:hover {
    color: var(--text-primary);
  }

  .footer-bottom-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: var(--space-l);
    flex-wrap: wrap;
    gap: var(--space-s);
  }

  .legal-note {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-muted);
    letter-spacing: 0.04em;
  }

  .back-to-top {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-secondary);
    letter-spacing: 0.08em;
    transition: color 150ms ease;
  }

  .back-to-top:hover {
    color: var(--text-primary);
  }

  @media (max-width: 860px) {
    .footer-main-grid {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }
  }
</style>
