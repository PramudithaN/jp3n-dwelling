        {
          "label": "Color Grade (Curves)",
          "effect": "ADBE CurvesCustom",
          "code": "eff.addProperty('ADBE CurvesCustom');",
          "reason": "S-curve contrast and tonal grading"
        }
      ]
    },
    {
      "context": {
        "threeDLayer": true
      },
      "recommendations": [
        {
