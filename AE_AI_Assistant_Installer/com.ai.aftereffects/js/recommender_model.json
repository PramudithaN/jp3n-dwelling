{
  "version": "1.0.0",
  "name": "After Effects Workflow Recommender",
  "description": "Zero-VRAM, 2ms recommendation engine for next-tool prediction",
  "context_rules": [
    {
      "context": {
        "layerType": "AVLayer",
        "hasEffect": "ADBE Keylight"
      },
      "recommendations": [
        {
          "label": "Tighten Edges",
          "effect": "ADBE Simple Choker",
          "code": "eff.addProperty('ADBE Simple Choker');",
          "reason": "Choke matte edges after chroma keying"
        },
        {
          "label": "Color Match",
          "effect": "ADBE Lumetri Color",
          "code": "eff.addProperty('ADBE Lumetri Color');",
          "reason": "Match keyed subject with background lighting"
        },
        {
          "label": "Light Wrap",
          "effect": "ADBE Box Blur2",
          "code": "eff.addProperty('ADBE Box Blur2');",
          "reason": "Blend background light bleed into subject"
        }
      ]
    },
    {
      "context": {
        "layerType": "ShapeLayer"
      },
      "recommendations": [
        {
          "label": "Trim Paths",
          "effect": "ADBE Vector Filter - Trim",
          "code": "groupContents.addProperty('ADBE Vector Filter - Trim');",
          "reason": "Animate line draw-on / stroke write-on"
        },
        {
          "label": "Repeater Burst",
          "effect": "ADBE Vector Filter - Repeater",
