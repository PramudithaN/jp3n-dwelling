        },
        {
          "label": "Drop Shadow",
          "effect": "ADBE Drop Shadow",
          "code": "eff.addProperty('ADBE Drop Shadow');",
          "reason": "Separate typography from background elements"
        },
        {
          "label": "Tracking Animator",
          "effect": "ADBE Text Tracking",
          "code": "addTrackingAnimator(layer);",
          "reason": "Cinematic text expand/contract spacing"
        }
      ]
    },
    {
      "context": {
