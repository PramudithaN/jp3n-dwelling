#!/usr/bin/env node
import fs from 'node:fs';

const msgFile = process.argv[2];
if (!msgFile) {
  console.error('[commit-rules] Missing commit message file path.');
  process.exit(1);
}

const raw = fs.readFileSync(msgFile, 'utf8');
const lines = raw
  .split(/\r?\n/)
  .filter((line) => !line.startsWith('#'));

const subject = (lines[0] || '').trim();

if (!subject) {
  console.error('[commit-rules] Commit message cannot be empty.');
  process.exit(1);
}

// Allow Git-generated merge and revert headers
if (/^(Merge |Revert "|fixup! |squash! )/.test(subject)) {
  process.exit(0);
}

const CONVENTIONAL_RE =
  /^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._-]+\))?(!)?: [a-z0-9].*$/;

const errors = [];

if (!CONVENTIONAL_RE.test(subject)) {
  errors.push(
    'Subject must follow Conventional Commits: <type>(<optional-scope>): <lowercase summary>'
  );
}

if (subject.length > 72) {
  errors.push(`Subject must be 72 characters or fewer (got ${subject.length}).`);
}

if (subject.endsWith('.')) {
  errors.push('Subject must not end with a trailing period.');
}

if (lines.length > 1 && lines[1].trim() !== '') {
  errors.push('Separate subject from body with a blank line.');
}

if (errors.length > 0) {
  console.error('\n[commit-rules] Commit rejected:\n');
  for (const err of errors) {
    console.error(`  - ${err}`);
  }
  console.error('\nAllowed types: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert');
  console.error('Examples:');
  console.error('  feat(team): add Gihan Pandula to collective');
  console.error('  fix(loader): resize spinner ring for Teqniqks brand');
  console.error('  docs(readme): update repository links\n');
  process.exit(1);
}
